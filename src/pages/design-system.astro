---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import Button from '../components/Button.astro';
import Arrow from '../components/Arrow.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import NavLinks from '../components/NavLinks.astro';
import SkillTag from '../components/SkillTag.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DSExample from '../components/DSExample.astro';
import Feedback from '../components/Feedback.astro';
import { dsGroups } from '../data/design-system';
import DSNavigation from '../components/DSNavigation.astro';
import { projects } from '../data/portfolio';
import '../styles/design-system.css';
const colors = [
  ['canvas','Canvas','The warm, continuous page background.'],
  ['surface','Surface','Floating navigation, drawers and raised controls.'],
  ['surface-subtle','Subtle surface','Quiet media placeholders and specimen backgrounds.'],
  ['ink','Ink','Headlines, body text and primary actions.'],
  ['muted','Muted','Supporting copy and component metadata.'],
  ['accent','Accent','Wordmark dot, caret and decorative arrow details.'],
  ['divider','Divider','Low-emphasis structural separators.'],
];
const sizes = [4,8,12,16,24,32,48,64];
const stateFamilies = [
  {tone:'success',label:'Success',description:'A completed action or confirmed result.'},
  {tone:'info',label:'Information',description:'Helpful context with no action required.'},
  {tone:'warning',label:'Warning',description:'Something needs attention before continuing.'},
  {tone:'danger',label:'Danger',description:'An action failed. Explain how to recover.'},
] as const;
---
<BaseLayout title="Design system — naz.wtf">
  <aside class="ds-sidebar">
    <a href="/" class="ds-home" aria-label="naz.wtf — portfolio"><Logo /></a>
    <div class="ds-sidebar-title"><span>Design system</span><span class="ds-version">0.3</span></div>
    <DSNavigation />
    <a class="ds-return" href="/">← Back to portfolio</a>
  </aside>
  <div class="ds-topbar"><button class="button button--secondary ds-menu-toggle" aria-controls="ds-drawer" aria-expanded="false" type="button">Browse sections</button><span class="ds-breadcrumb">naz.wtf / Design system</span><div class="ds-tools"><button class="ds-search-trigger" type="button" aria-haspopup="dialog" aria-controls="ds-search" hidden>Find a section <kbd>⌘ K</kbd></button><ThemeToggle /></div></div>
  <main id="main" class="ds-main" tabindex="-1"><div class="ds-chapter-label"><span>01</span><span>Brand</span></div>
<section id="overview" class="ds-section ds-overview" tabindex="-1">
      <p class="eyebrow">Living documentation / 0.3</p>
      <h1>Design system<span class="ds-title-dot">.</span></h1>
      <p class="ds-lead">The working language of naz.wtf. Brand, foundations, components and the patterns that bring them together.</p>
      <div class="ds-note">These specimens use the same Astro components and CSS tokens as the portfolio. Change the theme above to inspect both palettes.</div>
      
    <div class="ds-index">{dsGroups.map((group,index) => <a href={`#${group.links[0][0]}`}><span>{String(index+1).padStart(2,'0')}</span><strong>{group.label}</strong><span>{group.links.length} sections <Arrow /></span></a>)}</div></section>
<section id="principles" class="ds-section" tabindex="-1"><div class="ds-section-heading"><h2>Principles</h2><a href="#principles" aria-label="Link to Principles">#</a></div><p class="ds-intro">Three decisions that keep the portfolio recognizable.</p><div class="ds-principles"><div><span>01</span><h3>Type leads.</h3><p>Large, tightly set Urbanist. Clear hierarchy and generous room around it.</p></div><div><span>02</span><h3>Color punctuates.</h3><p>A warm neutral canvas, near-black ink and a precise orange accent.</p></div><div><span>03</span><h3>Motion responds.</h3><p>Purposeful entrances, gentle repetition and a waterfall that reacts to you.</p></div></div></section>
<section id="brand" class="ds-section" tabindex="-1"><div class="ds-section-heading"><h2>Wordmark</h2><a href="#brand" aria-label="Link to Wordmark">#</a></div><p class="ds-intro">Live text with a single orange dot. Scale the shared component without rebuilding the mark.</p><DSExample id="wordmark" name="Wordmark" markup={"<Logo />"} specs={[["Type", "Urbanist \u00b7 900"], ["Default size", "36px"], ["Signature", "--accent on the dot"]]} rules={["Keep the wordmark intact and readable.", "Use the shared Logo component; do not rasterize the text."]} source="src/components/Logo.astro"><div class="ds-brand"><Logo /></div></DSExample></section>
<section id="voice" class="ds-section" tabindex="-1"><div class="ds-section-heading"><h2>Voice & tone</h2><a href="#voice" aria-label="Link to Voice & tone">#</a></div><p class="ds-intro">Write as one designer. Use clear labels, specific work and a direct invitation.</p><div class="ds-table-wrap"><table><thead><tr><th scope="col">Surface</th><th scope="col">Example</th><th scope="col">Guidance</th></tr></thead><tbody><tr><td>Action</td><td>Explore the work</td><td>Name the destination.</td></tr><tr><td>Pending content</td><td>Project details to follow.</td><td>State what is missing without inventing a result.</td></tr><tr><td>Introduction</td><td>Product Designer.</td><td>Lead with the role; explain the value in the supporting line.</td></tr></tbody></table></div><p class="ds-source">Copy source: src/data/portfolio.ts · COPY.md</p></section>
<div class="ds-chapter-label"><span>02</span><span>Foundations</span></div>
<section id="colors" class="ds-section" tabindex="-1"><h2>Colors</h2><p class="ds-intro">Semantic roles adapt to light and dark. Use tokens, never one-off page colors.</p>
      <div class="ds-swatches">{colors.map(([token,label,description]) => <article class="ds-swatch"><div class="ds-color" style={`background:var(--${token})`}></div><div><h3>{label}</h3><code>--{token}</code><span class="ds-token-value" data-token={token}></span><p>{description}</p></div></article>)}</div>
    </section>
<section id="states" class="ds-section" tabindex="-1"><div class="ds-section-heading"><h2>Semantic states</h2><a href="#states" aria-label="Link to Semantic states">#</a></div><p class="ds-intro">Success, information, warning and danger each have a background, border and foreground. Use the complete family, and always name the state.</p><div class="ds-state-families">{stateFamilies.map(({tone,label,description}) => <article class="ds-state-family"><div class="ds-state-heading"><h3>{label}</h3><p>{description}</p></div><div class="ds-state-swatches">{['bg','border','fg'].map(part => <div><div class="ds-color" style={`background:var(--${tone}-${part})`}></div><code>--{tone}-{part}</code><span class="ds-token-value" data-token={`${tone}-${part}`}></span></div>)}</div><Feedback tone={tone} title={`${label} example`}>{description}</Feedback></article>)}</div><div class="ds-note">Status colors carry meaning. Drafts and pending projects stay neutral. Orange remains a brand detail; it does not stand in for warning or error.</div></section>
<section id="interactions" class="ds-section" tabindex="-1"><div class="ds-section-heading"><h2>Interaction states</h2><a href="#interactions" aria-label="Link to Interaction states">#</a></div><p class="ds-intro">These examples freeze the shared control treatments for comparison. Use the live button below to try hover, press and keyboard focus.</p><div class="ds-interaction-grid">{['Default','Hover','Focus','Pressed','Disabled'].map((label,i) => <div><span class="ds-small-label">{label}</span><div class={`ds-state-example ds-state-example--${i}`} inert><Button disabled={i===4}>Explore <Arrow /></Button></div></div>)}</div><div class="ds-live-action"><Button>Try this button</Button><span>Hover · hold to press · Tab to focus</span></div><div class="ds-table-wrap"><table><thead><tr><th scope="col">State</th><th scope="col">Treatment</th><th scope="col">Purpose</th></tr></thead><tbody><tr><td>Hover</td><td>--ink-hover or --surface-subtle</td><td>Indicate that a control responds.</td></tr><tr><td>Focus</td><td>--focus-ring · 2px / 4px offset</td><td>Locate the current keyboard target.</td></tr><tr><td>Pressed</td><td>scale(.98)</td><td>Acknowledge a press; static with reduced motion.</td></tr><tr><td>Disabled</td><td>--opacity-disabled</td><td>Native disabled button, removed from the tab order.</td></tr><tr><td>Selected</td><td>aria-selected / aria-current</td><td>Persist the current tab or location independently of hover.</td></tr></tbody></table></div></section>
<section id="typography" class="ds-section" tabindex="-1"><h2>Typography</h2><p class="ds-intro">Urbanist Variable, locally served. Weight 800 for display, 600 for controls, 400 for body copy.</p>
      <div class="ds-type-row"><div><code>--text-display</code><span>800 · 1.0 · −0.045em</span></div><p class="ds-display">Product Designer.</p></div>
      <div class="ds-type-row"><div><code>--text-heading</code><span>800 · 1.04 · −0.03em</span></div><h2>Worth a closer look.</h2></div>
      <div class="ds-type-row"><div><code>--text-body</code><span>400 · 1.55</span></div><p>Thoughtful products start with understanding how people work.</p></div>
      <div class="ds-type-row"><div><code>.eyebrow</code><span>600 · 1.4 · 0.12em</span></div><p class="eyebrow">Selected work / 01</p></div>
    </section>
<section id="spacing" class="ds-section" tabindex="-1"><div class="ds-section-heading"><h2>Spacing</h2><a href="#spacing" aria-label="Link to Spacing">#</a></div><p class="ds-intro">A 4px base, with named steps for control gaps, content groups and page rhythm.</p><div class="ds-space-list">{sizes.map(size => <div><code>--space-{size/4}</code><span style={`width:var(--space-${size/4})`}></span><small>{size}px</small></div>)}</div></section>
<section id="layout" class="ds-section" tabindex="-1"><div class="ds-section-heading"><h2>Layout & breakpoints</h2><a href="#layout" aria-label="Link to Layout & breakpoints">#</a></div><p class="ds-intro">The portfolio opens up as the viewport grows. The documentation rail switches to a drawer below 900px.</p><div class="ds-table-wrap"><table><thead><tr><th scope="col">Viewport</th><th scope="col">Content gutter</th><th scope="col">Section spacing</th><th scope="col">Grid gap</th></tr></thead><tbody><tr><td>Below 768px</td><td>24px</td><td>64px</td><td>16px</td></tr><tr><td>768–1439px</td><td>64px</td><td>96px</td><td>24px</td></tr><tr><td>1440px and up</td><td>200px</td><td>128px</td><td>24px</td></tr></tbody></table></div><div class="ds-note">The header uses its own inset: 32px on desktop and 24px on mobile. The hero waterfall is capped at 800 × 800px.</div></section>
<section id="control-sizes" class="ds-section" tabindex="-1"><div class="ds-section-heading"><h2>Control sizes</h2><a href="#control-sizes" aria-label="Link to Control sizes">#</a></div><p class="ds-intro">The hit area belongs to the control, even when its icon is smaller.</p><div class="ds-table-wrap"><table><thead><tr><th scope="col">Role</th><th scope="col">Token</th><th scope="col">Size</th></tr></thead><tbody><tr><td>Text button</td><td>--control-height</td><td>48px minimum</td></tr><tr><td>Icon control</td><td>--control-icon</td><td>44 × 44px</td></tr><tr><td>Directional icon</td><td>--icon-size</td><td>24 × 24px</td></tr><tr><td>Control label</td><td>--text-control</td><td>16px · 600</td></tr></tbody></table></div></section>
<section id="shape" class="ds-section" tabindex="-1"><h2>Radius & elevation</h2><p class="ds-intro">Pills for controls. Soft corners for media. Shadows identify raised surfaces.</p><div class="ds-shapes"><div class="ds-shape ds-shape--pill"><code>--radius-pill</code></div><div class="ds-shape ds-shape--media"><code>--radius-media</code><span>24px / 20px mobile</span></div><div class="ds-shape ds-shape--floating"><code>--shadow-floating</code><span>Navigation elevation</span></div></div></section>
<section id="icons" class="ds-section" tabindex="-1"><div class="ds-section-heading"><h2>Iconography</h2><a href="#icons" aria-label="Link to Iconography">#</a></div><p class="ds-intro">Directional arrows inherit their text color. Icon controls have an accessible name; decorative arrows stay hidden from screen readers.</p><div class="ds-specimen ds-icon-specimens"><div><Arrow direction="right" /><code>right</code></div><div><Arrow direction="up" /><code>up</code></div><div><Arrow direction="down" /><code>down</code></div></div><p class="ds-source">Arrow.astro · 24px canvas · 1.5px stroke. The decorative waterfall uses the installed Lucide icon set.</p></section>
<section id="theme" class="ds-section" tabindex="-1"><div class="ds-section-heading"><h2>Theme contract</h2><a href="#theme" aria-label="Link to Theme contract">#</a></div><p class="ds-intro">Choose semantic roles once. Light and dark themes supply the values to every component.</p><div class="ds-table-wrap"><table><thead><tr><th scope="col">Role</th><th scope="col">Use</th><th scope="col">Theme behavior</th></tr></thead><tbody><tr><td>Canvas / surface / subtle</td><td>Page, raised surface, specimen well</td><td>Each has an explicit dark value.</td></tr><tr><td>Ink / on-primary</td><td>Reading text / label on primary button</td><td>Always change as a pair.</td></tr><tr><td>State families</td><td>Feedback background, border and text</td><td>All three values change together.</td></tr><tr><td>Accent</td><td>Wordmark and decorative detail</td><td>Orange stays constant.</td></tr><tr><td>Preference</td><td>Theme toggle</td><td>Uses the system preference until a manual choice is saved.</td></tr></tbody></table></div><div class="ds-note">Use the theme control in the header to inspect all specimens together. Token readouts update from the rendered theme.</div></section>
<div class="ds-chapter-label"><span>03</span><span>Components</span></div>
<section id="buttons" class="ds-section" tabindex="-1"><div class="ds-section-heading"><h2>Buttons</h2><a href="#buttons" aria-label="Link to Buttons">#</a></div><p class="ds-intro">Primary and secondary actions share one component. A destination renders as a link; an action renders as a button.</p><DSExample id="button" name="Buttons" markup={"<Button href=\"/#contact\" arrow=\"up\">Get in touch</Button>\n<Button variant=\"secondary\" href=\"/#work\">Explore the work</Button>\n<Button disabled>Unavailable</Button>"} specs={[["variant", "primary (default) | secondary"], ["href", "Optional destination. Without it, renders a button."], ["arrow", "up | down | right (optional)"], ["disabled", "false by default; native disabled button"], ["Size", "--control-height \u00b7 --radius-pill"]]} rules={["Use a descriptive action or destination label.", "Keep one primary action per decision group.", "Explain unavailable actions nearby. Disabled links render as disabled buttons."]} source="src/components/Button.astro"><div class="ds-button-row"><Button href="/#contact" arrow="up">Get in touch</Button><Button variant="secondary" href="/#work" arrow="down">Explore the work</Button><Button disabled>Unavailable</Button></div></DSExample></section>
<section id="theme-toggle" class="ds-section" tabindex="-1"><div class="ds-section-heading"><h2>Theme toggle</h2><a href="#theme-toggle" aria-label="Link to Theme toggle">#</a></div><p class="ds-intro">One control switches the entire page and remembers the choice.</p><DSExample id="theme-control" name="Theme toggle" markup={"<ThemeToggle />"} specs={[["Size", "--control-icon \u00b7 44px"], ["Accessible name", "Names the theme that will be activated"], ["Persistence", "naz-theme in localStorage; session fallback if storage is unavailable"]]} rules={["Keep the accessible name in sync with the next action.", "Read theme values from tokens rather than duplicating palettes."]} source="src/components/ThemeToggle.astro · src/scripts/theme.ts"><ThemeToggle /></DSExample></section>
<section id="tags" class="ds-section" tabindex="-1"><div class="ds-section-heading"><h2>Tags</h2><a href="#tags" aria-label="Link to Tags">#</a></div><p class="ds-intro">Short labels for skills and process. They are content, so they do not enter the tab order.</p><DSExample id="skill-tag" name="Tags" markup={"<SkillTag label=\"Design systems\" />"} specs={[["label", "Required text"], ["Shape", "--radius-pill"], ["Interaction", "None"]]} rules={["Use short, concrete labels.", "Use a button for an action; a tag is a label."]} source="src/components/SkillTag.astro"><div class="ds-button-row">{['Workflows','Testing','Feedback','Prototyping','Design systems'].map(label => <SkillTag label={label} />)}</div></DSExample></section>
<section id="feedback" class="ds-section" tabindex="-1"><div class="ds-section-heading"><h2>Feedback</h2><a href="#feedback" aria-label="Link to Feedback">#</a></div><p class="ds-intro">Reusable, explicitly labeled messages built from the semantic state families. These are examples, not reports of completed actions.</p><DSExample id="feedback-message" name="Feedback" markup={"<Feedback tone=\"success\" title=\"Saved\">\n  Your changes are saved.\n</Feedback>"} specs={[["tone", "success | info (default) | warning | danger"], ["title", "Required visible state label"], ["Content", "Default slot for explanation or recovery guidance"]]} rules={["Explain what happened and the next step when needed.", "Use one matching bg / border / fg family.", "For dynamically inserted updates, announce through the owning live region. Static examples do not use role=alert."]} source="src/components/Feedback.astro · src/styles/feedback.css"><div class="ds-feedback-grid">{stateFamilies.map(({tone,label,description}) => <Feedback tone={tone} title={label}>{description}</Feedback>)}</div></DSExample></section>
<section id="cards" class="ds-section" tabindex="-1"><div class="ds-section-heading"><h2>Project cards</h2><a href="#cards" aria-label="Link to Project cards">#</a></div><p class="ds-intro">Media leads; the title, role and year provide context below. The preview uses the first record in the portfolio data.</p><DSExample id="project-card" name="Project cards" markup={"<ProjectCard project={projects[0]} />"} specs={[["project", "Required Project record from portfolio data"], ["lead", "false by default; enables the lead presentation"], ["pending", "A pending record has no destination link"], ["Image", "Explicit alternative text, dimensions and lazy loading"]]} rules={["Publish a link only when its destination is ready.", "Keep pending content plainly labeled and neutral.", "Use meaningful image descriptions."]} source="src/components/ProjectCard.astro"><div class="ds-card-preview"><ProjectCard project={projects[0]} /></div></DSExample></section>
<div class="ds-chapter-label"><span>04</span><span>Patterns</span></div>
<section id="navigation" class="ds-section" tabindex="-1"><h2>Navigation</h2><p class="ds-intro">The full-width top bar scrolls away with the page. Only when the hero’s Get in touch button reaches the top inset does the header become fixed. Over the next 220px of scroll, that same button and the returning navigation gather into a centered surface pill while the wordmark becomes n. Scrolling upward reverses the merge. Mobile keeps n., menu and contact in the pill, with the theme control in the focus-trapped drawer. DS stays in the footer; CV remains unavailable until its download is configured.</p><div class="ds-specimen"><div class="ds-nav-preview"><Logo compact /><NavLinks showDS={false} /><ThemeToggle /><Button href="/#contact" arrow="up">Get in touch</Button></div></div><code class="ds-source">SiteHeader.astro · NavLinks.astro · header-morph.ts</code></section>
<section id="motion" class="ds-section" tabindex="-1"><h2>Animation principles</h2><div class="ds-table-wrap"><table><thead><tr><th>Pattern</th><th>Timing</th><th>Behavior</th></tr></thead><tbody>
      <tr><td>Typewriter</td><td>75–95ms / letter</td><td>Product Designer. types once. UX designer → Web designer → App designer cycle with 2.4s holds and 48ms deletion.</td></tr>
      <tr><td>Waterfall</td><td>1s after page load</td><td>Native display-synced canvas, 10px vector icons, 8px gaps, unique visible symbols and a 220px pointer response. All icons in the repulsion area share one transition to full accent after 2s. Rapid symbol replacements retain the position’s color; new arrivals inherit the group color. Icons fade back to gray over 2s after leaving. Every icon is opaque: gray and accent tails use solid RGB steps that fade into the current page background.</td></tr>
      <tr><td>Skills</td><td>150ms stagger / 34s loop</td><td>Tags enter individually, then rise with top and bottom gradient masks.</td></tr>
      <tr><td>Header</td><td>220px scroll range</td><td>CTA-triggered, reversible merge of the original contact button, compact wordmark and navigation. Reduced motion docks instantly at the same threshold.</td></tr>
      <tr><td>Controls</td><td>160ms</td><td>Subtle color and arrow changes; a light press response.</td></tr>
    </tbody></table></div><a class="ds-text-link" href="/">See motion on the homepage <Arrow direction="up" /></a></section>
<section id="accessibility" class="ds-section" tabindex="-1"><h2>Accessibility</h2><div class="ds-note">Animation automatically suspends when the hero is offscreen, the tab is hidden, or navigation is open.</div><ul class="ds-guidelines"><li>Reduced motion shows the complete title, a static skills list and no falling icons.</li><li>Screen readers receive one stable headline, without each typed letter being announced.</li><li>All navigation and controls have visible keyboard focus. Decorative labels do not enter the tab order.</li><li>Dark theme respects your system preference and remembers a manual choice across pages.</li></ul></section>
<div class="ds-chapter-label"><span>05</span><span>Governance</span></div>
<section id="contributing" class="ds-section" tabindex="-1"><div class="ds-section-heading"><h2>Contributing</h2><a href="#contributing" aria-label="Link to Contributing">#</a></div><p class="ds-intro">A component is ready when its implementation, tokens and documentation agree.</p><ol class="ds-guidelines"><li>Check the existing components before adding a new one. Extend a variant when the behavior is the same.</li><li>Define reusable decisions in tokens.css, including theme pairs.</li><li>Build the component once and render it here through DSExample.</li><li>Document its markup, props, behavior and usage rules.</li><li>Add the section to the shared navigation registry and keep existing anchors stable.</li></ol><div class="ds-note">Documentation styles use the ds- prefix. Shared components keep their own classes so the portfolio and catalog render the same thing.</div><pre class="ds-file-map"><code>src/styles/tokens.css         Shared decisions
src/components/              Reusable components
src/data/design-system.ts    Section registry
src/pages/design-system.astro  Living catalog
DESIGN.md                    Design rationale</code></pre></section>
<section id="checks" class="ds-section" tabindex="-1"><div class="ds-section-heading"><h2>Pre-ship checks</h2><a href="#checks" aria-label="Link to Pre-ship checks">#</a></div><p class="ds-intro">Review the component in context, then verify the states a static preview cannot show.</p><div class="ds-table-wrap"><table><thead><tr><th scope="col">Check</th><th scope="col">Evidence to look for</th></tr></thead><tbody><tr><td>Both themes</td><td>Text, icons and states remain legible on their actual surface.</td></tr><tr><td>Keyboard</td><td>Reach every control, see focus, operate tabs, close the drawer with Escape.</td></tr><tr><td>Responsive</td><td>No page overflow at 390px, 768px and desktop widths.</td></tr><tr><td>Reduced motion</td><td>All content remains available without motion or press scaling.</td></tr><tr><td>Content</td><td>No fabricated project outcomes, dead destinations or unlabeled states.</td></tr><tr><td>Build</td><td>pnpm check and pnpm build complete successfully.</td></tr></tbody></table></div></section>
<footer class="ds-footer"><Logo /><a href="/">Back to portfolio ↗</a></footer>
  </main>
  <dialog id="ds-drawer" class="ds-drawer" aria-label="Design system navigation"><div class="drawer-top"><strong>Browse sections</strong><button type="button" class="icon-button ds-menu-close" aria-label="Close sections">×</button></div><DSNavigation /></dialog>
  <dialog id="ds-search" class="ds-search" aria-labelledby="ds-search-title"><div class="ds-search-head"><h2 id="ds-search-title">Find a section</h2><button class="icon-button" type="button" data-search-close aria-label="Close search">×</button></div><label class="sr-only" for="ds-search-input">Search sections</label><input id="ds-search-input" type="search" placeholder="Colors, buttons, motion…" autocomplete="off" /><p class="ds-search-status" role="status"></p><div class="ds-search-results">{dsGroups.map(group => group.links.map(([id,label]) => <a href={`#${id}`} data-search-text={`${group.label} ${label}`}><span>{label}</span><small>{group.label}</small></a>))}</div></dialog>
<script>import '../scripts/design-system';</script>
</BaseLayout>
