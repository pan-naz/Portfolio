---
import { workCategories } from '../data/work-categories';
import ProjectCard from './ProjectCard.astro';
import { projects, collectionProjects } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
import SectionNavigation from './SectionNavigation.astro';
import IconButton from './IconButton.astro';
import CaseStudyLayer from './CaseStudyLayer.astro';
---
<section id="work" class="work chapter" aria-labelledby="work-title" data-work-stage>
  <div class="work-stage-surface" data-work-stage-surface>
    <div class="work-panel" aria-hidden="true"></div>
    <div class="work-rail" data-work-rail><SectionNavigation /></div>
    <div class="container work-content">
      <SectionHeading id="work-title" label={workCategories.selected.label}>{workCategories.selected.title}<p slot="description" class="section-description text-body-l">{workCategories.selected.description}</p></SectionHeading>
      <div data-work-filter-anchor aria-hidden="true"></div>
      <div class="work-compact-filter"><SectionNavigation compact theme /></div>
      <div id="project-list" class="projects" data-active-filter="selected">
        <div class="project-collection" data-project-collection="selected">{projects.map((project, index) => <ProjectCard project={project} lead={index === 0} />)}</div>
        {(['websites', 'misc'] as const).map(category => <div class="project-collection project-collection--bento" data-project-collection={category} hidden>
          {collectionProjects.filter(project => project.category === category).map(project => <ProjectCard project={project} compact />)}
        </div>)}
      </div>
    </div>
  </div>
</section>
<div class="project-cursor" data-project-cursor aria-hidden="true">
  <IconButton label="Project cursor" tabindex="-1" class="floating-control-theme floating-control-surface" icon="plus" />
</div>

<CaseStudyLayer />
