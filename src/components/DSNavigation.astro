---
import { dsGroups } from '../data/design-system';
import Logo from './Logo.astro';
---
<aside class="ds-sidebar">
  <a class="ds-home" href="/" aria-label="naz.wtf — portfolio"><Logo /></a>
  <p class="ds-sidebar-title">Folio / Design system</p>
  <nav class="ds-navigation" aria-label="Design system sections">{dsGroups.map(group => <div class="ds-nav-group"><p>{group.label}</p>{group.links.map(([id,label]) => <a href={`#${id}`}>{label}</a>)}</div>)}</nav>
  <a class="ds-return" href="/">Back to portfolio ↗</a>
</aside>
