---
import {dsGroups} from '../data/design-system';
import Logo from './Logo.astro';
---
<aside class="ds-sidebar">
  <a tabindex="0" class="ds-home" href="/" aria-label="naz.wtf — home"><Logo /></a>
  <details data-ds-contents><summary>Sections</summary><nav class="ds-navigation" aria-label="Design system sections"><a tabindex="0" href="/design-system/" data-ds-dashboard-link>Overview</a>{dsGroups.map(group=><div class="ds-nav-group"><p>{group.label}</p>{group.links.map(([id,label])=><a tabindex="0" href={`#${id}`} data-ds-nav>{label}</a>)}</div>)}</nav></details>
</aside>
