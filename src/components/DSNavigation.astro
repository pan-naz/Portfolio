---
import { dsGroups } from '../data/design-system';
import Logo from './Logo.astro';
import TextLink from './TextLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---
<aside class="ds-sidebar">
  <div class="ds-topbar"><a class="ds-home" href="/" aria-label="naz.wtf — portfolio"><Logo /></a><ThemeToggle /></div>
  <p class="ds-sidebar-title">Folio / Design system</p>
  <details data-ds-contents><summary>Contents</summary><nav class="ds-navigation" aria-label="Design system sections">{dsGroups.map(group => <div class="ds-nav-group"><p>{group.label}</p>{group.links.map(([id,label]) => <a href={`#${id}`}>{label}</a>)}</div>)}</nav></details>
  <TextLink class="ds-return" href="/" compact>Back to portfolio</TextLink>
</aside>
