---
import type { Experience } from '../data/portfolio';
interface Props { item: Experience; }
const { item } = Astro.props;
---
<li class="experience-row"><p class="experience-period">{item.period}</p><div><h3>{item.role}</h3><p class="experience-company">{item.company} · {item.location}</p></div><p class="experience-summary">{item.summary}</p><p class="experience-duration">{item.duration}</p></li>
