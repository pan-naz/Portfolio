---
import type { Project } from '../data/portfolio';
import CaseStudyContent from './CaseStudyContent.astro';
import StandaloneCaseStyles from './StandaloneCaseStyles.astro';
import IconButton from './IconButton.astro';
import Icon from './Icon.astro';
import { workFilterHash } from '../scripts/work-filter/work-filter';
interface Props { project: Project; }
const { project } = Astro.props;
const returnUrl = project.category === 'selected' ? '/#work' : `/${workFilterHash(project.category)}`;
---
<StandaloneCaseStyles project={project} />
<main id="main" tabindex="-1" class="case-study-page">
  <div class="case-study-direct-close" data-color-zone="light" data-shadow-theme="page"><IconButton label="Close case study" href={returnUrl} class="floating-control-theme floating-control-surface" data-case-home><Icon name="plus" style="transform:rotate(45deg)" /></IconButton></div>
  <CaseStudyContent project={project} />
</main>

<script>
  import { initializeMotion } from '../scripts/motion';
  import { initializeCaseStudyNavigation } from '../scripts/case-study/case-study-navigation';
  import { initializeControlMagnet } from '../scripts/control-magnet';
  import { initializeCaseStudyVideos } from '../scripts/case-study/case-study-videos';
  initializeMotion();
  const videos = initializeCaseStudyVideos();
  window.addEventListener('pagehide', event => { if (!event.persisted) videos.destroy(); });
  initializeCaseStudyNavigation();
  initializeControlMagnet(document.querySelector<HTMLElement>('[data-case-home]')!);
</script>
