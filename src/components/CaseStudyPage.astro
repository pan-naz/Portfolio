---
import type { Project } from '../data/portfolio';
import CaseStudyContent from './CaseStudyContent.astro';
import IconButton from './IconButton.astro';
interface Props { project: Project; }
const { project } = Astro.props;
---
<main id="main" class="case-study-page">
  <div class="case-study-direct-close"><IconButton label="Close case study" href="/#work" class="floating-control-theme floating-control-surface" data-case-home><svg style="transform:rotate(45deg)" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><g><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></g></svg></IconButton></div>
  <CaseStudyContent project={project} />
</main>

<script>
  import { initializeMotion } from '../scripts/motion';
  initializeMotion();
</script>
