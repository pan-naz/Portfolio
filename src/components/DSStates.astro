---
import Button from './Button.astro';
import Chip from './Chip.astro';
import NavigationItem from './NavigationItem.astro';
import IconButton from './IconButton.astro';
import { profile, projects } from '../data/portfolio';
import { siteLinks } from '../data/navigation';
import type { SourceComponent } from '../data/system-inventory';
interface Props { component: SourceComponent; }
const { component } = Astro.props;
const states = component.name === 'NavigationItem' ? ['default','hover','active','focus'] : ['default','hover','focus','pressed'];
const title = (value: string) => value[0].toUpperCase() + value.slice(1);
const buttonUses = component.usages.map(({props}) => ({ size: props.size || 'large', variant: props.variant || 'primary', arrow: props.arrow || 'none', appearance: props.appearance || 'default' }));
const buttonLabel = component.usages.find(use => use.props.arrow === 'up')?.label || component.usages.find(use => use.label)?.label || profile.name;
const chipVariants = [...new Set(component.usages.map(({props}) => props.variant || 'tag'))];
---
{component.name === 'Button' && <div class="ds-matrix-scroll"><table class="ds-matrix"><caption>Website combinations and states</caption><thead><tr><th>Variant</th>{states.map(state => <th>{title(state)}</th>)}</tr></thead><tbody>{(['primary','secondary'] as const).flatMap(variant => (['large','small'] as const).flatMap(size => (['none','up'] as const).map(arrow => {
 const used = buttonUses.find(use => use.variant === variant && use.size === size && use.arrow === arrow);
 return <tr><th>{title(variant)} · {title(size)} · {arrow === 'none' ? 'Without icon' : 'With icon'}{used?.appearance === 'comparison' ? ' · Comparison' : ''}</th>{states.map(state => <td>{used ? <div class="ds-state-example" data-state={state} inert><Button size={size} variant={variant} appearance={used.appearance === 'comparison' ? 'comparison' : 'default'} arrow={arrow === 'up' ? 'up' : undefined}>{buttonLabel}</Button></div> : <span>Not used</span>}</td>)}</tr>;
})))}</tbody></table></div>}
{component.name === 'Chip' && <div class="ds-labelled-examples">{chipVariants.map(variant => <div><h4>{title(variant)}</h4><Chip label={projects[0].tags[0]} variant={variant as 'tag'|'plain'|'raised'|'accent'} /></div>)}</div>}
{component.name === 'NavigationItem' && <div class="ds-matrix-scroll"><table class="ds-matrix"><caption>Navigation contexts and states</caption><thead><tr><th>Context</th>{states.map(state => <th>{title(state)}</th>)}</tr></thead><tbody>{['Top bar','Floating pill','Filter','Mobile menu'].map((context,index) => <tr><th>{context}</th>{states.map(state => <td><div class:list={['ds-state-example', index === 1 || index === 2 ? 'floating-navigation-theme floating-navigation-surface' : undefined]} data-state={state} inert><NavigationItem label={siteLinks[0].label} href={index !== 2 ? siteLinks[0].href : undefined} filter={index === 2 ? projects[0].category : undefined} pressed={index === 2 && state === 'active'} layout={index === 3 ? 'mobile' : 'desktop'} /></div></td>)}</tr>)}</tbody></table></div>}
{component.name === 'IconButton' && <div class="ds-labelled-examples">{states.map(state => <div><h4>{title(state)}</h4><div class="ds-state-example" data-state={state} inert><IconButton icon="menu" label={component.usages.find(use => use.props.icon === 'menu')?.props.label || profile.name} /></div></div>)}</div>}
