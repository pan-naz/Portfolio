---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import TextLink from './TextLink.astro';
import Logo from './Logo.astro';
import Button from './Button.astro';
import Chip from './Chip.astro';
import NavigationItem from './NavigationItem.astro';
import IconButton from './IconButton.astro';
import { profile, projects } from '../data/portfolio';
import { siteLinks } from '../data/navigation';
import type { SourceComponent } from '../data/system-inventory';
interface Props { component: SourceComponent; }
const { component } = Astro.props;
const states = component.name === 'NavigationItem' ? ['default','hover','focus','active'] : component.name === 'TextLink' ? ['default','hover','focus'] : ['default','hover','focus','pressed'];
const title = (value: string) => value[0].toUpperCase() + value.slice(1);
const buttonRows = [...new Map(component.usages.map(({props}) => {
  const row = { size: props.size || 'large', variant: props.variant || 'primary', arrow: props.arrow || 'none', appearance: props.appearance || 'default' };
  return [JSON.stringify(row),row];
})).values()];
const fallbackLabel = 'Get in touch';
const buttonLabel = component.usages.find(use => use.props.arrow === 'up' && use.label)?.label || component.usages.find(use => use.label)?.label || fallbackLabel;
const filters = [...readFileSync(resolve('src/components/SectionNavigation.astro'),'utf8').matchAll(/value: '([^']+)', label: '([^']+)'/g)].map(([,value,label]) => ({value,label}));
const linkUses = [...new Map(component.usages.map(use => { const variant = { inline: use.props.inline === 'true', compact: use.props.compact === 'true', accent: use.props.accent === 'true' }; return [JSON.stringify(variant), variant]; })).values()];
const chipVariants = [...new Set(component.usages.map(({props}) => props.variant || 'tag'))];
---
{component.name === 'Button' && <div class="ds-demo-stack">{buttonRows.map(({variant,size,arrow,appearance}) => <div><h4>{title(variant)} · {title(size)} · {arrow === 'none' ? 'Without icon' : 'With icon'}{appearance === 'comparison' ? ' · Comparison control' : ''}</h4><div class="ds-state-grid">{states.map(state => <div><p class="ds-state-label">{title(state)}</p><div class="ds-state-example" data-state={state} inert><Button size={size === 'small' ? 'small' : 'large'} variant={variant === 'secondary' ? 'secondary' : 'primary'} appearance={appearance === 'comparison' ? 'comparison' : 'default'} arrow={arrow === 'up' ? 'up' : undefined}>{buttonLabel}</Button></div></div>)}</div></div>)}</div>}
{component.name === 'Chip' && <div class="ds-labelled-examples">{chipVariants.map(variant => <div><h4>{variant === 'tag' ? 'Skill' : variant === 'plain' ? 'Plain' : title(variant)}</h4><Chip label={projects[0].tags[0]} variant={variant as 'tag'|'plain'|'raised'|'accent'} /></div>)}</div>}
{component.name === 'NavigationItem' && <div class="ds-demo-stack">{['Top bar','Floating pill','Filter','Mobile menu'].map((context,index) => <div><h4>{context}</h4><div class="ds-state-grid">{states.map(state => <div><p class="ds-state-label">{title(state)}</p><div class:list={['ds-state-example', index === 1 || index === 2 ? 'floating-navigation-theme floating-navigation-surface' : undefined]} data-state={state} inert><NavigationItem label={index === 2 ? filters[0].label : siteLinks[0].label} href={index !== 2 ? siteLinks[0].href : undefined} filter={index === 2 ? filters[0].value : undefined} pressed={index === 2 && state === 'active'} layout={index === 3 ? 'mobile' : 'desktop'} /></div></div>)}</div></div>)}</div>}
{component.name === 'IconButton' && <div class="ds-state-grid">{states.map(state => <div><p class="ds-state-label">{title(state)}</p><div class="ds-state-example" data-state={state} inert><IconButton icon="menu" label={component.usages.find(use => use.props.icon === 'menu')?.props.label || fallbackLabel} /></div></div>)}</div>}
{component.name === 'TextLink' && <div class="ds-demo-stack">{linkUses.map(variant => <div><h4>{variant.inline ? 'Inline' : variant.compact ? 'Compact' : 'Default'} · {variant.accent ? 'Accent' : 'Primary'}</h4><div class="ds-state-grid">{states.map(state => <div><p class="ds-state-label">{title(state)}</p><div class="ds-state-example" data-state={state} inert><TextLink href={profile.linkedin} {...variant}>{component.usages.find(use => use.label)?.label || fallbackLabel}</TextLink></div></div>)}</div></div>)}</div>}
{component.name === 'Logo' && <div class="ds-labelled-examples" inert>{[...new Set(component.usages.map(use => use.props.compact === 'true'))].map(compact => <div><h4>{compact ? 'Compact' : 'Full'}</h4><Logo compact={compact} /></div>)}</div>}
