---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import TextLink from './TextLink.astro';
import Logo from './Logo.astro';
import Button from './Button.astro';
import Chip from './Chip.astro';
import NavigationItem from './NavigationItem.astro';
import IconButton from './IconButton.astro';
import { profile, projects } from '../data/portfolio';
import { siteLinks } from '../data/navigation';
import type { SourceComponent } from '../data/system-inventory';
interface Props { component: SourceComponent; }
const { component } = Astro.props;
const states = component.name === 'NavigationItem' ? ['default','hover','active','focus'] : component.name === 'TextLink' ? ['default','hover','focus'] : ['default','hover','focus','pressed'];
const title = (value: string) => value[0].toUpperCase() + value.slice(1);
const buttonUses = component.usages.map(({props}) => ({ size: props.size || 'large', variant: props.variant || 'primary', arrow: props.arrow || 'none', appearance: props.appearance || 'default' }));
const buttonRows = (['primary','secondary'] as const).flatMap(variant => (['large','small'] as const).flatMap(size => (['none','up'] as const).flatMap(arrow => {
  const appearances = [...new Set(buttonUses.filter(use => use.variant === variant && use.size === size && use.arrow === arrow).map(use => use.appearance))];
  return (appearances.length ? appearances : [undefined]).map(appearance => ({variant,size,arrow,appearance}));
})));
const buttonLabel = component.usages.find(use => use.props.arrow === 'up' && use.label)?.label || component.usages.find(use => use.label)?.label || profile.name;
const filters = [...readFileSync(resolve('src/components/SectionNavigation.astro'),'utf8').matchAll(/value: '([^']+)', label: '([^']+)'/g)].map(([,value,label]) => ({value,label}));
const linkUses = [...new Map(component.usages.map(use => { const variant = { inline: use.props.inline === 'true', compact: use.props.compact === 'true', accent: use.props.accent === 'true' }; return [JSON.stringify(variant), variant]; })).values()];
const chipVariants = [...new Set(component.usages.map(({props}) => props.variant || 'tag'))];
---
{component.name === 'Button' && <div class="ds-matrix-scroll"><table class="ds-matrix"><caption>Website combinations and states</caption><thead><tr><th>Variant</th>{states.map(state => <th>{title(state)}</th>)}</tr></thead><tbody>{buttonRows.map(({variant,size,arrow,appearance}) => <tr><th>{title(variant)} · {title(size)} · {arrow === 'none' ? 'Without icon' : 'With icon'}{appearance === 'comparison' ? ' · Comparison' : ''}</th>{states.map(state => <td>{appearance ? <div class="ds-state-example" data-state={state} inert><Button size={size} variant={variant} appearance={appearance === 'comparison' ? 'comparison' : 'default'} arrow={arrow === 'up' ? 'up' : undefined}>{buttonLabel}</Button></div> : <span>Not used</span>}</td>)}</tr>)}</tbody></table></div>}
{component.name === 'Chip' && <div class="ds-labelled-examples">{chipVariants.map(variant => <div><h4>{title(variant)}</h4><Chip label={projects[0].tags[0]} variant={variant as 'tag'|'plain'|'raised'|'accent'} /></div>)}</div>}
{component.name === 'NavigationItem' && <div class="ds-matrix-scroll"><table class="ds-matrix"><caption>Navigation contexts and states</caption><thead><tr><th>Context</th>{states.map(state => <th>{title(state)}</th>)}</tr></thead><tbody>{['Top bar','Floating pill','Filter','Mobile menu'].map((context,index) => <tr><th>{context}</th>{states.map(state => <td><div class:list={['ds-state-example', index === 1 || index === 2 ? 'floating-navigation-theme floating-navigation-surface' : undefined]} data-state={state} inert><NavigationItem label={index === 2 ? filters[0].label : siteLinks[0].label} href={index !== 2 ? siteLinks[0].href : undefined} filter={index === 2 ? filters[0].value : undefined} pressed={index === 2 && state === 'active'} layout={index === 3 ? 'mobile' : 'desktop'} /></div></td>)}</tr>)}</tbody></table></div>}
{component.name === 'IconButton' && <div class="ds-labelled-examples">{states.map(state => <div><h4>{title(state)}</h4><div class="ds-state-example" data-state={state} inert><IconButton icon="menu" label={component.usages.find(use => use.props.icon === 'menu')?.props.label || profile.name} /></div></div>)}</div>}

{component.name === 'TextLink' && <div class="ds-matrix-scroll"><table class="ds-matrix"><caption>Text destinations and states</caption><thead><tr><th>Variant</th>{states.map(state => <th>{title(state)}</th>)}</tr></thead><tbody>{linkUses.map(variant => <tr><th>{variant.inline ? 'Inline' : variant.compact ? 'Compact' : 'Default'} · {variant.accent ? 'Accent' : 'Primary'}</th>{states.map(state => <td><div class="ds-state-example" data-state={state} inert><TextLink href={profile.linkedin} {...variant}>{component.usages.find(use => use.label)?.label || profile.name}</TextLink></div></td>)}</tr>)}</tbody></table></div>}
{component.name === 'Logo' && <div class="ds-labelled-examples">{[...new Set(component.usages.map(use => use.props.compact === 'true'))].map(compact => <div><h4>{compact ? 'Compact' : 'Full'}</h4><Logo compact={compact} /></div>)}</div>}
