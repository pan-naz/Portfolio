---
import { siteLinks } from '../data/navigation';
import NavigationItem from './NavigationItem.astro';
interface Props { showDS?: boolean; }
const { showDS = true } = Astro.props;
---
<nav class="desktop-nav" aria-label="Main navigation">
  {siteLinks.filter(link => showDS || !('catalog' in link)).map(link => <NavigationItem label={link.label} href={link.href} />)}
</nav>
