---
import type { Project } from '../data/portfolio';
import { designCupHero, designCupRole, designCupPage, designCupJury, designCupEnding, designCupGuide } from '../data/design-cup-case-study';
import CaseStudyOverview from './CaseStudyOverview.astro';
import CaseStudyMedia from './CaseStudyMedia.astro';
import CaseStudyDecisionCard from './CaseStudyDecisionCard.astro';
import '../styles/design-cup-case-study.css';
interface Props { project: Project; }
const { project } = Astro.props;
---
<article class="case-study-content case-study-content--design-cup" data-case-content>
  <CaseStudyMedia {...designCupHero} artwork />
  <div class="case-study-body case-study-narrative design-cup-case">
    <CaseStudyOverview project={project} titleId="dc-title" presentation="compact">
      <Fragment slot="role"><p>{designCupRole.title}</p><ul>{designCupRole.items.map(item => <li>{item}</li>)}</ul></Fragment>
    </CaseStudyOverview>

    <section id="dc-page" aria-labelledby="dc-page-title">
      <div class="case-study-columns dc-heading"><div><p class="case-study-eyebrow">{designCupPage.eyebrow}</p><h2 class="case-study-heading" id="dc-page-title">{designCupPage.title}</h2></div><p class="dc-muted">{designCupPage.description}</p></div>
      <div class="dc-landing"><CaseStudyMedia {...designCupPage.media} presentation="shadow" /></div>
    </section>

    <section class="case-study-chapter--inverse dc-jury" id="dc-jury" aria-labelledby="dc-jury-title">
      <div class="case-study-chapter__inner case-study-columns dc-row">
        <div class="dc-copy"><div><p class="case-study-eyebrow">{designCupJury.eyebrow}</p><h2 class="case-study-heading" id="dc-jury-title">{designCupJury.title}</h2></div><p class="dc-muted">{designCupJury.description}</p></div>
        <CaseStudyMedia {...designCupJury.media} presentation="bare" />
      </div>
    </section>

    <section id="dc-page-end" aria-label="Landing page, last blocks">
      <div class="dc-ending">
        {designCupEnding.map((block, index) => <div class:list={['case-study-columns', 'dc-row', index === 0 && 'dc-row--reverse']} aria-labelledby={`dc-ending-${index}`}>
          <div class="dc-copy"><h3 class="text-heading-m" id={`dc-ending-${index}`}>{block.title}</h3><p class="dc-muted">{block.description}</p></div>
          <CaseStudyMedia {...block.media} presentation="shadow" />
        </div>)}
      </div>
    </section>

    <section class="case-study-chapter--inverse dc-guide" id="dc-style" aria-labelledby="dc-style-title">
      <div class="case-study-chapter__inner dc-guide-inner">
        <div class="case-study-columns dc-heading"><div><p class="case-study-eyebrow">{designCupGuide.eyebrow}</p><h2 class="case-study-heading" id="dc-style-title">{designCupGuide.title}</h2></div><p class="dc-muted">{designCupGuide.description}</p></div>
        <CaseStudyDecisionCard title={designCupGuide.lettering.title} layout="figure">
          <div class="case-study-columns dc-row dc-lettering">
            <p class="dc-muted">{designCupGuide.lettering.description}</p>
            <CaseStudyMedia {...designCupGuide.lettering.media} presentation="bare" />
          </div>
        </CaseStudyDecisionCard>
        <CaseStudyDecisionCard title={designCupGuide.coloursTitle} layout="figure">
          <p class="dc-muted">{designCupGuide.coloursDescription}</p>
          <ul class="dc-palette" aria-label="Design Cup colour palette">{designCupGuide.colours.map(colour => <li><div class="dc-swatch" style={`background:${colour.value}`} aria-hidden="true" /><h4>{colour.name}</h4><p class="dc-muted text-body-s">{colour.description}</p><p class="dc-muted text-label-s"><code>{colour.value}</code></p></li>)}</ul>
        </CaseStudyDecisionCard>
      </div>
    </section>
  </div>
</article>
