---
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'div'> { id: string; label: string; reveal?: boolean; layout?: 'columns' | 'stacked'; }
const { id, label, reveal = true, layout = 'columns', ...attributes } = Astro.props;
---
<div {...attributes} class:list={['section-heading', layout === 'stacked' && 'section-heading--stacked']} data-section-reveal={reveal ? '' : undefined}>
  <div class:list={['section-index', layout === 'columns' && 'title-align-line']}>
    {layout === 'columns' ? <div class={Astro.slots.has('index') ? 'title-align-control' : 'title-align-text'}><slot name="index"><p class="eyebrow">{label}</p></slot></div> : <slot name="index"><p class="eyebrow case-study-eyebrow">{label}</p></slot>}
  </div>
  <div><h2 class:list={['text-heading-l', layout === 'stacked' && 'case-study-heading']} id={id}><slot /></h2><slot name="description" /></div>
</div>

<style>
@layer system, project;
@layer system {
  .section-heading--stacked { grid-template-columns: minmax(0, 1fr); gap: var(--section-heading-stack-space, var(--space-3)); margin-bottom: 0; }
  .section-heading--stacked h2 + :global(p) { margin-top: var(--space-3); }

}
</style>
