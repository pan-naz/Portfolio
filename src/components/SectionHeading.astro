---
interface Props { id: string; label: string; reveal?: boolean; }
const { id, label, reveal = true } = Astro.props;
---
<div class="section-heading" data-section-reveal={reveal ? '' : undefined}><div class="section-index"><slot name="index"><p class="eyebrow">{label}</p></slot></div><div><h2 id={id}><slot /></h2><slot name="description" /></div></div>
