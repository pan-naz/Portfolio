---
import IconButton from './IconButton.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';
interface Props { appearance?: 'icon' | 'segmented'; }
const { appearance = 'icon' } = Astro.props;
---
{appearance === 'segmented' ? <div class="theme-toggle-group" data-theme-control role="group" aria-label="Color theme"><Button data-ds-chrome appearance="catalog" size="small" data-theme-choice="light" aria-pressed="true">Light</Button><Button data-ds-chrome appearance="catalog" size="small" data-theme-choice="dark" aria-pressed="false">Dark</Button></div> : <IconButton class="theme-toggle" label="Switch to dark theme" title="Switch theme">
  <span class="theme-toggle-glyph" aria-hidden="true">
  <Icon name="sun" class="theme-sun" />
  <Icon name="moon" class="theme-moon" />
  </span>
</IconButton>}
<style>
@layer system, project;
@layer system {
  .theme-toggle-group { display: inline-flex; gap: var(--space-1); padding: var(--space-1); border: 1px solid var(--color-border-default); border-radius: var(--radius-pill); width: max-content; }
}
</style>
