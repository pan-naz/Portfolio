---
import IconButton from './IconButton.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import NavLinks from './NavLinks.astro';
---
<header class="site-header">
  <div class="header-pill-surface" aria-hidden="true"></div>
  <a href="/#top" class="identity" aria-label="naz.wtf — home"><span class="header-full-logo" aria-hidden="true"><Logo /></span><span class="header-compact-logo" aria-hidden="true"><Logo compact /></span></a>
  <div class="header-controls">
    <NavLinks showDS={false} />
    <ThemeToggle />
    <IconButton class="menu-toggle" label="Open navigation" aria-controls="mobile-menu" aria-expanded="false"><span class="menu-label">Menu</span><span aria-hidden="true">☰</span></IconButton>
  </div>
</header>
<dialog id="mobile-menu" class="mobile-menu" aria-label="Navigation">
  <div class="drawer-top"><Logo /><ThemeToggle /><IconButton class="menu-close" label="Close navigation">×</IconButton></div>
  <NavLinks layout="mobile" showDS={false} />
</dialog>
