---
import IconButton from './IconButton.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import NavLinks from './NavLinks.astro';
---
<header class="site-header">
  <div class="header-pill-surface floating-control-surface floating-navigation-surface" aria-hidden="true"></div>
  <a href="/#top" tabindex="0" class="identity hit-area" aria-label="naz.wtf — home" data-home-top><span class="header-full-logo" aria-hidden="true"><Logo /></span><span class="header-compact-logo" aria-hidden="true"><Logo compact /></span></a>
  <div class="header-controls">
    <NavLinks showDS={false} />
    <ThemeToggle />
    <IconButton class="menu-toggle" icon="menu" label="Open navigation" aria-controls="mobile-menu" aria-expanded="false" />
  </div>
</header>
<dialog id="mobile-menu" class="mobile-menu" aria-label="Navigation">
  <div class="drawer-top"><Logo /><ThemeToggle /><IconButton class="menu-close" icon="close" label="Close navigation" /></div>
  <NavLinks layout="mobile" showDS={false} />
</dialog>
