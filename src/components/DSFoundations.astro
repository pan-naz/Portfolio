---
import {paletteColors,pageColorRoles,componentColorRoles,paletteTokenNames} from '../data/system-colors';
import {contrastRatio} from '../../scripts/text-contrast';
import {foundations} from '../data/design-system';import {systemTypography} from '../data/system-typography';
import {typeSamples,humanToken,px,tokenCode,sourceGrids} from '../data/system-human';
import {caseStudyMotionTokens,caseStudyPresentationTokens} from '../scripts/case-study/case-study-motion';
import Icon from './Icon.astro';import IconButton from './IconButton.astro';import TextLink from './TextLink.astro';import DSTabs from './DSTabs.astro';import DSTokenNames from './DSTokenNames.astro';
import type {IconName} from '../data/icons';
import Logo from './Logo.astro';
import {readFileSync} from 'node:fs';
interface Props {inventory:ReturnType<typeof import('../data/system-inventory').buildSystemInventory>;}
const {inventory}=Astro.props;
const waveValue=(name:string)=>inventory.tokens.find(token=>token.name===name)!.resolvedLight;
const springSource=readFileSync('src/styles/tokens.css','utf8').match(/stiffness (\d+), damping (\d+), mass (\d+)/)!;

const caseNames=[...caseStudyMotionTokens,...caseStudyPresentationTokens].map(item=>item.name.slice(2));
const categories:Record<string,string[]>={color:['color'],typography:['typography'],'spacing-layout':['spacing','shape','layout'],motion:['motion'],icons:['iconography']};
const tokensFor=(id:string)=>inventory.tokens.filter(token=>categories[id].includes(token.category)&&!caseNames.includes(token.name));
const colorValue=(name:string)=>inventory.tokens.find(token=>token.name===name)!.resolvedLight;
const stripText=(token:string)=>contrastRatio(colorValue('color-ink'),colorValue(token))>=contrastRatio(colorValue('color-paper'),colorValue(token))?'color-ink':'color-paper';
const typography=systemTypography(),weights:Record<string,string>={'400':'Regular','500':'Medium','600':'Semibold'};
const spacing=inventory.tokens.filter(token=>token.category==='spacing').sort((a,b)=>parseFloat(a.resolvedLight)-parseFloat(b.resolvedLight));
const durationNames=['duration-fast','duration-navigation','duration-button-fill','duration-work-stage','duration-copy-reveal'];
const durations=durationNames.map(name=>inventory.tokens.find(token=>token.name===name)).filter(Boolean);
const easings=['ease-icon-shift','ease-entrance','ease-close'].map(name=>inventory.tokens.find(token=>token.name===name)).filter(Boolean);
const easePath=(value:string)=>{const n=value.match(/cubic-bezier\(([^)]+)\)/)?.[1].split(',').map(Number)||[0,0,1,1];return `M 2 78 C ${2+n[0]*156} ${78-n[1]*76}, ${2+n[2]*156} ${78-n[3]*76}, 158 2`;};
---
{foundations.map(item=>{const tabs=`${item.id}-canvas`,tokens=item.id==='color'?[...new Map([...paletteTokenNames,...pageColorRoles,...componentColorRoles,...tokensFor(item.id).map(token=>token.name)].map(name=>[name,inventory.tokens.find(token=>token.name===name)!])).values()].filter(Boolean):tokensFor(item.id);return <section id={item.id} class="ds-view ds-foundation-view" data-ds-view data-title={item.title} data-description={item.description} data-group="Foundations" hidden>
 <div class="ds-stage" data-ds-card><div class="ds-stage-bar"><DSTabs id={tabs} labels={[item.id==='color'?'Colours':'Styles','Code']}/><DSTokenNames/></div>
  <div class="ds-foundation-rows" id={`${tabs}-panel-0`} role="tabpanel" aria-labelledby={`${tabs}-tab-0`}>
   {item.id==='color'&&<div class="ds-colors">
    <div class="ds-color-strip" aria-label="Shared palette">{paletteColors.map(color=><div style={`background:var(--${color.token});color:var(--${color.stripText||stripText(color.token)})`}><span>{color.name}</span></div>)}</div>
    <div class="ds-color-legend">{['light','dark','both'].map(mode=><span>{mode!=='dark'&&<Icon name="sun"/>}{mode!=='light'&&<Icon name="moon"/>}{mode==='light'?'Light mode':mode==='dark'?'Dark mode':'Both'}</span>)}</div>
    <p class="ds-color-note">Popups use the Light colours. Work and About use the Dark colours.</p>
    <div class="ds-color-cards">{paletteColors.map(color=><article class="ds-color-card" data-ds-palette={color.token}>
     <div class="ds-color-card-heading"><div class="ds-color-square" style={`background:var(--${color.token})`} aria-hidden="true"/><div><strong>{color.name}</strong><span>{colorValue(color.token)}</span><code class="ds-token-name">--{color.token}</code></div></div>
     <div class="ds-color-uses">{color.uses.map(use=><div data-ds-color-use={`${color.token}:${use.mode}`}><span class="ds-color-mode" aria-label={use.mode==='both'?'Both modes':`${use.mode} mode`}>{use.mode!=='dark'&&<Icon name="sun"/>}{use.mode!=='light'&&<Icon name="moon"/>}</span><span>{use.label}<code class="ds-token-name">{use.roles.map(role=>'--'+role).join(' · ')}</code></span></div>)}</div>
     {color.shades&&<div class="ds-color-shades">{color.shades.map(shade=><span class="ds-color-shade" data-ds-shade={shade.token}><span style={`--ds-swatch-shade:var(--${shade.token});--ds-swatch-base:var(--${shade.use.mode==='dark'?'color-ink':'color-white'})`} aria-hidden="true"/><strong>{shade.percent}%</strong><span>{shade.use.label}</span><code class="ds-token-name">--{shade.token} · {shade.use.roles.map(role=>'--'+role).join(' · ')}</code></span>)}</div>}
    </article>)}</div>
   </div>}
   {item.id==='typography'&&typography.map((style,index)=>{const sample=typeSamples[index];return <article class="ds-foundation-row ds-type-row" data-ds-type={style.name}><div class="ds-specimens ds-type-sample">{index===2?<h3 class={sample.className}>{sample.text}</h3>:<p class={sample.className}>{sample.html?<Fragment set:html={sample.html}/>:sample.text}</p>}</div><div class="ds-meta"><strong>{style.name}</strong><span>{style.family.includes('Funnel')?'Funnel Display':'Urbanist'} · {weights[style.weight]||style.weight}</span><span>{px(style.range)}</span><span data-ds-type-metrics></span><span>{sample.use}</span><code class="ds-token-name">--{style.sizeToken}</code></div></article>;})}
   {item.id==='spacing-layout'&&<>
    <article class="ds-foundation-row"><div class="ds-spacing-scale">{spacing.map(token=><div><span>{parseFloat(token.resolvedLight)}</span><span class="ds-spacing-bar" style={`width:var(--${token.name})`}/><code class="ds-token-name">--{token.name}</code></div>)}</div><div class="ds-meta"><strong>Spacing</strong><span>{spacing.map(token=>parseFloat(token.resolvedLight)).join(' · ')}px</span><span>Gaps, padding and section rhythm.</span></div></article>
    <article class="ds-foundation-row"><div class="ds-shape-grid">{['radius-small','radius-medium','radius-media','radius-pill'].map(name=><div><div class="ds-radius-tile" style={`border-radius:var(--${name})`}/><span>{humanToken(name.replace('radius-',''))}</span><code class="ds-token-name">--{name}</code></div>)}</div><div class="ds-meta"><strong>Corners</strong>{['radius-small','radius-medium','radius-media','radius-pill'].map(name=><span>{humanToken(name.replace('radius-',''))} · <span data-ds-human-token={name}/></span>)}<span>Controls, cards and media.</span></div></article>
    <article class="ds-foundation-row"><div class="ds-shape-grid">{['shadow-overlay','shadow-floating'].map(name=><div><div class="ds-elevation-tile" style={`box-shadow:var(--${name})`}/><code class="ds-token-name">--{name}</code></div>)}</div><div class="ds-meta"><strong>Elevation</strong><span>Overlay and floating surfaces.</span><span>Theme-aware shadows separate raised controls.</span></div></article>
    {sourceGrids().map(grid=><article class="ds-foundation-row"><div class:list={[grid.classes,'ds-layout-preview']} data-ds-grid={grid.name}>{Array.from({length:Math.max(...grid.counts)},()=> <span aria-hidden="true"/>)}</div><div class="ds-meta"><strong>{grid.name} grid</strong><span>{grid.counts.join(' → ')} columns</span><span data-ds-grid-spec={grid.name}></span><span>Responsive gutters · <span data-ds-human-token="gutter"/></span><span>{grid.name==='Projects'?'Website and Misc project collections.':'Results within each project.'}</span><code class="ds-token-name">{grid.selector} · --gutter</code></div></article>)}
   </>}
   {item.id==='motion'&&<><article class="ds-foundation-row" data-ds-logo-wave><div class="ds-specimens ds-inline-controls"><a href="/#top" aria-label="naz.wtf — home"><Logo /></a><a href="/#top" aria-label="naz.wtf — home"><Logo compact /></a></div><div class="ds-meta"><strong>Logo wave</strong><span>Hover or keyboard-focus a mark. Letters lift in order, then spring back together on leave.</span><span>Lift {waveValue('distance-icon-shift')} · Scale {waveValue('scale-logo-wave')} · Stagger {waveValue('stagger-title-reveal')}</span><span>Spring {springSource[1]} stiffness · {springSource[2]} damping · {springSource[3]} mass</span><span>Settle time {waveValue('duration-logo-wave')}</span><span>No touch or reduced motion.</span><code class="ds-token-name">--distance-icon-shift · --scale-logo-wave · --stagger-title-reveal · --ease-spring-wave · --duration-logo-wave</code></div></article><article class="ds-foundation-row"><div class="ds-specimens ds-inline-controls"><TextLink href="/design-system/">Design system</TextLink><IconButton href="/design-system/" icon="layers" label="Design system" variant="secondary" size="small" /></div><div class="ds-meta"><strong>Arrow shift · Layers lift</strong><span>Hover or focus to lift the layers. Mouse hover shifts the arrow.</span><span><span data-ds-human-token="distance-icon-shift"/> · <span data-ds-human-token="duration-fast"/> · <span data-ds-human-token="ease-icon-shift"/></span><code class="ds-token-name">--distance-icon-shift · --duration-fast · --ease-icon-shift</code></div></article><article class="ds-foundation-row"><div class="ds-duration-scale">{durations.map(token=><div><span>{humanToken(token!.name.replace('duration-',''))}</span><span class="ds-duration-bar" style={`width:${Math.min(180,parseFloat(token!.resolvedLight)/5)}px`}/><span>{token!.resolvedLight}</span><code class="ds-token-name">--{token!.name}</code></div>)}</div><div class="ds-meta"><strong>Durations</strong><span>Brief feedback through text entrances.</span><span>Respect reduced motion and pause hidden decoration.</span></div></article>{easings.map(token=><article class="ds-foundation-row"><div class="ds-easing-specimen"><svg role="img" aria-label={`${humanToken(token!.name)} easing curve`} viewBox="0 0 160 80"><path d={easePath(token!.resolvedLight)} fill="none" stroke="currentColor" stroke-width="2"/></svg></div><div class="ds-meta"><strong>{humanToken(token!.name.replace('ease-',''))}</strong><span>{token!.name==='ease-out'?'Fast start, smooth stop.':token!.name==='ease-entrance'?'Content and navigation entrances.':'Closing travel settles softly.'}</span><code class="ds-token-name">--{token!.name}</code></div></article>)}</>}
   {item.id==='icons'&&<><article class="ds-foundation-row"><ul class="ds-icon-grid">{inventory.iconNames.map(name=><li data-ds-icon={name}><Icon name={name as IconName}/><span>{name.replaceAll('-',' ')}</span></li>)}</ul><div class="ds-meta"><strong>Interface icons</strong><span><span data-ds-human-token="icon-size"/> · <span data-ds-human-token="icon-size-compact"/> compact</span><span>Menus, media controls and destinations.</span><code class="ds-token-name">--icon-size · --icon-size-compact</code></div></article><article class="ds-foundation-row"><div class="ds-icon-strokes"><Icon name="arrow"/><Icon name="arrow" class="icon--strong"/></div><div class="ds-meta"><strong>Stroke</strong><span><span data-ds-human-token="icon-stroke-regular"/> · regular</span><span><span data-ds-human-token="icon-stroke-strong"/> · strong</span><span>Rounded caps and joins.</span></div></article></>}
  </div>
  <div class="ds-code" id={`${tabs}-panel-1`} role="tabpanel" aria-labelledby={`${tabs}-tab-1`} hidden><pre><code>{tokenCode(tokens)}</code></pre>{tokens.map(token=><span data-ds-token={token.name}/>)}{item.id==='typography'&&<pre><code>{typography.map(style=>`${style.selector} {\n  font-family: ${style.family};\n  font-size: var(--${style.sizeToken});\n  font-weight: ${style.weight};\n  line-height: ${style.lineHeight};\n  letter-spacing: ${style.rawTracking};\n}`).join('\n\n')}</code></pre>}</div>
 </div>
</section>;})}
