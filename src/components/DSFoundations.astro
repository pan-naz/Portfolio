---
import { getIcon, type IconName } from '../data/icons';
import { responsiveTokenOverrides } from '../data/system-responsive';
import { systemTypography } from '../data/system-typography';
import Icon from './Icon.astro';
import Chip from './Chip.astro';
import { profile, projects } from '../data/portfolio';
interface Props { inventory: ReturnType<typeof import('../data/system-inventory').buildSystemInventory>; }
const { inventory } = Astro.props;
const categories = [['color','Color'],['typography','Typography'],['spacing','Spacing'],['shape','Radius & elevation'],['layout','Layout'],['motion','Motion'],['iconography','Iconography']] as const;
const roleName = (name: string) => name.replace(/^color-/, '').replaceAll('-', '/');
const rows = (category: string) => inventory.tokens.filter(token => token.category === category && !token.owner && !(category === 'motion' && /^(duration-|ease-)/.test(token.name)));
const weight = (name: IconName) => getIcon(name).weight === 'strong' ? 'icon-stroke-strong' : 'icon-stroke-regular';
const uses = (name: string) => inventory.components.filter(component => component.tokens.includes(name));
const target = (name: string) => `component-${name.replace(/([a-z])([A-Z])/g, '$1-$2').toLowerCase()}`;
const scales = (prefix: string) => {
  const groups = new Map<string, typeof inventory.tokens>();
  for (const token of inventory.tokens.filter(token => token.name.startsWith(prefix))) groups.set(token.resolvedLight, [...(groups.get(token.resolvedLight) || []), token]);
  return [...groups.entries()].sort(([a],[b]) => prefix === 'duration-' ? parseFloat(a) * (a.endsWith('ms') ? 1 : 1000) - parseFloat(b) * (b.endsWith('ms') ? 1 : 1000) : a.localeCompare(b));
};
const typography = systemTypography();
const responsive = responsiveTokenOverrides();
---
{categories.map(([category, label]) => <section id={category} class="ds-section" aria-labelledby={`${category}-title`}>
  <header class="ds-heading"><h2 id={`${category}-title`}>{label}</h2></header>
  {category === 'color' && <p>Use primary text for essential content and secondary text for supporting details. Canvas and surface roles define the page and its contained areas. Component colours are listed with their component.</p>}
  {category === 'typography' && <><p>Use the shared text style for its role. Fluid headings scale between the listed limits. Tracking is shown in em; fixed-size styles retain their exact CSS spacing.</p><div class="ds-type-list">{typography.map(style => <article><h3>{style.name}</h3><div class="ds-example-preview">{style.selector === 'h3' ? <h3>{profile.name}</h3> : style.selector === '.skill-tag' ? <Chip label={projects[0].tags[0]} /> : <p class={style.selector.slice(1)}>{profile.name}</p>}</div><table><tbody><tr><th>Name</th><td>{style.name}</td></tr><tr><th>Token</th><td><code>{`--${style.sizeToken}`}</code></td></tr><tr><th>Family</th><td>{style.family}</td></tr><tr><th>Weight</th><td>{style.weight}</td></tr><tr><th>Size range</th><td>{style.range}</td></tr><tr><th>Line height</th><td>{style.lineHeight}</td></tr><tr><th>Letter spacing</th><td>{style.tracking}</td></tr><tr><th>Usage</th><td>{uses(style.sizeToken).map(component => <a class="ds-inline-reference" href={`#${target(component.name)}`}>{component.name}</a>)}</td></tr></tbody></table></article>)}</div></>}
  {category === 'spacing' && <p>Use the named spacing steps instead of adding a separate scale.</p>}
  {category === 'shape' && <p>Use the existing radius and elevation for the role. Original artwork keeps its own appearance.</p>}
  {category === 'layout' && <p>Follow the website’s content widths, gutters and stacking rules.</p>}
  {category === 'motion' && <><p>Motion shows a change or helps readers follow content. Keep the established order and easing. Reduced motion removes travel and repeated movement while keeping the content available.</p>{[['duration-', 'Duration scale'], ['ease-', 'Easing scale']].map(([prefix,title]) => <><h3>{title}</h3><div class="ds-table-scroll"><table><thead><tr><th>Value</th><th>Tokens</th></tr></thead><tbody>{scales(prefix).map(([value,tokens]) => <tr><th>{value}</th><td>{tokens.map(token => <code class="ds-inline-reference" id={`token-${token.name}`} data-ds-token={token.name}>{`--${token.name}`}</code>)}</td></tr>)}</tbody></table></div></>)}<p>Component token references link to this scale. Case-study opening and closing are documented in Patterns.</p></>}
  {category === 'iconography' && <><ul class="ds-icon-grid">{inventory.iconNames.map(name => <li data-ds-icon={name}><Icon name={name as IconName} /><span>{name}</span><code>{`--${weight(name as IconName)}`}</code><span>{inventory.palettes.light[weight(name as IconName)]}</span></li>)}</ul><p>TextLink uses <code>--icon-stroke-emphasis</code> ({inventory.palettes.light['icon-stroke-emphasis']}) for its arrow. Other weights are shown beside each icon.</p></>}
  <div class="ds-table-scroll"><table><thead><tr><th>Role</th><th>Token</th><th>Light</th><th>Dark</th>{category === 'color' ? <th>Usage</th> : <th>Tier</th>}</tr></thead><tbody>{rows(category).map(token => <tr id={`token-${token.name}`} data-ds-token={token.name}><th>{roleName(token.name)}</th><td><code>{`--${token.name}`}</code></td><td>{token.resolvedLight}</td><td>{token.resolvedDark}</td><td>{category === 'color' ? (uses(token.name).length ? uses(token.name).map(component => <a class="ds-inline-reference" href={`#${target(component.name)}`}>{component.name}</a>) : inventory.tokens.filter(other => [other.light,other.dark].some(value => value.includes(`var(--${token.name})`))).map(other => <a class="ds-inline-reference" href={`#token-${other.name}`}>{roleName(other.name)}</a>)) : token.tier}</td></tr>)}</tbody></table></div>
  {category === 'layout' && <><h3>Responsive values</h3><div class="ds-table-scroll"><table><thead><tr><th>Condition</th><th>Token</th><th>Value</th></tr></thead><tbody>{responsive.map(row => <tr><th>{row.query}</th><td><code>{`--${row.name}`}</code></td><td>{row.value}</td></tr>)}</tbody></table></div></>}
  {category === 'color' && <details class="ds-implementation"><summary>Surface hierarchy</summary><p>Canvas is the page background. Surface contains content. Subtle surface separates supporting areas. Inverse roles support chapters with a different background.</p></details>}
</section>)}
