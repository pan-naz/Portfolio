---
import { getIcon, type IconName } from '../data/icons';
import { responsiveTokenOverrides } from '../data/system-responsive';
import { systemTypography } from '../data/system-typography';
import Icon from './Icon.astro';
import Chip from './Chip.astro';
import { profile, projects } from '../data/portfolio';
interface Props { inventory: ReturnType<typeof import('../data/system-inventory').buildSystemInventory>; }
const { inventory } = Astro.props;
const categories = [['color','Color'],['typography','Typography'],['spacing','Spacing'],['shape','Radius & elevation'],['layout','Layout'],['motion','Motion'],['iconography','Iconography']] as const;
const human = (name: string) => name.replace(/^color-/, '').replaceAll('-', ' ');
const isCaseMotion = (name: string) => /-case-|^case-hero-fit$/.test(name);
const rows = (category: string) => inventory.tokens.filter(token => token.category === category && !isCaseMotion(token.name));
const roles = [
  ['Text', /^(color-(?:inverse-)?text-)/],
  ['Background', /^(color-(?:inverse-)?bg-|color-section-bg-)/],
  ['Border', /^(color-(?:inverse-)?border-|control-border$|focus-ring$)/],
  ['Accent', /^color-(interactive-accent|inverse-accent)$/],
  ['Overlay', /^(color-overlay-|backdrop-)/],
  ['Navigation', /^color-navigation-/],
] as const;
const colors = rows('color').filter(token => token.tier !== 'primitive');
const shapes = rows('shape').filter(token => token.tier !== 'primitive');
const scales = (prefix: string) => {
  const groups = new Map<string, typeof inventory.tokens>();
  for (const token of rows('motion').filter(token => token.name.startsWith(prefix))) groups.set(token.resolvedLight, [...(groups.get(token.resolvedLight) || []), token]);
  return [...groups.entries()].sort(([a],[b]) => prefix === 'duration-' ? parseFloat(a) * (a.endsWith('ms') ? 1 : 1000) - parseFloat(b) * (b.endsWith('ms') ? 1 : 1000) : a.localeCompare(b));
};
const typography = systemTypography();
const responsive = responsiveTokenOverrides();
---
{categories.map(([category, label]) => <section id={category} class="ds-section" aria-labelledby={`${category}-title`}>
  <header class="ds-heading"><h2 id={`${category}-title`}>{label}</h2></header>
  {category === 'color' && <><p>Choose a role, then let the theme choose its value.</p>{roles.map(([title,pattern]) => <div class="ds-foundation-group"><h3>{title}</h3><div class="ds-swatch-grid">{colors.filter(token => pattern.test(token.name)).map(token => <article class="ds-swatch-card" data-ds-swatch={token.name}><div class="ds-swatch" style={`background:var(--${token.name})`} aria-hidden="true" /><p>{human(token.name)}</p><code><span class="ds-value-light">{token.resolvedLight}</span><span class="ds-value-dark">{token.resolvedDark}</span></code></article>)}</div></div>)}</>}
  {category === 'typography' && <div class="ds-type-list">{typography.map(style => <article class="ds-type-row"><div class="ds-type-specimen">{style.selector === 'h3' ? <h3>{profile.name}</h3> : style.selector === '.skill-tag' ? <Chip label={projects[0].tags[0]} /> : <p class={style.selector.slice(1)}>{profile.name}</p>}</div><div class="ds-type-caption"><h3>{style.name}</h3><p>{style.range} · {style.weight} · {style.lineHeight}</p></div><details><summary>Spec</summary><dl class="ds-spec"><dt>Family</dt><dd>{style.family}</dd><dt>Size token</dt><dd><code>{`--${style.sizeToken}`}</code></dd><dt>Tracking</dt><dd>{style.tracking}</dd><dt>CSS style</dt><dd><code>{style.selector}</code></dd></dl></details></article>)}</div>}
  {category === 'spacing' && <div class="ds-spacing-scale">{rows(category).sort((a,b) => parseFloat(a.resolvedLight)-parseFloat(b.resolvedLight)).map(token => <div><code>{token.name}</code><div class="ds-spacing-bar" style={`width:var(--${token.name})`} aria-hidden="true" /><span>{token.resolvedLight}</span></div>)}</div>}
  {category === 'shape' && <div class="ds-shape-grid">{shapes.map(token => <article><div class="ds-shape-tile" style={token.name.startsWith('radius-') ? `border-radius:var(--${token.name})` : `box-shadow:var(--${token.name})`} aria-hidden="true" /><p>{human(token.name)}</p><code><span class="ds-value-light">{token.resolvedLight}</span><span class="ds-value-dark">{token.resolvedDark}</span></code></article>)}</div>}
  {category === 'layout' && <><div class="ds-layout-preview" aria-label="Twelve-column layout grid">{Array.from({length:12},(_,index) => <span aria-hidden="true">{index+1}</span>)}</div><p>Content follows the shared gutters and grid gap.</p><details><summary>Responsive values</summary><div class="ds-table-scroll"><table><thead><tr><th>Condition</th><th>Token</th><th>Value</th></tr></thead><tbody>{responsive.map(row => <tr><th>{row.query}</th><td><code>{row.name}</code></td><td>{row.value}</td></tr>)}</tbody></table></div></details></>}
  {category === 'motion' && <div class="ds-motion-scales">{[['duration-', 'Durations'], ['ease-', 'Easings']].map(([prefix,title]) => <div><h3>{title}</h3><ul class="ds-motion-scale">{scales(prefix).map(([value,tokens]) => <li><strong>{value}</strong><details><summary>{tokens.length} {tokens.length===1 ? 'token' : 'tokens'}</summary>{tokens.map(token => <p><code>{token.name}</code></p>)}</details></li>)}</ul></div>)}</div>}
  {category === 'iconography' && <ul class="ds-icon-grid">{inventory.iconNames.map(name => <li data-ds-icon={name}><Icon name={name as IconName} /><span>{name.replaceAll('-', ' ')}</span><details><summary>Spec</summary><code>{getIcon(name as IconName).weight === 'strong' ? 'icon-stroke-strong' : 'icon-stroke-regular'}</code></details></li>)}</ul>}
  <details class="ds-all-tokens"><summary>All {category === 'color' ? 'colour' : category === 'shape' ? 'radius & elevation' : category} tokens</summary><div class="ds-table-scroll"><table><thead><tr><th>Token</th><th>Light</th><th>Dark</th></tr></thead><tbody>{rows(category).map(token => <tr id={`token-${token.name}`} data-ds-token={token.name}><th><code>{`--${token.name}`}</code></th><td>{token.resolvedLight}</td><td>{token.resolvedDark}</td></tr>)}</tbody></table></div></details>
</section>)}
