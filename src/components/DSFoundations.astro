---
import {paletteColors,colorRoles,strokeCards,paletteTokenNames} from '../data/system-colors';
import {contrastRatio} from '../../scripts/text-contrast';
import {foundations} from '../data/design-system';import {typographySystem} from '../data/system-typography';
import {humanToken} from '../data/system-human';
import {foundationSourceCode,codeSegments} from '../data/system-code';
import {spacingLayoutSystem} from '../data/system-spacing-layout';
import {caseStudyMotionTokens,caseStudyPresentationTokens} from '../scripts/case-study/case-study-motion';
import Button from './Button.astro';import Icon from './Icon.astro';import IconButton from './IconButton.astro';import TextLink from './TextLink.astro';import DSTabs from './DSTabs.astro';import DSTokenNames from './DSTokenNames.astro';
import type {IconName} from '../data/icons';
import Logo from './Logo.astro';
import {readFileSync} from 'node:fs';
interface Props {inventory:ReturnType<typeof import('../data/system-inventory').buildSystemInventory>;}
const {inventory}=Astro.props;
const waveValue=(name:string)=>inventory.tokens.find(token=>token.name===name)!.resolvedLight;
const springSource=readFileSync('src/styles/tokens.css','utf8').match(/stiffness (\d+), damping (\d+), mass (\d+)/)!;

const caseNames=[...caseStudyMotionTokens,...caseStudyPresentationTokens].map(item=>item.name.slice(2));
const categories:Record<string,string[]>={color:['color'],typography:['typography'],'spacing-layout':['spacing','shape','layout'],motion:['motion'],icons:['iconography']};
const tokensFor=(id:string)=>inventory.tokens.filter(token=>categories[id].includes(token.category)&&!caseNames.includes(token.name));
const colorValue=(name:string)=>inventory.tokens.find(token=>token.name===name)!.resolvedLight;
const stripText=(token:string)=>contrastRatio(colorValue('color-ink'),colorValue(token))>=contrastRatio(colorValue('color-paper'),colorValue(token))?'color-ink':'color-paper';
const globalStyles=readFileSync('src/styles/global.css','utf8');
const focusStyle=globalStyles.match(/:where\(button, a, summary, input, select, textarea, \[tabindex\]\):focus-visible\s*\{([^}]+)\}/)![1];
const strokeValue=(role:string,mode:'light'|'dark')=>{const token=inventory.tokens.find(item=>item.name===role)!;let primitive=role;const seen=new Set<string>();while(!paletteTokenNames.includes(primitive)){if(seen.has(primitive))throw Error('Cyclic color role '+role);seen.add(primitive);primitive=inventory.palettes[mode][primitive].match(/var\(--([\w-]+)\)/)![1];}const color=paletteColors.find(item=>item.token===primitive||item.shades?.some(shade=>shade.token===primitive))!,value=mode==='light'?token.resolvedLight:token.resolvedDark,alpha=value.match(/\/\s*([\d.]+)\s*\)/)?.[1];return {token:primitive,value,label:color.name+(alpha?' '+Number(alpha)*100+'%':'')};};
const foundationCode=foundationSourceCode().groups;
const typeSystem=typographySystem(),typography=typeSystem.styles;
const spaceSystem=spacingLayoutSystem(inventory.tokens);
const durationNames=['duration-fast','duration-navigation','duration-button-fill','duration-work-stage','duration-copy-reveal'];
const durations=durationNames.map(name=>inventory.tokens.find(token=>token.name===name)).filter(Boolean);
const easings=['ease-icon-shift','ease-entrance','ease-close'].map(name=>inventory.tokens.find(token=>token.name===name)).filter(Boolean);
const typeDevices=['desktop','tablet','phone'] as const;
const deviceNames={desktop:'Desktop',tablet:'Tablet',phone:'Phone'};
const deviceScope=(style:typeof typography[number],device:typeof typeDevices[number])=>`--text-${style.id}:${style.devices[device].size};--letter-spacing-${style.id}:${style.devices[device].spacing}`;
const typePercent=(value:number)=>Number((value*100).toFixed(2));
const easePath=(value:string)=>{const n=value.match(/cubic-bezier\(([^)]+)\)/)?.[1].split(',').map(Number)||[0,0,1,1];return `M 2 78 C ${2+n[0]*156} ${78-n[1]*76}, ${2+n[2]*156} ${78-n[3]*76}, 158 2`;};
---
{foundations.map(item=>{const tabs=`${item.id}-canvas`,tokens=item.id==='color'?[...new Map([...paletteTokenNames,...colorRoles,...tokensFor(item.id).map(token=>token.name)].map(name=>[name,inventory.tokens.find(token=>token.name===name)!])).values()].filter(Boolean):tokensFor(item.id);return <section id={item.id} class="ds-view ds-foundation-view" data-ds-view data-title={item.title} data-description={item.description} data-group="Foundations" hidden>
 <div class="ds-stage" data-ds-card><div class="ds-stage-bar"><DSTabs id={tabs} labels={['Preview','Code']}/><DSTokenNames/></div>
  <div class="ds-foundation-rows" id={`${tabs}-panel-0`} role="tabpanel" aria-labelledby={`${tabs}-tab-0`}>
   {item.id==='color'&&<div class="ds-colors">
    <div class="ds-color-strip" aria-label="Shared palette">{paletteColors.map(color=><div style={`background:var(--${color.token});color:var(--${color.stripText||stripText(color.token)})`}><span>{color.name}</span></div>)}</div>
    <div class="ds-color-legend">{['light','dark','both'].map(mode=><span class="ds-icon-text-row"><span class="ds-color-mode">{mode!=='dark'&&<Icon name="sun"/>}{mode!=='light'&&<Icon name="moon"/>}</span><span class="ds-mode-text">{mode==='light'?'Light mode':mode==='dark'?'Dark mode':'Both'}</span></span>)}</div>
    <div class="ds-color-cards">{paletteColors.map(color=><article class="ds-color-card" data-ds-palette={color.token}>
     <div class="ds-color-square" style={`background:var(--${color.token})`} aria-hidden="true"/>
     <div class="ds-color-copy"><div class="ds-color-card-heading"><strong><DSTokenNames label={color.name} token={'--'+color.token}/></strong><span>{colorValue(color.token)}</span></div>
     <div class="ds-color-uses">{color.uses.map(use=><div class="ds-icon-text-row" data-ds-color-use={`${color.token}:${use.mode}`}><span class="ds-color-mode" aria-label={use.mode==='both'?'Both modes':`${use.mode} mode`}>{use.mode!=='dark'&&<Icon name="sun"/>}{use.mode!=='light'&&<Icon name="moon"/>}</span><span class="ds-mode-text">{use.label}</span></div>)}</div>
     </div>
    </article>)}</div>
    <div class="ds-stroke-cards">{strokeCards.map(stroke=><article class="ds-stroke-card" data-ds-stroke={stroke.role}>
     <div class="ds-stroke-sample" inert aria-hidden="true" data-ds-static-demo>
      {stroke.demo==='border'&&<div class="ds-border-demo"><span/></div>}
      {stroke.demo==='button'&&<Button variant="secondary" tabindex={-1}>Download CV (PDF)</Button>}
      {stroke.demo==='focus'&&<Button arrow="up" tabindex={-1} style={focusStyle}>Get in touch</Button>}
      {stroke.demo==='video'&&<div class="ds-video-track-demo"><span/></div>}
     </div>
     <strong><DSTokenNames label={stroke.name} token={'--'+stroke.role}/></strong><p>{stroke.description}</p>
     <div class="ds-stroke-values">{(['light','dark'] as const).map(mode=>{const value=strokeValue(stroke.role,mode);return <div class="ds-icon-text-row" data-ds-stroke-value={mode}><span class="ds-color-mode"><Icon name={mode==='light'?'sun':'moon'}/></span><span class="ds-stroke-swatch" style={`--ds-swatch-shade:var(--${value.token});--ds-swatch-base:var(--${mode==='light'?'color-white':'color-ink'})`} aria-hidden="true"/><span class="ds-mode-text" title={value.value}>{value.label}</span></div>;})}</div>
    </article>)}</div>
   </div>}
   {item.id==='typography'&&<div class="ds-type-table">
    <div class="ds-type-device-headers"><span/>{typeDevices.map(device=><div class="ds-type-device-header">{device==='desktop'?<Icon name="monitor"/>:device==='tablet'?<Icon name="tablet"/>:<Icon name="phone"/>}<div><p class="text-body-m-strong">{deviceNames[device]}</p><p class="text-body-s">{typeSystem.ranges[device]}</p></div></div>)}</div>
    {typography.map((style,index)=><article class="ds-type-style" data-ds-type-style={style.id}>
     <div class="ds-type-info"><strong class="text-body-m-strong"><DSTokenNames label={style.name} token={'--'+style.sizeToken}/></strong><p class="text-body-s">{style.fontName}{style.id==='label-m'?' · Uppercase':''}</p><p class="text-body-s">Weight {style.weight} · {style.weight==='400'?'Regular':'Medium'}</p><p class="text-body-s">Line height {Number(style.lineHeight).toFixed(2)}</p><p class="text-body-s ds-type-use">{style.use}</p></div>
     {typeDevices.map(device=><div class:list={['ds-type-device',index===typography.length-1&&'ds-type-device-last']} data-type-device={device} style={deviceScope(style,device)}>
      <div class="ds-type-mobile-header">{device==='desktop'?<Icon name="monitor"/>:device==='tablet'?<Icon name="tablet"/>:<Icon name="phone"/>}<div><p class="text-body-m-strong">{deviceNames[device]}</p><p class="text-body-s">{typeSystem.ranges[device]}</p></div></div>
      <div class:list={['ds-type-sample-slot','text-'+style.id]} style={deviceScope(style,'desktop')}><p class:list={['ds-type-live','text-'+style.id]} data-type-sample={style.id} style={deviceScope(style,device)}>{style.sample}</p></div>
      <p class:list={['text-body-s','ds-type-value',style.devices[device].size!==style.devices.desktop.size&&'ds-type-changed']} data-type-size={style.id}>{style.devices[device].size!==style.devices.desktop.size&&<span class="ds-type-dot" aria-hidden="true"/>}{Number((style.devices[device].sizeRem*16).toFixed(4))}px · {style.devices[device].sizeRem}rem</p>
      <p class:list={['text-body-s','ds-type-value',style.devices[device].spacing!==style.devices.desktop.spacing&&'ds-type-changed']} data-type-spacing={style.id}>{style.devices[device].spacing!==style.devices.desktop.spacing&&<span class="ds-type-dot" aria-hidden="true"/>}Letter spacing {typePercent(style.devices[device].spacingEm)}%</p>
     </div>)}
    </article>)}
    <p class="ds-type-legend text-body-s"><span class="ds-type-dot" aria-hidden="true"/>Changes on this device</p>
   </div>}
   {item.id==='spacing-layout'&&<div class="ds-space-catalog">
    <section class="ds-space-section"><p class="text-label-m">Spacing scale</p>
     <div class="ds-space-scale">{spaceSystem.spaces.map(space=><div class="ds-space-scale-step"><div class="ds-space-bar-slot"><span class="ds-space-bar" style={`height:var(--${space.name})`} aria-hidden="true"/></div><div class="ds-space-scale-label"><DSTokenNames label={String(space.px)} token={'--'+space.name}/></div></div>)}</div>
     <div class="ds-space-cards">{spaceSystem.spaces.map(space=><article class="ds-space-card" data-ds-space={space.name}><div class="ds-space-demo" aria-hidden="true"><span style={`width:var(--${space.name})`}/></div><div><strong><DSTokenNames label={'Space '+space.step} token={'--'+space.name}/></strong><p>{space.px}px · {space.rem}rem</p><p data-ds-space-uses={space.name}>{space.uses} uses</p></div></article>)}</div>
    </section>
    <section class="ds-space-section"><p class="text-label-m">Layout</p><div class="ds-layout-cards">{spaceSystem.layouts.map(layout=><article class={'ds-layout-card ds-layout-card--'+layout.device} data-ds-layout-device={layout.device}>
     <div class="ds-device-caption"><Icon name={layout.device==='desktop'?'monitor':layout.device==='tablet'?'tablet':'phone'}/><div><strong>{layout.name}</strong><p>{layout.range}</p></div></div>
     <div class="ds-layout-stage" aria-hidden="true"><div class="ds-layout-sheet" style={`padding:calc(${layout.edge}px / 4)`}><span class="ds-layout-title-bar"/><div class="ds-layout-projects" data-ds-layout-columns={layout.projects} style={`grid-template-columns:repeat(${layout.projects},minmax(0,1fr));gap:calc(${layout.gap} / 4)`}>{Array.from({length:2},()=> <span/>)}</div><div class="ds-layout-metrics" data-ds-layout-columns={layout.metrics} style={`grid-template-columns:repeat(${layout.metrics},minmax(0,1fr));gap:calc(${layout.gap} / 4)`}>{Array.from({length:3},()=> <span/>)}</div></div></div>
     <p><DSTokenNames label={layout.caption} token="--gutter · --grid-gap"/></p>
    </article>)}</div></section>
    <section class="ds-space-section"><p class="text-label-m">Radius</p><div class="ds-radius-cards">{spaceSystem.radius.map(radius=><article class="ds-radius-card" data-ds-radius={radius.token}><div class="ds-radius-demo" aria-hidden="true"><span class:list={[radius.id==='full'&&'ds-radius-pill']} style={`border-${radius.id==='full'?'radius':'top-left-radius'}:var(--${radius.token})`}/></div><strong><DSTokenNames label={radius.name} token={'--'+radius.token}/></strong><p>{radius.value}</p><p>{radius.use}</p></article>)}</div></section>
    <section class="ds-space-section"><p class="text-label-m">Elevation</p><div class="ds-shadow-cards">{spaceSystem.shadows.map(shadow=><article class="ds-shadow-card" data-ds-shadow={shadow.token}>
     <div class="ds-shadow-demo" aria-hidden="true">{(['light','dark'] as const).map(mode=><div data-color-zone={mode}><span style={`box-shadow:var(--${shadow.token})`}/></div>)}</div>
     <strong><DSTokenNames label={shadow.name} token={'--'+shadow.token}/></strong><p>{shadow.use}</p><div class="ds-shadow-values">{(['light','dark'] as const).map(mode=><p><Icon name={mode==='light'?'sun':'moon'}/><code>{shadow[mode]}</code></p>)}</div>
    </article>)}</div></section>
   </div>}
   {item.id==='motion'&&<><article class="ds-foundation-row" data-ds-logo-wave><div class="ds-specimens ds-inline-controls"><a href="/#top" aria-label="naz.wtf — home"><Logo /></a><a href="/#top" aria-label="naz.wtf — home"><Logo compact /></a></div><div class="ds-meta"><strong>Logo wave</strong><span>Hover or keyboard-focus a mark. Letters lift in order, then spring back together on leave.</span>{[['Lift','distance-icon-shift'],['Scale','scale-logo-wave'],['Stagger','stagger-title-reveal']].map(([label,name])=><span><DSTokenNames label={label} token={'--'+name}/> · {waveValue(name)}</span>)}<span><DSTokenNames label="Spring" token="--ease-spring-wave"/> · {springSource[1]} stiffness · {springSource[2]} damping · {springSource[3]} mass</span><span><DSTokenNames label="Settle time" token="--duration-logo-wave"/> · {waveValue('duration-logo-wave')}</span><span>No touch or reduced motion.</span></div></article><article class="ds-foundation-row"><div class="ds-specimens ds-inline-controls"><TextLink href="/design-system/">Design system</TextLink><IconButton href="/design-system/" icon="layers" label="Design system" variant="secondary" size="small" /></div><div class="ds-meta"><strong>Arrow shift · Layers lift</strong><span>Hover or focus to lift the layers. Mouse hover shifts the arrow.</span>{[['Lift','distance-icon-shift'],['Duration','duration-fast'],['Easing','ease-icon-shift']].map(([label,name])=><span><DSTokenNames label={label} token={'--'+name}/> · <span data-ds-human-token={name}/></span>)}</div></article><article class="ds-foundation-row"><div class="ds-duration-scale">{durations.map(token=><div><DSTokenNames label={humanToken(token!.name.replace('duration-',''))} token={'--'+token!.name}/><span class="ds-duration-bar" style={`width:${Math.min(180,parseFloat(token!.resolvedLight)/5)}px`}/><span>{token!.resolvedLight}</span></div>)}</div><div class="ds-meta"><strong>Durations</strong><span>Brief feedback through text entrances.</span><span>Respect reduced motion and pause hidden decoration.</span></div></article>{easings.map(token=><article class="ds-foundation-row"><div class="ds-easing-specimen"><svg role="img" aria-label={`${humanToken(token!.name)} easing curve`} viewBox="0 0 160 80"><path d={easePath(token!.resolvedLight)} fill="none" stroke="currentColor" stroke-width="2"/></svg></div><div class="ds-meta"><strong><DSTokenNames label={humanToken(token!.name.replace('ease-',''))} token={'--'+token!.name}/></strong><span>{token!.name==='ease-out'?'Fast start, smooth stop.':token!.name==='ease-entrance'?'Content and navigation entrances.':'Closing travel settles softly.'}</span></div></article>)}</>}
   {item.id==='icons'&&<><article class="ds-foundation-row"><ul class="ds-icon-grid">{inventory.iconNames.map(name=><li data-ds-icon={name}><Icon name={name as IconName}/><span>{name.replaceAll('-',' ')}</span></li>)}</ul><div class="ds-meta"><strong>Interface icons</strong><span><DSTokenNames label="Size" token="--icon-size"/> · <span data-ds-human-token="icon-size"/></span><span><DSTokenNames label="Compact" token="--icon-size-compact"/> · <span data-ds-human-token="icon-size-compact"/></span><span>Menus, media controls and destinations.</span></div></article><article class="ds-foundation-row"><div class="ds-icon-strokes"><Icon name="arrow"/><Icon name="arrow" class="icon--strong"/></div><div class="ds-meta"><strong>Stroke</strong><span><DSTokenNames label="Regular" token="--icon-stroke-regular"/> · <span data-ds-human-token="icon-stroke-regular"/></span><span><DSTokenNames label="Strong" token="--icon-stroke-strong"/> · <span data-ds-human-token="icon-stroke-strong"/></span><span>Rounded caps and joins.</span></div></article></>}
  </div>
  <div class="ds-code" id={`${tabs}-panel-1`} role="tabpanel" aria-labelledby={`${tabs}-tab-1`} hidden>
   {foundationCode[item.id].map(columns=><div class:list={['ds-code-columns',columns.length===1&&'ds-code-single']}>
    {columns.map(blocks=><pre>{blocks.map((block,index)=><Fragment>{index>0&&"\n\n"}<code data-ds-code-source={block.key}>{codeSegments(block.source).map(piece=>piece.comment?<span class="ds-code-comment">{piece.text}</span>:piece.text)}</code></Fragment>)}</pre>)}
   </div>)}
   {tokens.map(token=><span data-ds-token={token.name}/>)}
  </div>
 </div>
</section>;})}
