---
interface Props { id: string; name: string; description: string; source: string; notes?: string; }
const { id, name, description, source, notes } = Astro.props;
---
<section id={id} class="ds-example" aria-labelledby={`${id}-title`} tabindex="-1">
  <header class="ds-example-heading"><h3 id={`${id}-title`}>{name}</h3><p>{description}</p></header>
  <div class="ds-example-preview"><slot /></div>
  {notes && <p class="ds-spec-note">{notes}</p>}
  <p class="ds-source">{source}</p>
</section>
