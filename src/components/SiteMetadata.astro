---
import { indexingEnabled, siteTitle } from '../data/site-config';
import { profile } from '../data/portfolio';
import { readFileSync } from 'node:fs';
import { imageMetadata } from 'astro/assets/utils';
interface Props { title: string; description: string; sharingDescription?: string; image?: string; }
const { title, description, sharingDescription = description, image } = Astro.props;
const pathname = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '') + '/';
const canonical = new URL(pathname === '/404/' ? '/404.html' : pathname, Astro.site);
const imagePath = image ?? (pathname === '/' || pathname === '/design-system/' ? '/og/home.jpg' : undefined);
const shareImage = imagePath ? new URL(imagePath, Astro.site) : undefined;
const dimensions = imagePath ? await imageMetadata(readFileSync(`public${imagePath}`), imagePath) : undefined;
const homeUrl = new URL('/', Astro.site).href;
const structuredData = pathname === '/' ? {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: siteTitle, alternateName: profile.brand, url: homeUrl },
    { '@type': 'Person', name: profile.name, alternateName: profile.alternateNames,
      jobTitle: profile.title, url: homeUrl, sameAs: profile.sameAs },
  ],
} : undefined;
---
<meta name="description" content={description} />
<meta name="robots" content={indexingEnabled ? 'index, follow' : 'noindex, nofollow'} />
<link rel="canonical" href={canonical.href} />
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta property="og:title" content={title} />
<meta property="og:description" content={sharingDescription} />
<meta property="og:url" content={canonical.href} />
<meta property="og:type" content="website" />
{shareImage && <>
  <meta property="og:image" content={shareImage.href} />
  <meta property="og:image:width" content={String(dimensions!.width)} />
  <meta property="og:image:height" content={String(dimensions!.height)} />
  <meta property="og:image:alt" content={title} />
</>}
<meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
{structuredData && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
