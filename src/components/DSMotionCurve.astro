---
import {curveGeometry} from '../data/system-motion';
interface Props {value:string;chip?:boolean;}
const {value,chip=false}=Astro.props,curve=curveGeometry(value);
---
<svg role="img" class="ds-motion-curve" viewBox={chip?"10 10 100 60":"0 0 120 80"} aria-hidden="true"><path class="ds-motion-guides" d="M12 12V68H108M12 20H108"/><path class="ds-motion-curve-line" d={curve.path}/>{curve.dots.map((point,index)=><circle cx={point.x} cy={point.y} r="2" style={`opacity:${(index+1)/curve.dots.length}`}/>)}</svg>
