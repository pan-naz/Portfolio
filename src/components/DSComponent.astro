---
import type { SourceComponent } from '../data/system-inventory';
import { componentVariants } from '../data/system-variants';
import { documentationFor } from '../data/system-documentation';
import { componentManifest } from '../data/system-components';
import Button from './Button.astro';
import DSPreview from './DSPreview.astro';
interface Props { component: SourceComponent; inventory: ReturnType<typeof import('../data/system-inventory').buildSystemInventory>; }
const { component, inventory } = Astro.props;
const doc = documentationFor(component);
const entry = componentManifest.find(item => item.file === component.file)!;
const id = `component-${component.name.replace(/([a-z])([A-Z])/g, '$1-$2').toLowerCase()}`;
const tokens = inventory.tokens.filter(token => component.tokens.includes(token.name));
const helpers = [...component.source.matchAll(/import\s+(\w+)\s+from\s+['"][^'"]+\.astro['"]/g)].map(([,name]) => name);
const tabs = ['Preview', 'Specs', 'Usage', 'Code'];
const code = component.usages.find(usage => !inventory.privateNames.some(name => usage.code.includes(`--${name}`)))?.code ?? component.file;
---
<section id={id} class="ds-section ds-component" data-ds-component={component.name} aria-labelledby={`${id}-title`}>
  <header class="ds-heading"><h3 id={`${id}-title`} class="ds-component-title">{entry.title}</h3><p>{doc.purpose}</p></header>
  <div class="ds-card" data-ds-card>
    <div class="ds-card-tabs" role="tablist" aria-label={`${entry.title} details`}>
      {tabs.map((label,index) => <Button size="small" variant={index === 0 ? 'primary' : 'secondary'} appearance="comparison" id={`${id}-tab-${index}`} role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`${id}-panel-${index}`} tabindex={index === 0 ? 0 : -1} data-ds-tab={index}>{label}</Button>)}
    </div>
    <div class="ds-card-panel ds-preview" id={`${id}-panel-0`} role="tabpanel" aria-labelledby={`${id}-tab-0`} tabindex="0"><DSPreview component={component} /></div>
    <div class="ds-card-panel" id={`${id}-panel-1`} role="tabpanel" aria-labelledby={`${id}-tab-1`} tabindex="0" hidden>
      <h4>Sizes, spacing & tokens</h4>
      <p>Values come from the component’s shared styles and follow the page theme.</p>
      <div class="ds-table-scroll"><table><thead><tr><th>Token</th><th>Light</th><th>Dark</th></tr></thead><tbody>{tokens.map(token => <tr id={token.owner === component.name ? `token-${token.name}` : undefined} data-ds-token={token.owner === component.name ? token.name : undefined}><th><code>{`--${token.name}`}</code></th><td>{token.resolvedLight}</td><td>{token.resolvedDark}</td></tr>)}</tbody></table></div>
    </div>
    <div class="ds-card-panel" id={`${id}-panel-2`} role="tabpanel" aria-labelledby={`${id}-tab-2`} tabindex="0" hidden>
      <ul class="ds-guidance"><li><strong>Do:</strong> {doc.useWhen}</li><li><strong>Don’t:</strong> {doc.avoidWhen}</li><li><strong>Keep accessible:</strong> {doc.accessibility}</li></ul>
    </div>
    <div class="ds-card-panel" id={`${id}-panel-3`} role="tabpanel" aria-labelledby={`${id}-tab-3`} tabindex="0" hidden>
      <p><code>{component.file}</code></p>
      <div class="ds-table-scroll"><table><thead><tr><th>Prop</th><th>Type</th><th>Required</th></tr></thead><tbody>{component.props.map(prop => <tr><th><code>{prop.name}</code></th><td><code>{prop.type}</code></td><td>{prop.conditional ? 'In one input form' : prop.optional ? 'No' : 'Yes'}</td></tr>)}</tbody></table></div>
      {component.source.includes('<slot') && <p>Slot: supplied content{['Button','TextLink'].includes(component.name) ? ' and visible label' : ''}.</p>}
      <h4>Composed components & helpers</h4><p>{helpers.length ? helpers.join(', ') : 'No Astro helpers.'}</p>
      <h4>Used on the website</h4><ul class="ds-file-list">{[...new Set(component.usages.map(usage => usage.file))].map(file => <li><code>{file}</code></li>)}</ul>
      <details><summary>Used prop values</summary><ul>{componentVariants(component).map(variant => <li data-ds-variant={`${component.name}:${variant}`}><code>{variant}</code></li>)}</ul></details>
      <pre><code>{code}</code></pre>
    </div>
  </div>
</section>
