---
import type {SourceComponent} from '../data/system-inventory';
import {caseStudyMotionTokens,caseStudyPresentationTokens} from '../scripts/case-study/case-study-motion';
import {componentStyleSpecs} from '../data/system-specs';
import {documentationFor} from '../data/system-documentation';
import {componentPropSpecs} from '../data/system-props';
import {anatomyFor,plainComponentNames} from '../data/system-anatomy';
import {variantLabels} from '../data/system-variant-labels';
import {dsComponents} from '../data/ds-components';
import DSPreview from './DSPreview.astro';
import DSTabs from './DSTabs.astro';
import DSTokens from './DSTokens.astro';
interface Props {component:SourceComponent;inventory:ReturnType<typeof import('../data/system-inventory').buildSystemInventory>;}
const {component,inventory}=Astro.props;
const entry=dsComponents.find(item=>item.file===component.file)!;
const id=entry.section,doc=documentationFor(component), variants=variantLabels(component),props=componentPropSpecs(component);
const tokens=inventory.tokens.filter(token=>component.tokens.includes(token.name));
const primaryTokens=[...['color-text-primary','color-text-on-primary','color-interactive-accent','color-border-default','color-navigation-text-primary','color-overlay-bg-surface','focus-ring'].flatMap(name=>tokens.filter(token=>token.name===name)).slice(0,4),...tokens.filter(token=>['control-height','control-icon','radius-pill','radius-media','space-3','duration-button-fill'].includes(token.name)).slice(0,4)];
const rules=componentStyleSpecs(component).filter(rule=>!rule.selector.includes('catalog'));
const sizes=[...new Map(rules.map(rule=>[`${rule.property}:${rule.value}`,rule])).values()];
const displayValue=(value:string)=>value.replace(/var\(--([\w-]+)\)/g,(_,name)=>inventory.palettes.value(inventory.palettes.light,name));
const buttonSizes=[{name:'Large',value:inventory.palettes.value(inventory.palettes.light,'control-height'),style:'Body/M Strong'},{name:'Small',value:rules.find(rule=>rule.selector.includes('.button--small')&&rule.property==='min-height')?.value||'',style:'Body/S'}];
const hiddenVariantProps=['download','reveal','priority','size'];
const helpers=[...component.source.matchAll(/import\s+(\w+)\s+from\s+['"][^'"]+\.astro['"]/g)].map(([,name])=>name);
const previewTabs=`${id}-canvas`,panelTabs=`${id}-details`;
---
<section id={id} class="ds-view" data-ds-view data-ds-component={component.name} data-title={entry.title} data-group="Components" data-description={doc.purpose} hidden>
  <div class="ds-stage" data-ds-card>
    <div class="ds-stage-bar"><DSTabs id={previewTabs} labels={['Preview','Markup']} /><p class="ds-hint">Hover and click to try states</p></div>
    <div class="ds-canvas" id={`${previewTabs}-panel-0`} role="tabpanel" aria-labelledby={`${previewTabs}-tab-0`}><div class="ds-specimens"><DSPreview component={component} /></div></div>
    <div class="ds-markup" id={`${previewTabs}-panel-1`} role="tabpanel" aria-labelledby={`${previewTabs}-tab-1`} hidden><pre><code data-ds-markup>Generated from the rendered specimen.</code></pre></div>
  </div>
  <aside class="ds-panel"><DSTabs id={panelTabs} labels={['Specs','Rules']} />
    <div id={`${panelTabs}-panel-0`} role="tabpanel" aria-labelledby={`${panelTabs}-tab-0`}>
      <h3>Variants</h3><dl class="ds-key-values">{variants.filter(variant=>!hiddenVariantProps.includes(variant.code.split('=')[0])).map(variant=><div data-ds-variant={`${component.name}:${variant.code}`}><dt>{variant.name}</dt><dd>{variant.use}</dd></div>)}</dl>
      <h3>Sizes</h3><dl class="ds-key-values">{component.name==='Button'?buttonSizes.map(size=><div><dt>{size.name}</dt><dd><code>{size.value}</code> · {size.style}</dd></div>):sizes.filter(rule=>['min-height','font-size','border-radius'].includes(rule.property)).slice(0,4).map(rule=><div><dt>{rule.property.replaceAll('-',' ')}</dt><dd><code>{displayValue(rule.value)}</code></dd></div>)}</dl><details><summary>Source sizes & spacing</summary><dl class="ds-key-values">{sizes.map(rule=><div><dt>{rule.property}</dt><dd><code>{rule.value}</code></dd></div>)}</dl></details>
      <h3>Tokens</h3><DSTokens tokens={primaryTokens} /><details><summary>All component tokens</summary><DSTokens tokens={tokens.filter(token=>!primaryTokens.includes(token))} /></details>
      {component.name==='ProjectCard'&&<details><summary>Case-study transition</summary><DSTokens tokens={inventory.tokens.filter(token=>[...caseStudyMotionTokens,...caseStudyPresentationTokens].some(item=>item.name===`--${token.name}`))} register /></details>}
      <h3>Props</h3><div class="ds-props-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{props.map(prop=><tr data-ds-prop={prop.name}><th scope="row"><code>{prop.name}</code></th><td><code>{prop.type}</code></td><td><code>{prop.default}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
      <details><summary>Used prop values</summary><ul>{variants.filter(variant=>hiddenVariantProps.includes(variant.code.split('=')[0])).map(variant=><li data-ds-variant={`${component.name}:${variant.code}`}><code>{variant.code}</code></li>)}</ul></details><details><summary>Source & helpers</summary><p><code>{component.file}</code></p><p>{helpers.length?helpers.join(', '):'No composed Astro helpers.'}</p><ul>{[...new Set(component.usages.map(usage=>usage.file))].map(file=><li><code>{file}</code></li>)}</ul></details>
    </div>
    <div id={`${panelTabs}-panel-1`} role="tabpanel" aria-labelledby={`${panelTabs}-tab-1`} hidden><ul class="ds-rules"><li>{anatomyFor(component)}</li><li>{plainComponentNames(doc.useWhen)}</li><li>{plainComponentNames(doc.avoidWhen)}</li><li>{plainComponentNames(doc.accessibility)}</li></ul></div>
  </aside>
</section>
