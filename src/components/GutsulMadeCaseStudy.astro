---
import type { Project } from '../data/portfolio';
import { gutsulHero, gutsulRole, gutsulBranding, gutsulMain, gutsulCatalog, gutsulProduct, gutsulOther, gutsulResponsive, gutsulGuide } from '../data/gutsul-made-case-study';
import CaseStudyOverview from './CaseStudyOverview.astro';
import CaseStudyMedia from './CaseStudyMedia.astro';
import CaseStudyDecisionCard from './CaseStudyDecisionCard.astro';
import SvgAsset from './SvgAsset.astro';
interface Props { project: Project; }
const { project } = Astro.props;
const ornament = '/projects/gutsul-made-case-study/ornament-strip.svg';
---
<article class="case-study-content case-study-content--gutsul-made" data-case-content>
  <CaseStudyMedia {...gutsulHero} artwork />
  <div class="case-study-body case-study-narrative gutsul-case">
    <CaseStudyOverview project={project} titleId="gm-title">
      <Fragment slot="role"><p>Designer</p><ul>{gutsulRole.map(item => <li>{item}</li>)}</ul></Fragment>
    </CaseStudyOverview>

    <section class="gutsul-band gutsul-charcoal case-study-chapter--inverse" aria-labelledby="gm-branding">
      <div class="case-study-chapter__inner">
        <div class="case-study-columns gutsul-heading">
          <div><p class="case-study-eyebrow">Branding</p><h2 class="case-study-heading" id="gm-branding">{gutsulBranding.title}</h2></div>
          <p class="gutsul-muted">{gutsulBranding.description}</p>
        </div>
        <div class="gutsul-story gutsul-block">{gutsulBranding.steps.map(step => <figure class="gutsul-story-step">
          <div class:list={['gutsul-brand-tile', step.paper && 'gutsul-brand-tile--paper']}>
            {step.media.kind === 'vector' ? <SvgAsset src={step.media.src} role="img" aria-hidden="false" aria-label={step.media.alt} /> : <CaseStudyMedia {...step.media} presentation="bare" />}
          </div>
          <figcaption><h3>{step.title}</h3><p class="gutsul-muted">{step.description}</p></figcaption>
        </figure>)}</div>
      </div>
    </section>

    {([['main', 'Home', gutsulMain], ['catalog', 'Catalog', gutsulCatalog]] as const).map(([id, label, page]) => <section aria-labelledby={`gm-${id}`}>
      <div class="case-study-columns">
        <case-study-sticky class="case-study-sticky gutsul-copy">
          <div><p class="case-study-eyebrow">{label}</p><h2 class="case-study-heading" id={`gm-${id}`}>{page.title}</h2></div>
          <p class="gutsul-muted">{page.description}</p>
          <ul class="gutsul-diamonds">{page.facts.map(fact => <li><strong>{fact.label}</strong> {fact.text}</li>)}</ul>
        </case-study-sticky>
        <CaseStudyMedia {...page.media[0]} segments={page.media} />
      </div>
    </section>)}

    <section class="gutsul-band gutsul-red case-study-chapter--inverse" aria-labelledby="gm-product">
      <div class="gutsul-ornament" aria-hidden="true"><SvgAsset src={ornament} /></div>
      <div class="case-study-chapter__inner gutsul-band-inner">
        <div class="case-study-columns gutsul-heading">
          <div><p class="case-study-eyebrow">Product</p><h2 class="case-study-heading" id="gm-product">{gutsulProduct.title}</h2></div>
          <p>{gutsulProduct.description}</p>
        </div>
        <div class="gutsul-cutouts">{gutsulProduct.cutouts.map(media => <div style={`--gutsul-cutout-width:${media.width}px`}><CaseStudyMedia {...media} presentation="bare" /></div>)}</div>
        <div class="case-study-columns">
          <case-study-sticky class="case-study-sticky gutsul-copy"><h3 class="case-study-heading">{gutsulProduct.page.title}</h3><p class="gutsul-muted">{gutsulProduct.page.description}</p></case-study-sticky>
          <CaseStudyMedia {...gutsulProduct.page.media} />
        </div>
      </div>
      <div class="gutsul-ornament" aria-hidden="true"><SvgAsset src={ornament} /></div>
    </section>

    <section aria-labelledby="gm-pages">
      <p class="case-study-eyebrow">Inner pages</p><h2 class="case-study-heading" id="gm-pages">Cart, news and contacts</h2>
      <div class="case-study-media-grid gutsul-pages gutsul-block">{gutsulOther.map(page => <CaseStudyDecisionCard title={page.title} layout="figure">
        <CaseStudyMedia slot="media" {...page.media} presentation="bare" radius="small" /><p>{page.description}</p>
      </CaseStudyDecisionCard>)}</div>
    </section>

    <section class="gutsul-band gutsul-charcoal case-study-chapter--inverse" aria-labelledby="gm-responsive">
      <div class="gutsul-ornament" aria-hidden="true"><SvgAsset src={ornament} /></div>
      <div class="case-study-chapter__inner gutsul-band-inner">
        <div class="case-study-columns gutsul-heading">
          <div><p class="case-study-eyebrow">Responsive</p><h2 class="case-study-heading" id="gm-responsive">{gutsulResponsive.title}</h2></div>
          <p>{gutsulResponsive.description}</p>
        </div>
        <div class="gutsul-phones">{gutsulResponsive.media.map(phone => <CaseStudyMedia {...phone} />)}</div>
      </div>
      <div class="gutsul-ornament" aria-hidden="true"><SvgAsset src={ornament} /></div>
    </section>

    <section aria-labelledby="gm-style">
      <div class="case-study-columns gutsul-heading"><div><p class="case-study-eyebrow">Style guide</p><h2 class="case-study-heading" id="gm-style">{gutsulGuide.title}</h2></div><p class="gutsul-muted">{gutsulGuide.description}</p></div>
      <div class="gutsul-guide gutsul-block">
        <CaseStudyDecisionCard title={gutsulGuide.icons.title} layout="figure"><div slot="media" class="gutsul-plate gutsul-icons"><CaseStudyMedia {...gutsulGuide.icons.media} presentation="bare" /></div><p>{gutsulGuide.icons.description}</p></CaseStudyDecisionCard>
        <CaseStudyDecisionCard title={gutsulGuide.type.title} layout="figure"><div slot="media" class="gutsul-plate"><p class="gutsul-type" data-typography-exclusion="project-font-specimen">Open Sans<br /><span>Regular &amp; <b>Bold</b></span></p></div><p>{gutsulGuide.type.description}</p></CaseStudyDecisionCard>
        <CaseStudyDecisionCard title={gutsulGuide.colours.title} layout="figure"><div slot="media" class="gutsul-plate"><ul class="gutsul-palette" aria-label="Colour palette">{gutsulGuide.colours.values.map(colour => <li><span style={`--gutsul-swatch:${colour.value}`} aria-hidden="true" /><strong>{colour.label}</strong><code>{colour.value}</code></li>)}</ul></div><p>{gutsulGuide.colours.description}</p></CaseStudyDecisionCard>
      </div>
    </section>
  </div>
</article>
<script>
  import '../scripts/case-study/case-study-sticky';
</script>
