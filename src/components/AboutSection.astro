---
import { experience, cvUrl } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
import ExperienceList from './ExperienceList.astro';
import Button from './Button.astro';
import ToolsSection from './ToolsSection.astro';
---
<section id="about" class="about-details chapter" aria-labelledby="details-title">
  <div class="container">
    <SectionHeading id="details-title" label="03 / Experience"><Fragment slot="index"><Button href={cvUrl} variant="secondary" size="small" download>Download CV (PDF)</Button></Fragment>A decade of experience<p slot="description" class="section-description text-body-l">Every role taught me something different. All of it shows up in my work.</p></SectionHeading>
    <ExperienceList items={experience} />
    <ToolsSection />
  </div>
</section>
