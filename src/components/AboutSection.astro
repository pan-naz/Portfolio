---
import { experience, cvUrl } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
import ExperienceList from './ExperienceList.astro';
import Button from './Button.astro';
---
<section id="about" class="about-details chapter" aria-labelledby="details-title" tabindex="-1">
  <div class="container">
    <SectionHeading id="details-title" label="03 / Experience"><Fragment slot="index"><Button href={cvUrl} variant="secondary" size="small" download>Download CV (PDF)</Button></Fragment>10+ years of experience<p slot="description" class="section-description">Every role taught me something different. All of it shows up in my work.</p></SectionHeading>
    <ExperienceList items={experience} />
  </div>
</section>
