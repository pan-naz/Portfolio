---
import Button from './Button.astro';
import SkillMarquee from './SkillMarquee.astro';
import TypewriterHeading from './TypewriterHeading.astro';
import { profile, heroSubtitle } from '../data/portfolio';
---
<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="process-tags" aria-label="Design process">{['Workflows','Testing','Feedback'].map(label => <span class="process-tag text-label-s"><span>{label}</span></span>)}</div>
  <div class="container hero-content">
    <p class="hero-eyebrow">Hi, I'm Nazar</p>
    <TypewriterHeading />
    <p class="hero-description text-body-l">{heroSubtitle.start}<span class="accent-stat">{heroSubtitle.accent}</span>{heroSubtitle.end}</p>
    <div class="hero-cta-slot" data-hero-cta><div class="hero-cta-entrance"><Button href={`mailto:${profile.email}`} arrow="up">Get in touch</Button></div></div>
  </div>
  <SkillMarquee />
</section>
