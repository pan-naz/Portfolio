---
import Button from './Button.astro';
import SkillTag from './SkillTag.astro';
import SkillMarquee from './SkillMarquee.astro';
import TypewriterHeading from './TypewriterHeading.astro';
import { profile } from '../data/portfolio';
---
<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="process-tags" aria-label="Design process">{['Workflows','Testing','Feedback'].map((label,index) => <SkillTag label={label} index={index} variant="plain" />)}</div>
  <div class="container hero-content">
    <p class="hero-eyebrow">HI IM NAZAR</p>
    <TypewriterHeading />
    <p class="hero-description text-body-l">Successfully launched B2B products from <span class="accent-stat">0 → 1</span>, improved product adoption, and contributed to ARR growth. Passionate about solving complex problems.</p>
    <div class="hero-cta-slot" data-hero-cta><div class="hero-cta-entrance"><Button href={`mailto:${profile.email}`} arrow="up">Get in touch</Button></div></div>
  </div>
  <SkillMarquee />
</section>
