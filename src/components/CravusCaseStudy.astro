---
import type { Project } from '../data/portfolio';
import { cravusMedia as media, cravusRole, cravusTeam, cravusConcepts, cravusHomeSections, cravusPages, cravusPalette } from '../data/cravus-case-study';
import CaseStudyOverview from './CaseStudyOverview.astro';
import SectionHeading from './SectionHeading.astro';
import CaseStudyBand from './CaseStudyBand.astro';
import CaseStudyMedia from './CaseStudyMedia.astro';
import CaseStudyPalette from './CaseStudyPalette.astro';
import CaseStudySpecimen from './CaseStudySpecimen.astro';
import CaseStudySteps from './CaseStudySteps.astro';
import SvgAsset from './SvgAsset.astro';
interface Props { project: Project; }
const { project } = Astro.props;
---
<article class="case-study-content case-study-content--cravus" data-case-content>
  <CaseStudyMedia {...media.hero} radius="media" artwork />
  <div class="case-study-body case-study-narrative cravus-case">
    <CaseStudyOverview project={project} titleId="cv-title">
      <Fragment slot="role"><p>Designer</p><ul>{cravusRole.map(item => <li>{item}</li>)}</ul></Fragment>
      <p slot="secondary">{cravusTeam}</p>
    </CaseStudyOverview>

    <section aria-labelledby="cv-concept">
      <SectionHeading appearance="case" label="Concept" id="cv-concept">How Cravus works</SectionHeading>
      <div class="case-study-media-grid cravus-block">{cravusConcepts.map(([title, description]) => <div><h3>{title}</h3><p>{description}</p></div>)}</div>
      <div class="cravus-block"><CaseStudyMedia {...media.laptop} /></div>
    </section>

    <section aria-labelledby="cv-home">
      <div class="case-study-columns">
        <case-study-sticky class="case-study-sticky">
          <p class="case-study-eyebrow"><span class="cravus-number">01</span> / 09</p><h2 class="case-study-heading" id="cv-home">Main page</h2>
          <CaseStudySteps items={cravusHomeSections} class="cravus-home-steps" />
        </case-study-sticky>
        <CaseStudyMedia {...media.home} />
      </div>
    </section>

    <section aria-labelledby="cv-pages">
      <div class="case-study-columns cravus-chapter-heading">
        <div><SectionHeading appearance="case" label="02–09" id="cv-pages">Inner pages</SectionHeading></div>
        <p class="text-body-m cravus-muted">Besides the main page, the app has eight pages. Every page uses the same header, cards and footer.</p>
      </div>
      <div class="cravus-pages cravus-block">{cravusPages.map(page => <div class="case-study-columns">
        <case-study-sticky class="case-study-sticky cravus-page-copy">
          <p class="case-study-eyebrow"><span class="cravus-number">{page.number}</span> / 09</p>
          <h3 class="cravus-page-title">{page.title}</h3><p class="cravus-muted">{page.description}</p>
        </case-study-sticky>
        <div class="cravus-stack">{page.media.map(shot => <CaseStudyMedia {...shot} />)}</div>
      </div>)}</div>
    </section>

    <CaseStudyBand class="cravus-band cravus-mobile" labelledBy="cv-mobile">
        <div class="case-study-columns cravus-chapter-heading">
          <div><SectionHeading appearance="case" label="Mobile" id="cv-mobile">Phone layouts</SectionHeading><p class="cravus-breakpoint text-body-s">320px +</p></div>
          <p class="text-body-m cravus-muted">Every page has a phone layout. The menu folds into a button in the top-left corner, and cards and tables stack in one column.</p>
        </div>
        <div class="cravus-block"><CaseStudyMedia {...media.phones} /></div>
      </CaseStudyBand>

    <CaseStudyBand inverse class="cravus-style" labelledBy="cv-style">
        <SectionHeading appearance="case" label="Style guide" id="cv-style">Colour, type and UI elements</SectionHeading>
        <div class="cravus-block"><h3>Colour</h3><CaseStudyPalette items={cravusPalette} class="cravus-palette" swatchClass="cravus-swatch" swatchProperty="--cravus-swatch" /></div>
        <div class="cravus-block"><h3>Typography</h3>
          <div class="cravus-specimens">
            <CaseStudySpecimen class="cravus-brand-card" label="Titillium Web · 40px"><p class="cravus-titillium cravus-s40">What Are You <span>Craving?</span></p></CaseStudySpecimen>
            <CaseStudySpecimen class="cravus-brand-card" label="Titillium Web · 26px"><p class="cravus-titillium cravus-s26">Today’s Cultural Adventure</p></CaseStudySpecimen>
            <CaseStudySpecimen class="cravus-brand-card" label="Titillium Web · 18px"><p class="cravus-titillium cravus-s18">Delicious pork chops in secret Chinese sauce</p></CaseStudySpecimen>
            <CaseStudySpecimen class="cravus-brand-card" label="Titillium Web · 14px"><p class="cravus-titillium cravus-s14">Cravus is your way of experiencing home-style cuisines from all over the world without the plane ticket.</p></CaseStudySpecimen>
          </div>
        </div>
        <div class="cravus-assets cravus-block">
          <div><h3>Icons</h3><div class="cravus-assets-card"><SvgAsset src="/projects/cravus-case-study/icons.svg" aria-hidden="false" role="img" aria-label="Cravus icon set in orange and brown: heart with a fork, logo, dishes, cart, star, menu, mail, history, chef, calendar and a delivery car" /></div></div>
          <div><h3>Grid</h3><div class="cravus-assets-card cravus-grid-card"><CaseStudyMedia {...media.grid} radius="small" /><dl><div><dt>Container</dt><dd>1170px</dd></div><div><dt>Columns</dt><dd>12</dd></div><div><dt>Framework</dt><dd>Bootstrap</dd></div></dl></div></div>
        </div>
        <div class="cravus-block"><h3>UI elements</h3><div class="cravus-stack"><CaseStudyMedia {...media.ui} /></div></div>
      </CaseStudyBand>
  </div>
</article>
<script>
  import '../scripts/case-study-sticky';
</script>
