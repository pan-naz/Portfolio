---
import { projects, collectionProjects } from '../data/portfolio';
import CaseStudyContent from './CaseStudyContent.astro';
import '../styles/blaustrom-case-study.css';
import '../styles/voximplant-ivr-case-study.css';
import '../styles/gutsul-made-case-study.css';
import '../styles/cravus-case-study.css';
import '../styles/pet-care-case-study.css';
import '../styles/team-sternfit-case-study.css';
import '../styles/yellow-leaf-case-study.css';
import '../styles/promshyna-case-study.css';
import '../styles/recording-case-study.css';
import '../styles/peak-hotel-case-study.css';
import '../styles/telegram-file-picker-case-study.css';
import '../styles/hooko-case-study.css';
import '../styles/design-cup-case-study.css';
import '../styles/voximplant-case-study.css';
import '../styles/kitchen-chatbot-case-study.css';
import '../styles/index-law-firm-case-study.css';
import '../styles/square-case-study.css';
import '../styles/datagpt-case-study.css';
import '../styles/hooko-artwork.css';
---
<dialog class="case-study-dialog" data-case-dialog aria-label="Project case study" data-lenis-prevent>
  <div class="case-study-panel" data-case-panel><div class="case-study-scroll" data-case-scroll tabindex="-1" role="region" aria-label="Case study content"></div></div>
</dialog>
{[...projects, ...collectionProjects].map(project => <template data-case-template={project.id}><CaseStudyContent project={project} /></template>)}
