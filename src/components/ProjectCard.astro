---
import ResponsiveImage from './ResponsiveImage.astro';
import type { Project } from '../data/portfolio';
import Arrow from './Arrow.astro';
import ProjectIdentity from './ProjectIdentity.astro';
import ProjectTags from './ProjectTags.astro';
import HookoHero from './HookoHero.astro';
import { hookoHero } from '../data/hooko-case-study';
import { mediaCanvasStyle, mediaCrop } from '../scripts/media-canvas';
interface Props { project: Project; lead?: boolean; compact?: boolean; }
const { project, lead = false, compact = false } = Astro.props;
const caseUrl = `/case-studies/${project.id}/`;
const imageSrcSet = project.imageSrcSet ?? `${project.image.replace('.webp', '-800.webp')} 800w, ${project.image} 1800w`;
const imageSizes = compact ? '(max-width: 767px) calc(100vw - 48px), (max-width: 1328px) calc((100vw - 152px) / 2), 588px' : '(max-width: 767px) calc(100vw - 48px), (max-width: 1328px) calc(100vw - 128px), 1200px';
const imageWidth = project.imageWidth ?? 1200;
const mediaWidth = project.id === 'hooko' ? hookoHero.width : project.video?.width ?? imageWidth;
const mediaHeight = project.id === 'hooko' ? hookoHero.height : project.video?.height ?? project.imageHeight;
const imageStyle = [
  mediaCanvasStyle({ width: imageWidth, height: project.imageHeight, canvasColor: project.imageCanvasColor, canvasInset: project.imageCanvasInset, canvasFade: project.imageCanvasFade, canvasSourceRatio: project.imageCanvasSourceRatio }),
].filter(Boolean).join(';') || undefined;
const crop = mediaCrop({ width: mediaWidth, height: mediaHeight, cropPixels: project.video?.cropPixels });
const videoStyle = project.video ? [mediaCanvasStyle(project.video), crop.style].filter(Boolean).join(';') || undefined : undefined;
const canvasColor = project.video?.canvasColor ?? project.imageCanvasColor;
---
<article id={`project-${project.id}`} class:list={['project', { 'project--lead': lead, 'project--compact': compact }]} data-project-category={project.category} data-project-reveal={!compact || undefined} data-section-item={!compact || undefined}>
  <a class="project-surface" href={caseUrl} tabindex="0" data-case-link={project.id} aria-label={`View ${project.title} case study`}>
    <div class="project-caption">
      <div class="project-details"><h3 class="project-heading"><ProjectIdentity title={project.title} logo={project.logo} logoBackground={project.logoBackground} />{project.href && <Arrow direction="up" />}</h3><ProjectTags tags={project.tags} /></div>
      <div class="project-copy"><p class="project-outcome text-body-l">{project.outcome ?? project.description}</p>{project.outcome && <p class="project-description text-body-m">{project.description}</p>}</div>
    </div>
    <div class="project-media" style={`--media-ratio:${crop.width} / ${crop.height}${canvasColor ? `;background:${canvasColor}` : ''}`}>
      {project.id === 'hooko' ? <HookoHero preview /> : project.video ? <div class:list={['case-media-frame', project.video.cropPixels && 'media-crop']} style={project.video.cropPixels ? `--media-ratio:${crop.width} / ${crop.height}` : undefined}><video class:list={[project.video.canvasFade && 'media-canvas-fade', project.video.cropPixels && 'media-crop-content']} data-project-video muted loop playsinline preload="none" poster={project.video.poster ?? project.image} width={mediaWidth} height={mediaHeight} style={videoStyle} aria-hidden="true">
        <source data-src={project.video.src} type="video/mp4" />
        <img src={project.video.poster ?? project.image} alt="" width={mediaWidth} height={mediaHeight} loading="lazy" decoding="async" />
      </video></div> : project.imageReducedMotionSrc ? <picture><source media="(prefers-reduced-motion: reduce)" srcset={project.imageReducedMotionSrc} /><img class:list={[project.imageCanvasFade && 'media-canvas-fade']} src={project.image} srcset={imageSrcSet} sizes={imageSizes} alt={project.imageAlt} width={imageWidth} height={project.imageHeight} loading="lazy" decoding="async" style={imageStyle} /></picture> : <ResponsiveImage class:list={[project.imageCanvasFade && 'media-canvas-fade']} src={project.image} srcset={imageSrcSet} sizes={imageSizes} alt={project.imageAlt} width={imageWidth} height={project.imageHeight} loading="lazy" decoding="async" style={imageStyle} />}
    </div>
  </a>
</article>

<script>
  // Media startup must not depend on the homepage's animation libraries.
  import { initializeCaseStudyVideos } from '../scripts/case-study/case-study-videos';
  initializeCaseStudyVideos();
</script>
