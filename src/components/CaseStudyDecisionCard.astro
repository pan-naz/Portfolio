---
import SkillTag from './SkillTag.astro';
import '../styles/case-study-decision-card.css';
interface Props { title: string; titleHidden?: boolean; label?: string; labelVariant?: 'text' | 'accent'; layout?: 'stack' | 'media' | 'figure'; }
const { title, titleHidden = false, label, labelVariant = 'text', layout = 'stack' } = Astro.props;
---

<article class:list={['case-study-decision-card', layout === 'media' && 'case-study-decision-card--media', layout === 'figure' && 'case-study-decision-card--figure']}>
  {layout === 'figure' && Astro.slots.has('media') && <div class="case-study-decision-card__media"><slot name="media" /></div>}
  <div class="case-study-decision-card__text">
  <div class:list={['case-study-decision-card__header', titleHidden && 'sr-only']}>
    <div class="case-study-decision-card__heading">
      {label && <p class:list={['case-study-decision-card__label', labelVariant === 'text' && 'eyebrow']}>{labelVariant === 'accent' ? <SkillTag label={label} variant="accent" /> : label}</p>}
      <h3>{title}</h3>
    </div>
    {Astro.slots.has('icon') && <span class="case-study-decision-card__icon" aria-hidden="true"><slot name="icon" /></span>}
  </div>
  <div class:list={['case-study-decision-card__copy', titleHidden && 'case-study-decision-card__copy--without-heading']}><slot /></div>
  {Astro.slots.has('impact') && <div class="case-study-decision-card__impact">
    <h4>Impact:</h4>
    <slot name="impact" />
  </div>}
  </div>
  {layout !== 'figure' && Astro.slots.has('media') && <div class="case-study-decision-card__media"><slot name="media" /></div>}
</article>
