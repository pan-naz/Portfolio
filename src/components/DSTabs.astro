---
import Button from './Button.astro';
interface Props { id:string; labels:readonly string[]; }
const {id,labels}=Astro.props;
---
<div class="ds-tabs" role="tablist" aria-label={id.replaceAll('-',' ')} data-ds-tabset={id}>
  {labels.map((label,index)=><Button appearance="catalog" size="small" id={`${id}-tab-${index}`} role="tab" aria-selected={index===0?'true':'false'} aria-controls={`${id}-panel-${index}`} tabindex={index===0?0:-1} data-ds-tab={index}>{label}</Button>)}
</div>
