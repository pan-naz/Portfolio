---
interface Props { labelledBy: string; class?: string; inverse?: boolean; }
const { labelledBy, class: className, inverse = false } = Astro.props;
---
<section class:list={[inverse && 'case-study-chapter--inverse', className]} data-color-zone={inverse ? "dark" : undefined} data-zone-keep={inverse ? "surface section shadows" : undefined} aria-labelledby={labelledBy}><div class="case-study-chapter__inner"><slot /></div></section>
