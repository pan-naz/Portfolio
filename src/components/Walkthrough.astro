---
import Button from './Button.astro';
import IconButton from './IconButton.astro';
import Icon from './Icon.astro';
import DeferredVideo from './DeferredVideo.astro';
import type { WalkthroughCue } from '../scripts/walkthrough';
interface Props { src: string; poster: string; cues: WalkthroughCue[]; lengthSeconds?: number; }
const { src, poster, cues, lengthSeconds = 0 } = Astro.props;
---
<template data-walkthrough-template>
  <aside class="wt" data-walkthrough data-state="rest" aria-label="Case study walkthrough">
    <script is:inline type="application/json" data-walkthrough-config set:html={JSON.stringify({cues,lengthSeconds}).replaceAll('<','\\u003c')} />
    <div class="wt-stage">
      <div class="wt-circle">
        <button class="wt-face" type="button" tabindex="0" aria-pressed="false" aria-label="Sound off. Turn sound on" data-walkthrough-face>
          <DeferredVideo src={src} poster={poster} priority aria-hidden="true" />
          <span class="wt-pause-mark" aria-hidden="true"><span><Icon name="pause" /></span></span>
        </button>
        <IconButton variant="raised" size="small" class="wt-sound" label="Sound off. Turn sound on" data-walkthrough-sound aria-pressed="false">
          <span data-muted-icon><Icon name="volume-muted" /></span><span data-sound-icon hidden><Icon name="volume" /></span>
        </IconButton>
        <div class="wt-overlay" aria-hidden="true"><div class="wt-overlay-text"><p class="text-body-m-strong" data-walkthrough-chapter>{cues[0]?.name}</p><p class="wt-time text-label-s" data-walkthrough-time>0:00</p></div></div>
      </div>
      <div class="wt-surface wt-invite-b">
        <div><p class="text-body-s">Let me walk you through this case study.</p><p class="wt-card-label text-label-s">Walkthrough · <span data-walkthrough-length>{lengthSeconds ? `${Math.round(lengthSeconds / 60)} min` : ''}</span></p></div>
        <Button size="small" arrow="play" data-walkthrough-start>Start walkthrough</Button>
      </div>
      <div class="wt-pill floating-control-surface">
        <IconButton size="small" label="Pause" data-walkthrough-play>
          <span data-play-icon hidden><Icon name="play" /></span><span data-pause-icon><Icon name="pause" /></span>
        </IconButton>
        <IconButton size="small" label="Sound off. Turn sound on" data-walkthrough-sound aria-pressed="false">
          <span data-muted-icon><Icon name="volume-muted" /></span><span data-sound-icon hidden><Icon name="volume" /></span>
        </IconButton>
        <IconButton size="small" icon="close" label="Exit walkthrough" data-icon-hover="close" data-walkthrough-close />
      </div>
    </div>
  </aside>
</template>
<script>
  import { initializeWalkthrough } from '../scripts/walkthrough';
  document.querySelectorAll<HTMLTemplateElement>('[data-walkthrough-template]').forEach(initializeWalkthrough);
</script>

<style is:global>
@layer system {
.wt { --wt-edge: 2px; --wt-w: 152px; --wt-h: 228px; --wt-k: .3684; --wt-badge-k: 1.583; pointer-events: none; position: fixed; right: calc(var(--space-6) + var(--wt-edge) + var(--safe-right)); bottom: calc(var(--space-6) + var(--wt-edge) + var(--safe-bottom)); z-index: var(--layer-controls); display: flex; flex-direction: column; align-items: center; gap: var(--space-3); color: var(--color-text-primary); font-family: var(--font-body); }
.wt p { margin: 0; }
@media (hover: hover) and (pointer: fine) {
.wt:hover { pointer-events: auto; }

}
.wt > *, .wt-circle { pointer-events: auto; }
.wt > .wt-stage { position: relative; pointer-events: none; }
.wt-invite-b::after { content: ""; position: absolute; z-index: var(--layer-behind); left: 0; right: calc(var(--space-4) * -1); top: 50%; height: var(--wt-h); margin-top: calc(var(--wt-h) / -2); }
.wt-circle { position: relative; z-index: var(--layer-raised); width: var(--wt-w); height: var(--wt-h); border-radius: var(--radius-full); transform-origin: 100% 100%; transform: scale(var(--wt-k)); transition: transform var(--duration-button-fill) var(--ease-button-fill); }
.wt-face { width: 100%; height: 100%; padding: 0; border: 0; border-radius: inherit; background: var(--color-ink); cursor: pointer; display: block; box-shadow: 0 0 0 calc(var(--wt-edge) / var(--wt-k)) var(--color-bg-surface), var(--shadow-large); transition: box-shadow var(--duration-button-fill) var(--ease-button-fill); }
.wt-face { position: relative; }
.wt-face img, .wt-face video { width: 100%; height: 100%; border-radius: inherit; object-fit: cover; object-position: 45% 30%; display: block; pointer-events: none; }
.wt-sound { position: absolute; left: 85.36%; bottom: 0; margin-bottom: 14.64%; z-index: var(--layer-content); transform-origin: 50% 50%; transform: translate(-50%, 50%) scale(var(--wt-badge-k)); transition: transform var(--duration-button-fill) var(--ease-button-fill), opacity var(--duration-button-fill) var(--ease-button-fill); }
.wt-surface { position: relative; z-index: var(--layer-content); background: var(--color-bg-surface); box-shadow: var(--shadow-small); border-radius: var(--radius-medium); }
@media (hover: hover) and (pointer: fine) {
.wt[data-state="rest"]:not([data-quiet]):hover .wt-circle { transform: scale(1); }

}
.wt[data-state="rest"]:has(:focus-visible) .wt-circle, .wt:not([data-state="rest"]) .wt-circle { transform: scale(1); }
@media (hover: hover) and (pointer: fine) {
.wt[data-state="rest"]:not([data-quiet]):hover .wt-face { box-shadow: 0 0 0 var(--space-1) var(--color-bg-surface), var(--shadow-large); }

}
.wt[data-state="rest"]:has(:focus-visible) .wt-face, .wt:not([data-state="rest"]) .wt-face { box-shadow: 0 0 0 var(--space-1) var(--color-bg-surface), var(--shadow-large); }
@media (hover: hover) and (pointer: fine) {
.wt[data-state="rest"]:not([data-quiet]):hover .wt-sound { transform: translate(-50%, 50%) scale(1); }

}
.wt[data-state="rest"]:has(:focus-visible) .wt-sound, .wt:not([data-state="rest"]) .wt-sound { transform: translate(-50%, 50%) scale(1); }
.wt-pause-mark { position: absolute; inset: 0; z-index: var(--layer-content); display: grid; place-items: center; border-radius: inherit; background: color-mix(in srgb, var(--color-ink) 35%, transparent); color: var(--color-white); opacity: 0; pointer-events: none; transition: opacity var(--duration-tooltip-opacity) var(--ease-entrance); }
.wt-pause-mark > span { display: grid; place-items: center; width: 72px; height: 72px; border-radius: var(--radius-full); background: color-mix(in srgb, var(--color-ink) 55%, transparent); transform: scale(var(--scale-tooltip-start)); transition: transform var(--duration-tooltip-scale) var(--ease-entrance); }
.wt-pause-mark .icon { width: calc(var(--icon-size) * 1.5); height: calc(var(--icon-size) * 1.5); }
.wt[data-state="paused"] .wt-pause-mark { opacity: 1; }
.wt[data-state="paused"] .wt-pause-mark > span { transform: scale(1); }
.wt .wt-face video { object-position: 45% 25%; }
.wt-invite-b { display: flex; width: max-content; flex-direction: column; }
.wt-invite-b { gap: var(--space-4); padding: var(--space-4); }
.wt-invite-b > div { width: 0; min-width: 100%; }
.wt-card-label { color: var(--color-text-secondary); }
.wt-invite-b .button { align-self: flex-start; }
.wt-overlay { display: none; position: absolute; left: 0; right: 0; bottom: 0; padding: var(--space-8) var(--space-4) var(--space-4); border-radius: 0 0 var(--radius-full) var(--radius-full); background: linear-gradient(to top, color-mix(in srgb, var(--color-ink) 85%, transparent), transparent); color: var(--color-white); text-align: center; pointer-events: none; }
.wt-pill { display: none; align-items: center; gap: var(--space-1); padding: var(--space-1); border-radius: var(--radius-full); }
.wt .wt-overlay { display: block; opacity: 0; visibility: hidden; transition: opacity var(--duration-button-fill) var(--ease-button-fill), visibility calc(var(--duration-button-fill) * 0) var(--ease-button-fill) var(--duration-button-fill); }
.wt-overlay-text { transform: scale(.1); transition: transform var(--duration-button-fill) var(--ease-button-fill); }
.wt:not([data-state="rest"]) .wt-overlay { opacity: 1; visibility: visible; transition-delay: calc(var(--duration-button-fill) * 0); }
.wt:not([data-state="rest"]) .wt-overlay-text { transform: scale(1); }
.wt:not([data-state="rest"]) .wt-sound { opacity: 0; pointer-events: none; transform: translate(-50%, 50%) scale(.1); }
.wt-invite-b, .wt-pill { position: absolute; z-index: var(--layer-base); opacity: 0; visibility: hidden; pointer-events: none; transform-origin: 50% 50%;
  transition: opacity var(--duration-button-fill) var(--ease-button-fill), transform var(--duration-button-fill) var(--ease-button-fill), visibility calc(var(--duration-button-fill) * 0) var(--ease-button-fill) var(--duration-button-fill); }
.wt-invite-b { right: calc(100% + var(--space-4)); top: 0; bottom: 0; height: fit-content; margin-block: auto;
  transform: translate(calc(50% + var(--space-4) + var(--wt-w) * (1 - var(--wt-k) / 2)), calc(var(--wt-h) * (1 - var(--wt-k)) / 2)) scale(.1); }
.wt:not([data-state="rest"]) .wt-invite-b { transform: translate(calc(50% + var(--space-4) + var(--wt-w) / 2), 0) scale(.1); }
@media (hover: hover) and (pointer: fine) {
.wt[data-state="rest"]:not([data-quiet]):hover .wt-invite-b { opacity: 1; visibility: visible; pointer-events: auto; transform: translate(0, 0) scale(1); transition-delay: calc(var(--duration-button-fill) * 0); }

}
.wt[data-state="rest"]:has(:focus-visible) .wt-invite-b { opacity: 1; visibility: visible; pointer-events: auto; transform: translate(0, 0) scale(1); transition-delay: calc(var(--duration-button-fill) * 0); }
.wt .wt-pill { display: flex; bottom: calc(100% + var(--space-3)); left: 0; right: 0; width: fit-content; margin-inline: auto;
  transform: translate(calc(var(--wt-w) * (1 - var(--wt-k)) / 2), calc(50% + var(--space-3) + var(--wt-h) * (1 - var(--wt-k) / 2))) scale(.1); }
@media (hover: hover) and (pointer: fine) {
.wt[data-state="rest"]:not([data-quiet]):hover .wt-pill { transform: translate(0, calc(50% + var(--space-3) + var(--wt-h) / 2)) scale(.1); }

}
.wt[data-state="rest"]:has(:focus-visible) .wt-pill { transform: translate(0, calc(50% + var(--space-3) + var(--wt-h) / 2)) scale(.1); }
.wt:not([data-state="rest"]) .wt-pill { opacity: 1; visibility: visible; pointer-events: auto; transform: translate(0, 0) scale(1); transition-delay: calc(var(--duration-button-fill) * 0); }
@media (prefers-reduced-motion: reduce) { .wt-circle, .wt-face, .wt-sound, .wt-invite-b, .wt-pill, .wt-overlay, .wt-overlay-text { transition: none; } .wt * { animation: none !important; } }

.wt-time { color:var(--color-text-secondary); font-variant-numeric:tabular-nums; white-space:nowrap; }
.wt-overlay .wt-time { color:color-mix(in srgb,var(--color-white) 80%,transparent); }

}@media (prefers-reduced-motion: reduce) { .wt, .wt * { transition:none !important; animation:none !important; } }
</style>
