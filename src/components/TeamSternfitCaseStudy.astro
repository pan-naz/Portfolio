---
import AlignedChapterCopy from './AlignedChapterCopy.astro';
import SectionHeading from './SectionHeading.astro';
import type { Project } from '../data/portfolio';
import { sternfitHero, sternfitRole, sternfitTeam, sternfitSignature, sternfitFirstScreen, sternfitBrands, sternfitPhotos, sternfitMain, sternfitFlow, sternfitPhone, sternfitGuide } from '../data/team-sternfit-case-study';
import CaseStudyOverview from './CaseStudyOverview.astro';
import CaseStudyMedia from './CaseStudyMedia.astro';
import CaseStudyDecisionCard from './CaseStudyDecisionCard.astro';
import Icon from './Icon.astro';
interface Props { project: Project; }
const { project } = Astro.props;
---
<article class="case-study-content case-study-content--team-sternfit" data-case-content>
  <CaseStudyMedia {...sternfitHero} artwork />
  <div class="case-study-body case-study-narrative sternfit-case">
    <CaseStudyOverview project={project} titleId="ts-title">
      <Fragment slot="role"><p>Designer</p><ul>{sternfitRole.map(item => <li>{item}</li>)}</ul></Fragment>
      <Fragment slot="secondary"><p>{sternfitTeam}</p><div class="sternfit-signature"><CaseStudyMedia {...sternfitSignature} presentation="bare" /></div></Fragment>
    </CaseStudyOverview>

    <section class="sternfit-night case-study-chapter--inverse" data-color-zone="dark" data-zone-keep="surface section shadows" aria-labelledby="ts-brands">
      <div class="case-study-chapter__inner sternfit-band-inner">
        <div class="case-study-columns sternfit-row">
          <div class="sternfit-copy"><div><SectionHeading id="ts-brands" label="First screen" layout="stacked" reveal={false}>{sternfitFirstScreen.title}</SectionHeading></div><p class="sternfit-muted">{sternfitFirstScreen.description}</p></div>
          <CaseStudyMedia {...sternfitFirstScreen.media} presentation="shadow" radius="small" />
        </div>
        <div>
          {sternfitBrands.map((brand, index) => <div class="case-study-columns sternfit-row sternfit-brand" aria-labelledby={`ts-brand-${index}`}>
            <div class="sternfit-copy"><div><h3 class="sternfit-brand-name" id={`ts-brand-${index}`}>{brand.title}</h3><p class="sternfit-tagline text-body-l">{brand.line}</p></div><p class="sternfit-muted">{brand.description}</p></div>
            <div class="sternfit-pair"><CaseStudyMedia {...brand.media[0]} presentation="bare" /><Icon name="arrow" /><CaseStudyMedia {...brand.media[1]} presentation="bare" /></div>
          </div>)}
          <div class="case-study-columns sternfit-row sternfit-brand" aria-labelledby="ts-other-photos">
            <div class="sternfit-copy"><h3 class="sternfit-brand-name" id="ts-other-photos">{sternfitPhotos.title}</h3><p class="sternfit-muted">{sternfitPhotos.description}</p></div>
            <div class="sternfit-other-photos">{sternfitPhotos.media.map(photo => <CaseStudyMedia {...photo} presentation="bare" />)}</div>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="ts-main">
      <div class="case-study-columns sternfit-section-heading title-pair"><div><SectionHeading id="ts-main" label="Main page" layout="stacked" reveal={false}>{sternfitMain.title}</SectionHeading></div><AlignedChapterCopy><p class="sternfit-muted">{sternfitMain.description}</p></AlignedChapterCopy></div>
      <div class="sternfit-blocks">{sternfitMain.blocks.map((block, index) => <div class:list={['case-study-columns', 'sternfit-row', 'sternfit-story-row', index % 2 === 1 && 'sternfit-story-row--reverse']}>
        <div class="sternfit-copy"><blockquote class="sternfit-quote font-heading">“{block.quote}”</blockquote><p class="sternfit-muted">{block.description}</p></div>
        <div class="sternfit-shot"><CaseStudyMedia {...block.media} /></div>
      </div>)}</div>
    </section>

    <section aria-labelledby="ts-flow">
      <div class="case-study-columns sternfit-section-heading title-pair"><div><SectionHeading id="ts-flow" label="User flow" layout="stacked" reveal={false}>{sternfitFlow.title}</SectionHeading></div><AlignedChapterCopy><p class="sternfit-muted">{sternfitFlow.description}</p></AlignedChapterCopy></div>
      <CaseStudyMedia {...sternfitFlow.media} />
    </section>

    <section aria-labelledby="ts-phone">
      <div class="case-study-columns sternfit-row"><div class="sternfit-copy"><div><SectionHeading id="ts-phone" label="Responsive" layout="stacked" reveal={false}>{sternfitPhone.title}</SectionHeading></div><p class="sternfit-muted">{sternfitPhone.description}</p></div><CaseStudyMedia {...sternfitPhone.media} /></div>
    </section>

    <section aria-labelledby="ts-guide">
      <div class="case-study-columns sternfit-section-heading title-pair"><div><SectionHeading id="ts-guide" label="Style guide" layout="stacked" reveal={false}>{sternfitGuide.title}</SectionHeading></div><AlignedChapterCopy><p class="sternfit-muted">{sternfitGuide.description}</p></AlignedChapterCopy></div>
      <div class="case-study-media-grid sternfit-type-cards">{sternfitGuide.type.map(type => <CaseStudyDecisionCard title={type.title} layout="figure"><div slot="media" class="sternfit-type-plate"><CaseStudyMedia {...type.media} presentation="bare" /></div><p class="sternfit-muted">{type.description}</p></CaseStudyDecisionCard>)}</div>
      <div class="sternfit-colours"><h3>Colours</h3><ul class="sternfit-palette" aria-label="Colour palette">{sternfitGuide.colours.map(colour => <li><CaseStudyDecisionCard title={colour.label} layout="figure"><div slot="media" class="sternfit-swatch" style={`background:${colour.value}`} aria-hidden="true" /><p><code>{colour.value}</code></p><p>{colour.description}</p></CaseStudyDecisionCard></li>)}</ul></div>
    </section>
  </div>
</article>
