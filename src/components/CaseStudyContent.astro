---
import type { Project } from '../data/portfolio';
import VoximplantCaseStudy from './VoximplantCaseStudy.astro';
import DataGPTCaseStudy from './DataGPTCaseStudy.astro';
import HookoCaseStudy from './HookoCaseStudy.astro';
import PeakHotelCaseStudy from './PeakHotelCaseStudy.astro';
import YellowLeafCaseStudy from './YellowLeafCaseStudy.astro';
import IndexLawFirmCaseStudy from './IndexLawFirmCaseStudy.astro';
import BlaustromCaseStudy from './BlaustromCaseStudy.astro';
import CravusCaseStudy from './CravusCaseStudy.astro';
import PromShynaCaseStudy from './PromShynaCaseStudy.astro';
import GutsulMadeCaseStudy from './GutsulMadeCaseStudy.astro';
import TeamSternfitCaseStudy from './TeamSternfitCaseStudy.astro';
import PetCareCaseStudy from './PetCareCaseStudy.astro';
import SquareCaseStudy from './SquareCaseStudy.astro';
import KitchenChatbotCaseStudy from './KitchenChatbotCaseStudy.astro';
import TelegramFilePickerCaseStudy from './TelegramFilePickerCaseStudy.astro';
import DesignCupCaseStudy from './DesignCupCaseStudy.astro';
import VoximplantIvrCaseStudy from './VoximplantIvrCaseStudy.astro';
import RecordingCaseStudy from './RecordingCaseStudy.astro';
interface Props { project: Project; }
const { project } = Astro.props;
const caseStudies = {
  voximplant: VoximplantCaseStudy,
  datagpt: DataGPTCaseStudy,
  hooko: HookoCaseStudy,
  'peak-hotel': PeakHotelCaseStudy,
  'yellow-leaf': YellowLeafCaseStudy,
  'index-law-firm': IndexLawFirmCaseStudy,
  blaustrom: BlaustromCaseStudy,
  cravus: CravusCaseStudy,
  promshyna: PromShynaCaseStudy,
  'gutsul-made': GutsulMadeCaseStudy,
  'team-sternfit': TeamSternfitCaseStudy,
  'pet-care': PetCareCaseStudy,
  square: SquareCaseStudy,
  'kitchen-chatbot': KitchenChatbotCaseStudy,
  'telegram-file-picker': TelegramFilePickerCaseStudy,
  'design-cup': DesignCupCaseStudy,
  'voximplant-ivr': VoximplantIvrCaseStudy,
  'offf-conference': RecordingCaseStudy,
  'professions-in-digital': RecordingCaseStudy,
  'quit-university': RecordingCaseStudy,
};
const CaseStudy = caseStudies[project.id as keyof typeof caseStudies];
if (!CaseStudy) throw new Error(`Missing case study for ${project.id}`);
---
<CaseStudy project={project} />
