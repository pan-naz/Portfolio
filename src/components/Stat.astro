---
import type { ImpactMetric } from '../data/portfolio';
import MetricValue from './MetricValue.astro';
interface Props extends ImpactMetric {}
const { value, label, note } = Astro.props;
---
<div class="stat"><dt><MetricValue value={value} class="stat-value" /><span class="stat-label">{label}</span></dt><dd>{note}</dd></div>
