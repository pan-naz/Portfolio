---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  poster?: string;
  kind?: 'image' | 'video';
  presentation?: 'framed' | 'bare';
}

const { src, alt, width, height, poster, kind = 'video', presentation = 'framed' } = Astro.props;
---
<figure class:list={['case-study-media', presentation === 'bare' && 'case-study-media--bare']}>
  {kind === 'image' ? <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" /> : <video data-case-video muted loop playsinline preload="none" poster={poster} width={width} height={height} aria-label={alt}>
    <source data-src={src} type="video/mp4" />
    <img src={poster} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </video>}
</figure>
