---
import IconButton from './IconButton.astro';
import Icon from './Icon.astro';
import '../styles/case-video-player.css';
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  poster?: string;
  kind?: 'image' | 'video';
  reducedMotionSrc?: string;
  artwork?: boolean;
  presentation?: 'framed' | 'bare' | 'shadow' | 'floating';
  strokeWidth?: 4 | 8;
  strokePlacement?: 'center' | 'outside';
  radius?: 'medium' | 'small' | 'media';
  controls?: boolean;
  canvasColor?: string;
  showTime?: boolean;
  preview?: { src: string; columns: number; rows: number; count: number; interval: number; width: number; height: number; displayWidth?: number };
  segments?: readonly { src: string; alt: string; width: number; height: number; poster?: string; kind?: 'image' | 'video' }[];
}

const { src, alt, width, height, poster, kind = 'video', reducedMotionSrc, artwork = false, presentation: requestedPresentation = 'framed', strokeWidth = 4, strokePlacement = 'center', radius = 'medium', controls = false, canvasColor, showTime = true, preview, segments } = Astro.props;
const player = !segments?.length && kind === 'video' && controls;
const MediaRoot = player ? 'case-video-player' : 'figure';
// Heroes share the card/transition frame. Content-media presets must not add
// another stroke, shadow or margin when their asset is reused as a hero.
const presentation = artwork ? 'framed' : requestedPresentation;
const floating = !artwork && (presentation === 'floating' || player);
const mediaRadius = artwork ? 'media' : radius;
---
<MediaRoot class:list={['case-study-media', artwork && 'case-study-artwork', canvasColor && 'case-study-media--canvas', presentation === 'bare' && 'case-study-media--bare', presentation === 'shadow' && 'case-study-media--shadow', floating && 'case-study-media--floating', floating && strokeWidth === 8 && 'case-study-media--wide-stroke', floating && strokePlacement === 'outside' && 'case-study-media--outside-stroke', player && 'case-video-player']} style={`--case-media-radius:var(--radius-${mediaRadius})${canvasColor ? `;--media-ratio:${width} / ${height};--media-canvas:${canvasColor}` : ''}`} data-preview={player && preview ? JSON.stringify(preview) : undefined}>
  {segments?.length ? <div class="case-study-media__sequence">{segments.map(segment => <Astro.self {...segment} presentation="bare" />)}</div> : kind === 'image' ? reducedMotionSrc ? <picture><source media="(prefers-reduced-motion: reduce)" srcset={reducedMotionSrc} /><img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" /></picture> : <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" /> : <video data-case-video muted loop playsinline preload="none" poster={poster} width={width} height={height} controls={player} aria-label={alt}>
    <source data-src={src} type="video/mp4" />
    {poster && <img src={poster} alt={alt} width={width} height={height} loading="lazy" decoding="async" />}
  </video>}
  {player && <div class="case-video-controls" data-theme="dark" data-video-controls role="group" aria-label="Video controls" hidden>
    <IconButton label="Play video" data-video-toggle>
      <span data-play-icon><Icon name="play" /></span>
      <span data-pause-icon hidden><Icon name="pause" /></span>
    </IconButton>
    <div class="case-video-seek">
      <input data-video-seek type="range" min="0" max="100" value="0" step="0.1" aria-label="Video position" disabled />
      {preview && <div class="case-video-preview" style={preview.displayWidth ? `--video-preview-width:${preview.displayWidth}px` : undefined} data-video-preview aria-hidden="true" hidden>
        <div class="case-video-preview-frame" style={`aspect-ratio: ${preview.width} / ${preview.height}`} />
        <span data-preview-time>0:00</span>
      </div>}
    </div>
    {showTime && <span class="case-video-time" aria-hidden="true"><span data-video-time>0:00 / 0:00</span></span>}
  </div>}
</MediaRoot>

<script>
  import '../scripts/case-video-player';
</script>
