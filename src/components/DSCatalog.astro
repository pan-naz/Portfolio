---
import { statePreviewStyles } from '../data/system-preview-styles';
import DSFoundations from './DSFoundations.astro';
import DSComponent from './DSComponent.astro';
import DSGuidelines from './DSGuidelines.astro';
import DSPatterns from './DSPatterns.astro';
import TextLink from './TextLink.astro';
import { buildSystemInventory } from '../data/system-inventory';
const inventory = buildSystemInventory();
---
<main id="main" class="ds-main" tabindex="-1">
  <section id="overview" class="ds-section" aria-labelledby="overview-title">
    <header class="ds-heading"><h1 id="overview-title" class="text-heading-l">Design system</h1><p>The components and tokens used by this portfolio, with examples and guidance for using them.</p></header>
    <h2>Principles</h2><ul class="ds-principles"><li>Use the existing component for its intended role.</li><li>Keep names and values aligned with the website.</li><li>Preserve reading order, keyboard access and reduced motion.</li></ul>
    <h2>Token tiers</h2><p>Primitives hold base values. Semantic tokens assign a role. Component tokens define a specific part of the interface.</p>
    <p>Case studies have a separate project layer for their own colours, images and fonts. Those values are kept out of this system.</p>
  </section>
  <DSFoundations inventory={inventory} />
  {inventory.components.map(component => <DSComponent component={component} inventory={inventory} />)}
  <DSPatterns inventory={inventory} />
  <DSGuidelines />
  <footer class="ds-footer"><TextLink href="/" compact>Back to portfolio</TextLink></footer>
</main>

<style is:global set:html={statePreviewStyles()} />
