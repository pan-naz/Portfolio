---
import DSButtons from './DSButtons.astro';import DSDashboard from './DSDashboard.astro';import DSFoundations from './DSFoundations.astro';import DSComponent from './DSComponent.astro';
import ThemeToggle from './ThemeToggle.astro';import {visibleComponents} from '../data/ds-components';import {buildSystemInventory} from '../data/system-inventory';import {dashboardDescription} from '../data/design-system';
import '../styles/case-study-narrative.css';
const inventory=buildSystemInventory();
---
<main id="main" class="ds-main" tabindex="-1">
 <header class="ds-item-header"><div><p class="ds-breadcrumb" data-ds-breadcrumb hidden><a tabindex="0" href="/design-system/" data-ds-dashboard-link>Design system</a><span aria-hidden="true"> / </span><span data-ds-group></span></p><h1 class="text-heading-l" data-ds-title>Design system</h1><p class="ds-item-description" data-ds-description>{dashboardDescription}</p></div><ThemeToggle appearance="segmented"/></header>
 <DSDashboard inventory={inventory}/><DSFoundations inventory={inventory}/>
 {visibleComponents.map(entry=>entry.name==='Button'?<DSButtons components={['Button','IconButton','TextLink'].map(name=>inventory.components.find(component=>component.name===name)!)}/>:<DSComponent component={inventory.components.find(component=>component.file===entry.file)!} inventory={inventory}/>)}
</main>
