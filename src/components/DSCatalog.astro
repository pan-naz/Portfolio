---
import DSFoundations from './DSFoundations.astro';
import DSComponent from './DSComponent.astro';
import ThemeToggle from './ThemeToggle.astro';
import {visibleComponents} from '../data/ds-components';
import {buildSystemInventory} from '../data/system-inventory';
const inventory=buildSystemInventory();
---
<main id="main" class="ds-main" tabindex="-1">
  <header class="ds-item-header"><div><p class="ds-group-label" data-ds-group>Foundations</p><h1 class="text-heading-l" data-ds-title>Color</h1><p class="ds-item-description" data-ds-description>Choose a role, then let the theme choose its value.</p></div><ThemeToggle appearance="segmented" /></header>
  <DSFoundations inventory={inventory} />
  {visibleComponents.map(entry=><DSComponent component={inventory.components.find(component=>component.file===entry.file)!} inventory={inventory} />)}
</main>
