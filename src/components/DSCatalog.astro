---
import DSTimeline from './DSTimeline.astro';import DSStatistics from './DSStatistics.astro';import DSSectionHeadings from './DSSectionHeadings.astro';import DSProjectCards from './DSProjectCards.astro';import DSNavigationExamples from './DSNavigationExamples.astro';import DSChips from './DSChips.astro';import DSButtons from './DSButtons.astro';import DSDashboard from './DSDashboard.astro';import DSFoundations from './DSFoundations.astro';import DSToolCards from './DSToolCards.astro';
import ThemeToggle from './ThemeToggle.astro';import {visibleComponents} from '../data/ds-components';import {buildSystemInventory} from '../data/system-inventory';import {dashboardDescription} from '../data/design-system';
import '../styles/case-study-narrative.css';
const inventory=buildSystemInventory();
---
<main id="main" class="ds-main" tabindex="-1">
 <header class="ds-item-header"><div><p class="ds-breadcrumb" data-ds-breadcrumb hidden><a tabindex="0" href="/design-system/" data-ds-dashboard-link>Design system</a><span aria-hidden="true"> / </span><span data-ds-group></span></p><h1 class="text-heading-l" data-ds-title>Design system</h1><p class="ds-item-description" data-ds-description>{dashboardDescription}</p></div><ThemeToggle appearance="segmented"/></header>
 <DSDashboard/><DSFoundations inventory={inventory}/>
 {visibleComponents.map(entry=>entry.name==='Button'?<DSButtons components={['Button','IconButton','TextLink'].map(name=>inventory.components.find(component=>component.name===name)!)}/>:entry.name==='Chip'?<DSChips component={inventory.components.find(component=>component.name==='Chip')!}/>:entry.name==='ProjectCard'?<DSProjectCards components={['ProjectCard','ProjectIdentity','ProjectTags'].map(name=>inventory.components.find(component=>component.name===name)!)}/>:entry.name==='TimelineRow'?<DSTimeline components={['TimelineRow','ExperienceList'].map(name=>inventory.components.find(component=>component.name===name)!)}/>:entry.name==='Stat'?<DSStatistics components={['Stat','MetricValue'].map(name=>inventory.components.find(component=>component.name===name)!)}/>:entry.name==='SectionHeading'?<DSSectionHeadings component={inventory.components.find(component=>component.name==='SectionHeading')!}/>:entry.name==='NavigationItem'?<DSNavigationExamples components={['NavigationItem','SectionNavigation','LogoLink'].map(name=>inventory.components.find(component=>component.name===name)!)}/>:<DSToolCards components={['ToolCard','Tooltip'].map(name=>inventory.components.find(component=>component.name===name)!)}/>)}
</main>
