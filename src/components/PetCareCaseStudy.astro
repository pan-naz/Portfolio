---
import type { Project } from '../data/portfolio';
import { petCareHero, petCareAnimation, petCareRole, petCareCompetition, petCareResearch, petCarePrototype, petCareMain, petCarePhysical, petCareEmotional, petCareNeeds, petCareGuide } from '../data/pet-care-case-study';
import CaseStudyOverview from './CaseStudyOverview.astro';
import CaseStudyMedia from './CaseStudyMedia.astro';
import CaseStudyDecisionCard from './CaseStudyDecisionCard.astro';
import MetricValue from './MetricValue.astro';
import ProjectIdentity from './ProjectIdentity.astro';
import Icon from './Icon.astro';
import Chip from './Chip.astro';
import { petCarePrizeIcons } from '../data/pet-care-prize-icons';
interface Props { project: Project; }
const { project } = Astro.props;
---
<article class="case-study-content case-study-content--pet-care" data-case-content>
  <CaseStudyMedia {...petCareHero} artwork />
  <div class="case-study-body case-study-narrative">
    <CaseStudyOverview project={project} titleId="pc-title">
      <Fragment slot="role"><p>Designer</p><ul>{petCareRole.map(item => <li>{item}</li>)}</ul></Fragment>
    </CaseStudyOverview>

    <section class="case-study-chapter--inverse pc-pink" data-color-zone="dark" data-color-surface="page" data-color-section="page" data-shadow-theme="page" aria-labelledby="pc-competition">
      <div class="case-study-chapter__inner pc-band-inner">
        <div class="case-study-columns pc-heading"><div><p class="case-study-eyebrow">{petCareCompetition.eyebrow}</p><h2 class="case-study-heading" id="pc-competition">{petCareCompetition.title}</h2></div><p class="pc-muted">{petCareCompetition.description}</p></div>
        <div class="pc-competition-cards">
          <ul class="pc-stats" aria-label="Competition in numbers">{petCareCompetition.stats.map(stat => <li>
            <CaseStudyDecisionCard title={stat.label} layout="figure">
              <p class="pc-stat-value"><MetricValue value={stat.value} class="text-heading-l" />{stat.unit && <> <span class="text-body-m-strong">{stat.unit}</span></>}</p>
              <p class="text-body-s pc-muted">{stat.note}</p>
            </CaseStudyDecisionCard>
          </li>)}</ul>
          <CaseStudyDecisionCard title="Competition prizes" titleHidden layout="figure">
            <ol class="pc-prizes" role="list" aria-label="Competition prizes">{petCareCompetition.prizes.map(prize => <li class:list={['pc-prize', prize.won && 'pc-prize--won']}>
              <span class="pc-prize-icon"><Icon nodes={petCarePrizeIcons[prize.icon]} size={32} /></span>
              <div class="pc-prize-copy">
                <div class="pc-prize-place"><p class="text-body-s">{prize.place}</p>{prize.won && <Chip label="I won" variant="accent" />}</div>
                <h4>{prize.title}</h4>
              </div>
            </li>)}</ol>
          </CaseStudyDecisionCard>
        </div>
      </div>
    </section>

    <section aria-labelledby="pc-research">
      <div class="case-study-columns pc-heading"><div><p class="case-study-eyebrow">{petCareResearch.eyebrow}</p><h2 class="case-study-heading" id="pc-research">{petCareResearch.title}</h2></div><p class="pc-muted">{petCareResearch.description}</p></div>
      <div class="pc-research-cards">{petCareResearch.cards.map(card => <CaseStudyDecisionCard title={card.title} layout="figure"><ul class="pc-muted">{card.items.map(item => <li>{item}</li>)}</ul>{card.note && <p>{card.note}</p>}</CaseStudyDecisionCard>)}</div>
    </section>

    <section aria-labelledby="pc-prototype">
      <div class="case-study-columns pc-heading"><div><p class="case-study-eyebrow">{petCarePrototype.eyebrow}</p><h2 class="case-study-heading" id="pc-prototype">{petCarePrototype.title}</h2></div><p class="pc-muted">{petCarePrototype.description}</p></div>
      <div class="pc-wireframes"><CaseStudyMedia {...petCarePrototype.media} /></div>
    </section>

    <section aria-labelledby="pc-main">
      <div class="case-study-columns pc-row">
        <div class="pc-copy"><div><p class="case-study-eyebrow">{petCareMain.eyebrow}</p><h2 class="case-study-heading" id="pc-main">{petCareMain.title}</h2></div><ul class="pc-points">{petCareMain.points.map(point => <li><h3>{point.title}</h3><p class="pc-muted">{point.description}</p></li>)}</ul></div>
        <div class="pc-main-preview"><CaseStudyMedia {...petCareMain.media} /></div>
      </div>
    </section>

    <section class="case-study-chapter--inverse pc-coral" data-color-zone="dark" data-color-surface="page" data-color-section="page" data-shadow-theme="page" aria-labelledby="pc-physical">
      <div class="case-study-chapter__inner pc-band-inner">
        <div class="case-study-columns pc-row"><div class="pc-copy"><div><p class="case-study-eyebrow">{petCarePhysical.eyebrow}</p><h2 class="case-study-heading" id="pc-physical">{petCarePhysical.title}</h2></div>{petCarePhysical.paragraphs.map(text => <p class="pc-muted">{text}</p>)}</div><div class="pc-phone pc-phone--physical"><CaseStudyMedia {...petCarePhysical.media} /></div></div>
        <CaseStudyMedia {...petCarePhysical.cards} />
      </div>
    </section>

    <section class="case-study-chapter--inverse pc-cream" data-color-zone="dark" data-color-surface="page" data-color-section="page" data-shadow-theme="page" aria-label="Emotional state and the pet's needs">
      <div class="case-study-chapter__inner pc-band-inner">
        <div class="case-study-columns pc-row" aria-labelledby="pc-emotional"><div class="pc-copy"><div><p class="case-study-eyebrow">{petCareEmotional.eyebrow}</p><h2 class="case-study-heading" id="pc-emotional">{petCareEmotional.title}</h2></div>{petCareEmotional.paragraphs.map(text => <p class="pc-muted">{text}</p>)}</div><div class="pc-phone pc-phone--emotional"><CaseStudyMedia {...petCareEmotional.media} /></div></div>
        <div class="case-study-columns pc-row pc-row--reverse" aria-labelledby="pc-needs"><div class="pc-copy"><div><p class="case-study-eyebrow">{petCareNeeds.eyebrow}</p><h2 class="case-study-heading" id="pc-needs">{petCareNeeds.title}</h2></div>{petCareNeeds.paragraphs.map(text => <p class="pc-muted">{text}</p>)}</div><div class="pc-phone pc-phone--needs"><CaseStudyMedia {...petCareNeeds.media} /></div></div>
      </div>
    </section>

    <section aria-labelledby="pc-guide">
      <div class="case-study-columns pc-heading"><div><p class="case-study-eyebrow">{petCareGuide.eyebrow}</p><h2 class="case-study-heading" id="pc-guide">{petCareGuide.title}</h2></div><p class="pc-muted">{petCareGuide.description}</p></div>
      <div class="pc-guide">
        <div><h3>Colours</h3><ul class="pc-palette" aria-label="Colour palette">{petCareGuide.colours.map(colour => <li><CaseStudyDecisionCard title={colour.label} layout="figure"><div slot="media" class="pc-swatch" style={`background:${colour.value}`} aria-hidden="true" /><p class="text-body-s"><code>{colour.value}</code></p><p class="pc-muted">{colour.description}</p></CaseStudyDecisionCard></li>)}</ul></div>
        <div class="case-study-media-grid pc-type-cards">
          <CaseStudyDecisionCard title={petCareGuide.brand.title} layout="figure"><div slot="media" class="pc-type-plate pc-brand"><ProjectIdentity title={project.title} logo={project.logo} logoBackground={project.logoBackground} /></div><p class="pc-muted">{petCareGuide.brand.description}</p></CaseStudyDecisionCard>
          {petCareGuide.type.map(type => <CaseStudyDecisionCard title={type.title} layout="figure"><div slot="media" class="pc-type-plate"><CaseStudyMedia {...type.media} /></div><p class="pc-muted">{type.description}</p></CaseStudyDecisionCard>)}
        </div>
      </div>
    </section>

    <section class="pc-animation" id="pc-animation" aria-label="Pet Care app animation">
      <CaseStudyMedia {...petCareAnimation} radius="large" />
    </section>
  </div>
</article>
