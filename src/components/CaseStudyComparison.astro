---
import ResponsiveImage from './ResponsiveImage.astro';
import Button from './Button.astro';
interface ComparisonImage { src: string; alt: string; width: number; height: number; }
interface Props { before: ComparisonImage; after: ComparisonImage; label: string; }
const { before, after, label } = Astro.props;
---
<case-study-comparison class="case-comparison">
  <div class="case-comparison-controls" role="group" aria-label={label}>
    <Button size="small" appearance="comparison" variant="secondary" data-comparison-choice="before" aria-pressed="false">Before</Button>
    <Button size="small" appearance="comparison" variant="primary" data-comparison-choice="after" aria-pressed="true">After</Button>
  </div>
  <div class="case-comparison-images">
    <ResponsiveImage {...before} data-comparison-image="before" aria-hidden="true" loading="lazy" decoding="async" />
    <ResponsiveImage {...after} data-comparison-image="after" data-active aria-hidden="false" loading="lazy" decoding="async" />
  </div>
  <span class="sr-only" aria-live="polite" data-comparison-status>Showing After</span>
</case-study-comparison>

<style>
@layer system, project;
@layer system {
  .case-comparison { display: block; }
  .case-comparison-controls { display: flex; justify-content: center; gap: var(--space-1); width: fit-content; margin: 0 auto var(--space-4); padding: var(--space-1); border-radius: var(--radius-pill); background: var(--color-bg-surface); box-shadow: var(--shadow-floating); }
  .case-comparison-images { display: grid; align-items: start; filter: drop-shadow(var(--shadow-overlay)); }
  .case-comparison-images img { grid-area: 1 / 1; display: block; width: 100%; height: auto; border-radius: var(--radius-medium); opacity: 0; transition: opacity var(--duration-fast) ease-in-out; }
  .case-comparison-images img[data-active] { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .case-comparison-images img { transition: none; } }

}
</style>

<script>
  class CaseStudyComparison extends HTMLElement {
    private controller?: AbortController;
    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      this.addEventListener('click', event => {
        const choice = (event.target as Element).closest<HTMLButtonElement>('[data-comparison-choice]');
        if (!choice || !this.contains(choice)) return;
        const selected = choice.dataset.comparisonChoice;
        if (choice.getAttribute('aria-pressed') === 'true') return;
        this.querySelectorAll<HTMLButtonElement>('[data-comparison-choice]').forEach(button => {
          const active = button === choice;
          button.setAttribute('aria-pressed', String(active));
          button.classList.toggle('button--primary', active);
          button.classList.toggle('button--secondary', !active);
        });
        this.querySelectorAll<HTMLImageElement>('[data-comparison-image]').forEach(image => {
          const active = image.dataset.comparisonImage === selected;
          image.toggleAttribute('data-active', active);
          image.setAttribute('aria-hidden', String(!active));
        });
        this.querySelector('[data-comparison-status]')!.textContent = `Showing ${choice.textContent?.trim()}`;
      }, { signal: this.controller.signal });
    }
    disconnectedCallback() { this.controller?.abort(); }
  }
  if (!customElements.get('case-study-comparison')) customElements.define('case-study-comparison', CaseStudyComparison);
</script>
