---
import Button from './Button.astro';
interface ComparisonImage { src: string; alt: string; width: number; height: number; }
interface Props { before: ComparisonImage; after: ComparisonImage; label: string; }
const { before, after, label } = Astro.props;
---
<case-study-comparison class="case-comparison">
  <div class="case-comparison-controls" role="group" aria-label={label}>
    <Button size="small" variant="secondary" data-comparison-choice="before" aria-pressed="false">Before</Button>
    <Button size="small" variant="primary" data-comparison-choice="after" aria-pressed="true">After</Button>
  </div>
  <div class="case-comparison-images">
    <img {...before} data-comparison-image="before" hidden loading="lazy" decoding="async" />
    <img {...after} data-comparison-image="after" loading="lazy" decoding="async" />
  </div>
  <span class="sr-only" aria-live="polite" data-comparison-status>Showing After</span>
</case-study-comparison>

<style>
  .case-comparison { display: block; }
  .case-comparison-controls { display: flex; justify-content: center; gap: var(--space-1); width: fit-content; margin: 0 auto var(--space-4); padding: var(--space-1); border-radius: var(--radius-pill); background: var(--surface); box-shadow: var(--shadow-floating); }
  .case-comparison-controls :global(.button--secondary) { border-color: transparent; }
  .case-comparison-controls :global(.button--secondary:not(:disabled):is(:hover, :focus-visible)) { color: var(--ink); background: var(--surface-subtle); }
  .case-comparison-images { display: grid; aspect-ratio: 1200 / 775; align-items: start; }
  .case-comparison-images img { grid-area: 1 / 1; display: block; width: 100%; height: auto; border-radius: var(--radius-medium); }
  .case-comparison-images img[hidden] { display: none; }
</style>

<script>
  class CaseStudyComparison extends HTMLElement {
    private controller?: AbortController;
    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      this.addEventListener('click', event => {
        const choice = (event.target as Element).closest<HTMLButtonElement>('[data-comparison-choice]');
        if (!choice || !this.contains(choice)) return;
        const selected = choice.dataset.comparisonChoice;
        this.querySelectorAll<HTMLButtonElement>('[data-comparison-choice]').forEach(button => {
          const active = button === choice;
          button.setAttribute('aria-pressed', String(active));
          button.classList.toggle('button--primary', active);
          button.classList.toggle('button--secondary', !active);
        });
        this.querySelectorAll<HTMLImageElement>('[data-comparison-image]').forEach(image => {
          image.hidden = image.dataset.comparisonImage !== selected;
        });
        this.querySelector('[data-comparison-status]')!.textContent = `Showing ${choice.textContent?.trim()}`;
      }, { signal: this.controller.signal });
    }
    disconnectedCallback() { this.controller?.abort(); }
  }
  if (!customElements.get('case-study-comparison')) customElements.define('case-study-comparison', CaseStudyComparison);
</script>
