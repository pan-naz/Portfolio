---
import '../styles/case-video-player.css';
import type {SourceComponent} from '../data/system-inventory';
import DSControl from './DSControl.astro';

import ToolCard from './ToolCard.astro';
import {tools} from '../data/portfolio';
interface Props {component:SourceComponent;}
const {component}=Astro.props,name=component.name;
---
{name==='Tooltip'&&<div class="ds-specimen-composition ds-tooltip-composition">
 <div class="ds-inline-controls">{['Hidden','Visible above','Flipped below','Keyboard focus'].map((state,index)=><DSControl data-ds-tooltip-state={['hidden','above','below','focus'][index]} aria-pressed={index===0?'true':'false'}>{state}</DSControl>)}</div>
 <div class="ds-labelled-specimen"><span>{tools[0].name}</span><div class="about-details ds-context-about ds-tooltip-tool" data-color-zone="dark" data-zone-keep="section large-shadow" data-ds-example="tooltip-tool" data-ds-target=".tool-card"><ToolCard tool={tools[0]} tooltipId="example-tool-tooltip" /></div></div>
</div>}
