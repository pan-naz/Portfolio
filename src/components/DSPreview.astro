---
import type { SourceComponent } from '../data/system-inventory';
import Button from './Button.astro';
import TextLink from './TextLink.astro';
import IconButton from './IconButton.astro';
import NavigationItem from './NavigationItem.astro';
import Chip from './Chip.astro';
import Icon from './Icon.astro';

import Stat from './Stat.astro';
import TimelineRow from './TimelineRow.astro';
import ProjectIdentity from './ProjectIdentity.astro';
import ProjectTags from './ProjectTags.astro';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';
import SectionNavigation from './SectionNavigation.astro';
import ToolCard from './ToolCard.astro';
import CaseStudyMedia from './CaseStudyMedia.astro';
import CaseStudyComparison from './CaseStudyComparison.astro';
import CaseStudyDecisionCard from './CaseStudyDecisionCard.astro';
import CaseStudySteps from './CaseStudySteps.astro';
import { projects, collectionProjects, impactGroups, experience, tools } from '../data/portfolio';
import { dataGPTMedia } from '../data/datagpt-case-study';
import { peakHotelHomeSections } from '../data/peak-hotel-case-study';
interface Props { component: SourceComponent; }
const { component } = Astro.props;
const name = component.name;
const buttonRows = [...new Map(component.usages.map(({props}) => { const row={size:props.size||'large',variant:props.variant||'primary',arrow:props.arrow||'none',appearance:props.appearance||'default'}; return [JSON.stringify(row),row]; })).values()].sort((a,b)=>Number(a.appearance==='comparison')-Number(b.appearance==='comparison') || Number(a.size==='small')-Number(b.size==='small') || Number(a.variant==='secondary')-Number(b.variant==='secondary'));
const linkRows = [...new Map(component.usages.map(({props})=>{const row={inline:props.inline==='true',compact:props.compact==='true',accent:props.accent==='true'};return [JSON.stringify(row),row];})).values()];
const chipVariants=[...new Set(component.usages.map(({props})=>props.variant||'tag'))];
---
{name==='Button'&&<div class="ds-specimen-composition">{buttonRows.map(row=><div class="ds-labelled-specimen"><span>{row.variant==='primary'?'Primary':'Secondary'} · {row.size==='small'?'Small':'Large'}{row.arrow!=='none'?' · With icon':''}{row.appearance==='comparison'?' · Comparison':''}</span><Button variant={row.variant==='secondary'?'secondary':'primary'} size={row.size==='small'?'small':'large'} appearance={row.appearance==='comparison'?'comparison':'default'} arrow={row.arrow==='up'?'up':undefined} href={row.appearance==='comparison'?undefined:'/'} aria-pressed={row.appearance==='comparison'?(row.variant==='primary'?'true':'false'):undefined} data-ds-comparison-choice={row.appearance==='comparison'?row.variant:undefined}>{row.appearance==='comparison'?(row.variant==='primary'?'Before':'After'):row.arrow==='up'?'Get in touch':row.size==='small'?'Small':'Design system'}</Button></div>)}</div>}
{name==='Chip'&&<div class="ds-specimen-composition">{chipVariants.map(variant=><div class="ds-labelled-specimen"><span>{variant==='tag'?'Skill':variant[0].toUpperCase()+variant.slice(1)}</span><Chip label={projects[0].tags[0]} variant={variant as 'tag'|'plain'|'raised'|'accent'} /></div>)}</div>}
{name==='IconButton'&&<div class="ds-specimen-composition"><IconButton icon="menu" label="Open navigation" /><IconButton icon="close" label="Close" /></div>}
{name==='TextLink'&&<div class="ds-specimen-composition">{linkRows.map(row=><div class="ds-labelled-specimen"><span>{row.inline?'Inline':row.compact?'Compact':'Default'} · {row.accent?'Accent':'Primary'}</span><TextLink href="/" {...row}>{row.accent?'Website':'LinkedIn'}</TextLink></div>)}</div>}
{name==='NavigationItem'&&<div class="ds-specimen-composition"><div class="ds-labelled-specimen"><span>Top bar</span><NavigationItem label="Work" href="/#work" /></div><div class="ds-labelled-specimen floating-navigation-theme floating-navigation-surface"><span>Floating</span><NavigationItem label="Work" href="/#work" /></div><div class="ds-labelled-specimen"><span>Mobile</span><NavigationItem label="Work" href="/#work" layout="mobile" /></div><div class="ds-labelled-specimen"><span>Filter</span><NavigationItem label="Selected work" filter="selected" pressed /></div></div>}
{name==='ThemeToggle'&&<div class="ds-theme-specimen"><p>The live theme switch is in this view’s header.</p><Chip label="Light" variant="plain" /><p>Choose Light or Dark above to try the saved preference.</p></div>}
{name === 'Icon' && <div class="ds-labelled-examples"><Icon name="arrow" /><Icon name="close" /><Icon name="menu" /><Icon name="plus" /></div>}
{name === 'Stat' && <dl class="ds-demo-content"><Stat {...impactGroups[0].metrics[0]} /></dl>}
{name === 'TimelineRow' && <div class="ds-context-inverse ds-demo-content"><ol class="experience-list"><TimelineRow item={experience[0]} /></ol></div>}
{name === 'ProjectIdentity' && <div class="ds-labelled-examples"><div><h4>Project name</h4><ProjectIdentity title={projects[0].title} /></div></div>}
{name === 'ProjectTags' && <div class="ds-labelled-examples"><ProjectTags tags={projects[0].tags} /></div>}
{name === 'ToolCard' && <div class="ds-demo-stack"><div><h4>Logo</h4><div class="ds-demo-tool"><ToolCard tool={tools[0]} /></div></div><div><h4>With details</h4><ToolCard tool={tools[0]} variant="detail" description={tools[0].name} /></div></div>}
{name === 'SectionNavigation' && <div class="ds-demo-stack"><div><h4>Full</h4><SectionNavigation /></div><div><h4>Compact</h4><SectionNavigation compact /></div></div>}
{name === 'SectionHeading' && <div class="ds-demo-stack"><div><h4>Columns</h4><SectionHeading id="ds-section-heading-columns" label="Work" >Projects worth a closer look.</SectionHeading></div><div><h4>Stacked</h4><SectionHeading id="ds-section-heading-stacked" label="Work"  layout="stacked">Projects worth a closer look.</SectionHeading></div><div><h4>Case study</h4><SectionHeading id="ds-section-heading-case" label="Overview" appearance="case">Projects worth a closer look.</SectionHeading></div></div>}
{name === 'ProjectCard' && <div class="ds-demo-stack"><div><h4>Featured</h4><ProjectCard project={projects[0]} lead /></div><div class="ds-demo-pair"><div><h4>Standard</h4><ProjectCard project={projects.find(project => project.id === 'datagpt')!} /></div><div class="ds-demo-compact"><h4>Compact</h4><ProjectCard project={{...collectionProjects.find(project => project.id === 'peak-hotel')!, logo: undefined}} compact /></div></div></div>}
{name === 'CaseStudyMedia' && <div class="ds-demo-stack"><div class="ds-demo-pair"><div><h4>Framed image</h4><CaseStudyMedia {...dataGPTMedia.after} kind="image" /></div><div><h4>Bare · Small radius</h4><CaseStudyMedia {...dataGPTMedia.after} kind="image" presentation="bare" radius="small" /></div><div><h4>Shadow · Media radius</h4><CaseStudyMedia {...dataGPTMedia.after} kind="image" presentation="shadow" radius="media" /></div><div><h4>Project hero</h4><CaseStudyMedia {...dataGPTMedia.after} kind="image" artwork /></div></div><div><h4>Video with controls</h4><CaseStudyMedia {...dataGPTMedia.pilot} controls /></div></div>}
{name === 'CaseStudyComparison' && <div class="ds-demo-content"><CaseStudyComparison before={dataGPTMedia.before} after={dataGPTMedia.after} label="Compare date and filter visibility" /></div>}
{name === 'CaseStudyDecisionCard' && <div class="ds-demo-stack"><div><h4>Text</h4><CaseStudyDecisionCard title="A canvas, not a form builder." label="Decision"><p>{projects[0].description}</p></CaseStudyDecisionCard></div><div class="ds-demo-pair"><div><h4>With media</h4><CaseStudyDecisionCard title="Niche benchmark" label="Context" labelVariant="accent" layout="media"><p>{projects[0].description}</p><CaseStudyMedia slot="media" {...dataGPTMedia.after} kind="image" presentation="bare" /></CaseStudyDecisionCard></div><div><h4>Figure</h4><CaseStudyDecisionCard title="With media" layout="figure" titleHidden><CaseStudyMedia slot="media" {...dataGPTMedia.after} kind="image" presentation="bare" /><p>{projects[0].description}</p></CaseStudyDecisionCard></div></div></div>}
{name === 'CaseStudySteps' && <div class="ds-demo-content"><CaseStudySteps items={peakHotelHomeSections.slice(0, 3)} /></div>}
