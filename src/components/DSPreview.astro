---
import '../styles/case-video-player.css';
import type {SourceComponent} from '../data/system-inventory';
import DSControl from './DSControl.astro';
import Stat from './Stat.astro';import TimelineRow from './TimelineRow.astro';
import SectionHeading from './SectionHeading.astro';

import ToolCard from './ToolCard.astro';
import {impactGroups,experience,tools} from '../data/portfolio';
import {workCategories} from '../data/work-categories';
interface Props {component:SourceComponent;miniature?:boolean;}
const {component,miniature=false}=Astro.props,name=component.name;
const prefix=miniature?'tile-':'example-';
---
{name==='Stat'&&<dl class="ds-stat-composition">{[impactGroups[0].metrics[0],...(!miniature?[impactGroups[0].metrics[1],impactGroups[1].metrics[1]]:[])].map((metric,index)=><div data-ds-example={`stat-${index}`} data-ds-target=".stat"><Stat {...metric} revealValue/></div>)}</dl>}
{name==='TimelineRow'&&<div class="about-details ds-context-about" data-color-zone="dark" data-zone-keep="section large-shadow"><ol class="experience-list" data-ds-example="timeline" data-ds-target=".experience-list">{experience.map(item=><TimelineRow item={item}/>)}</ol></div>}
{name==='SectionHeading'&&<div class="ds-heading-composition">
 <div class="work ds-context-work" data-ds-example="heading-columns" data-ds-target=".section-heading"><SectionHeading id={miniature?'work-title':'sample-work-title'} data-color-zone="dark" data-zone-keep="surface section shadows" label={workCategories.selected.label}>{workCategories.selected.title}<p slot="description" class="section-description text-body-l">{workCategories.selected.description}</p></SectionHeading></div>
 {!miniature&&<><div class="case-study-narrative" data-ds-example="heading-stacked" data-ds-target=".section-heading"><SectionHeading id={`${prefix}heading-stacked`} label="Product" layout="stacked" reveal={false}>How it works</SectionHeading></div><div class="case-study-narrative" data-ds-example="heading-case" data-ds-target=".ds-case-heading"><div class="ds-case-heading"><SectionHeading id={`${prefix}heading-case`} label="Pages" appearance="case">Main page</SectionHeading></div></div></>}
</div>}

{name==='Tooltip'&&<div class="ds-specimen-composition ds-tooltip-composition">
 {!miniature&&<div class="ds-inline-controls">{['Hidden','Visible above','Flipped below','Keyboard focus'].map((state,index)=><DSControl data-ds-tooltip-state={['hidden','above','below','focus'][index]} aria-pressed={index===0?'true':'false'}>{state}</DSControl>)}</div>}
 <div class="ds-labelled-specimen"><span>{tools[0].name}</span><div class="about-details ds-context-about ds-tooltip-tool" data-color-zone="dark" data-zone-keep="section large-shadow" data-ds-example="tooltip-tool" data-ds-target=".tool-card"><ToolCard tool={tools[0]} tooltipId={`${prefix}tool-tooltip`} /></div></div>
</div>}
