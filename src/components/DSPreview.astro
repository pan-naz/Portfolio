---
import type { SourceComponent } from '../data/system-inventory';
import DSStates from './DSStates.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import Stat from './Stat.astro';
import TimelineRow from './TimelineRow.astro';
import ProjectIdentity from './ProjectIdentity.astro';
import ProjectTags from './ProjectTags.astro';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';
import SectionNavigation from './SectionNavigation.astro';
import ToolCard from './ToolCard.astro';
import CaseStudyMedia from './CaseStudyMedia.astro';
import CaseStudyComparison from './CaseStudyComparison.astro';
import CaseStudyDecisionCard from './CaseStudyDecisionCard.astro';
import CaseStudySteps from './CaseStudySteps.astro';
import { projects, collectionProjects, impactGroups, experience, tools } from '../data/portfolio';
import { dataGPTMedia } from '../data/datagpt-case-study';
import { peakHotelHomeSections } from '../data/peak-hotel-case-study';
interface Props { component: SourceComponent; }
const { component } = Astro.props;
const name = component.name;
---
{['Button','Chip','NavigationItem','IconButton','TextLink','Logo'].includes(name) && <DSStates component={component} />}
{name === 'ThemeToggle' && <div class="ds-labelled-examples"><div><h4>Light / Dark</h4><ThemeToggle /></div><p>Try the switch. Every example follows the same theme.</p></div>}
{name === 'Icon' && <div class="ds-labelled-examples" inert><Icon name="arrow" /><Icon name="close" /><Icon name="menu" /><Icon name="plus" /></div>}
{name === 'Stat' && <dl class="ds-demo-content" inert><Stat {...impactGroups[0].metrics[0]} /></dl>}
{name === 'TimelineRow' && <div class="ds-context-inverse ds-demo-content" inert><ol class="experience-list"><TimelineRow item={experience[0]} /></ol></div>}
{name === 'ProjectIdentity' && <div class="ds-labelled-examples" inert><div><h4>Project name</h4><ProjectIdentity title={projects[0].title} /></div></div>}
{name === 'ProjectTags' && <div class="ds-labelled-examples" inert><ProjectTags tags={projects[0].tags} /></div>}
{name === 'ToolCard' && <div class="ds-demo-stack"><div><h4>Logo</h4><div class="ds-demo-tool"><ToolCard tool={tools[0]} /></div></div><div><h4>With details</h4><ToolCard tool={tools[0]} variant="detail" description={tools[0].name} /></div></div>}
{name === 'SectionNavigation' && <div class="ds-demo-stack" inert><div><h4>Full</h4><SectionNavigation /></div><div><h4>Compact</h4><SectionNavigation compact /></div></div>}
{name === 'SectionHeading' && <div class="ds-demo-stack" inert><div><h4>Columns</h4><SectionHeading id="ds-section-heading-columns" label="Work" reveal={false}>Projects worth a closer look.</SectionHeading></div><div><h4>Stacked</h4><SectionHeading id="ds-section-heading-stacked" label="Work" reveal={false} layout="stacked">Projects worth a closer look.</SectionHeading></div><div><h4>Case study</h4><SectionHeading id="ds-section-heading-case" label="Overview" appearance="case">Projects worth a closer look.</SectionHeading></div></div>}
{name === 'ProjectCard' && <div class="ds-demo-stack" inert><div><h4>Featured</h4><ProjectCard project={projects[0]} lead /></div><div class="ds-demo-pair"><div><h4>Standard</h4><ProjectCard project={projects.find(project => project.id === 'datagpt')!} /></div><div class="ds-demo-compact"><h4>Compact</h4><ProjectCard project={{...collectionProjects.find(project => project.id === 'peak-hotel')!, logo: undefined}} compact /></div></div></div>}
{name === 'CaseStudyMedia' && <div class="ds-demo-pair"><div><h4>Image</h4><CaseStudyMedia {...dataGPTMedia.after} kind="image" /></div><div><h4>Video</h4><CaseStudyMedia {...dataGPTMedia.pilot} controls={false} /></div></div>}
{name === 'CaseStudyComparison' && <div class="ds-demo-content"><CaseStudyComparison before={dataGPTMedia.before} after={dataGPTMedia.after} label="Compare date and filter visibility" /></div>}
{name === 'CaseStudyDecisionCard' && <div class="ds-demo-stack" inert><div><h4>Text</h4><CaseStudyDecisionCard title="A canvas, not a form builder."><p>{projects[0].description}</p></CaseStudyDecisionCard></div><div class="ds-demo-pair"><div><h4>With media</h4><CaseStudyDecisionCard title="Niche benchmark" label="Context" labelVariant="accent" layout="media"><p>{projects[0].description}</p><CaseStudyMedia slot="media" {...dataGPTMedia.after} kind="image" presentation="bare" /></CaseStudyDecisionCard></div><div><h4>Figure</h4><CaseStudyDecisionCard title="With media" layout="figure"><CaseStudyMedia slot="media" {...dataGPTMedia.after} kind="image" presentation="bare" /><p>{projects[0].description}</p></CaseStudyDecisionCard></div></div></div>}
{name === 'CaseStudySteps' && <div class="ds-demo-content" inert><CaseStudySteps items={peakHotelHomeSections.slice(0, 3)} /></div>}
