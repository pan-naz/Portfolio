---
interface Props {
  label: string;
  href?: string;
  filter?: string;
  controls?: string;
  pressed?: boolean;
}

const {
  label,
  href,
  filter,
  controls,
  pressed = false,
} = Astro.props;

const classes = ['navigation-item', 'text-body-m-strong'];
---
{href ? (
  <a class:list={classes} href={href} tabindex="0">
    <span class="navigation-item-indicator" aria-hidden="true"></span>
    <span class="navigation-item-label">{label}</span>
  </a>
) : (
  <button class:list={classes} type="button" tabindex="0" data-work-filter={filter} aria-controls={controls} aria-pressed={pressed ? 'true' : 'false'}>
    <span class="navigation-item-indicator" aria-hidden="true"></span>
    <span class="navigation-item-label">{label}</span>
  </button>
)}
