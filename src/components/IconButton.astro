---
import type { HTMLAttributes } from 'astro/types';
import type { IconName } from '../data/icons';
import Icon from './Icon.astro';
interface Props extends HTMLAttributes<'button'> { label: string; href?: string; icon?: IconName; variant?: 'default' | 'secondary' | 'raised'; size?: 'large' | 'small'; }
const { label, href, icon, variant = 'default', size = 'large', class: className, ...attributes } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag type={href ? undefined : "button"} href={href} data-icon={variant === 'raised' ? icon : undefined} {...attributes} tabindex={attributes.tabindex ?? 0} class:list={['icon-button', variant === 'raised' && 'icon-button--raised', variant === 'secondary' && 'icon-button--secondary', size === 'small' && 'icon-button--small hit-area', className]} aria-label={label}>
  {icon && <Icon name={icon} />}<slot />
</Tag>
