---
import type { HTMLAttributes } from 'astro/types';
import type { IconName } from '../data/icons';
import Icon from './Icon.astro';
interface Props extends HTMLAttributes<'button'> { label: string; href?: string; icon?: IconName; }
const { label, href, icon, class: className, ...attributes } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag type={href ? undefined : "button"} href={href} {...attributes} class:list={['icon-button', className]} aria-label={label}>
  {icon ? <Icon name={icon} /> : <slot />}
</Tag>
