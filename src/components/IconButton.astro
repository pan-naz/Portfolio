---
import type { HTMLAttributes } from 'astro/types';
import type { IconName } from '../data/icons';
import Icon from './Icon.astro';
interface Props extends HTMLAttributes<'button'> { label: string; href?: string; icon?: IconName; variant?: 'default' | 'secondary'; size?: 'large' | 'small'; }
const { label, href, icon, variant = 'default', size = 'large', class: className, ...attributes } = Astro.props;
const fixedLight = typeof className === 'string' && className.includes('floating-control-theme') && !className.includes('floating-navigation-theme');
const Tag = href ? 'a' : 'button';
---
<Tag type={href ? undefined : "button"} href={href} data-color-zone={fixedLight ? "light" : undefined} data-shadow-theme={fixedLight ? "page" : undefined} {...attributes} tabindex={attributes.tabindex ?? 0} class:list={['icon-button', variant === 'secondary' && 'icon-button--secondary', size === 'small' && 'icon-button--small hit-area', className]} aria-label={label}>
  {icon && <Icon name={icon} />}<slot />
</Tag>
