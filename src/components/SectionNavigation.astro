---
import NavigationItem from './NavigationItem.astro';

const filters = [
  { value: 'selected', label: 'Selected work' },
  { value: 'websites', label: 'Websites' },
  { value: 'misc', label: 'Misc' },
] as const;
---
<nav class="section-navigation text-body-m-strong" aria-label="Filter projects">
  {filters.map(({ value, label }, index) => <NavigationItem label={label} filter={value} controls="project-list" pressed={index === 0} />)}
  <span class="sr-only" data-work-filter-status aria-live="polite"></span>
</nav>
