---
import SkillTag from './SkillTag.astro';
const skills = ['Accessibility', 'Design systems', 'Wireframing', 'Product thinking', 'UX research & synthesis', 'Interaction & motion', 'AI prototyping', 'User testing'];
---
<div class="skill-marquee" aria-label="Design skills">
  <div class="skill-track">
    {[0,1].map(copy => <div class="skill-group" aria-hidden={copy === 1 ? 'true' : undefined}>{skills.map((label,index) => <SkillTag label={label} index={copy * skills.length + index} />)}</div>)}
  </div>
</div>
