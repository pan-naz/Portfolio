---
import type { Project } from '../data/portfolio';
import ProjectIdentity from './ProjectIdentity.astro';
import ProjectTags from './ProjectTags.astro';
import '../styles/case-study-narrative.css';

interface Props {
  project: Project;
  titleId: string;
  id?: string;
  secondaryLabel?: string;
}
const { project, titleId, id, secondaryLabel = 'Team' } = Astro.props;
---
<section class="case-study-overview" id={id} aria-labelledby={titleId}>
  <div class="case-study-overview__intro case-study-columns">
    <div class="case-study-overview__identity">
      <ProjectIdentity title={project.title} logo={project.logo} />
      <h1 id={titleId} class="sr-only" data-case-title>{project.title}</h1>
      <ProjectTags tags={project.tags} />
      {Astro.slots.has('links') && <div class="case-study-overview__links"><slot name="links" /></div>}
    </div>
    <div class="case-study-overview__summary">
      <p class="text-body-l">{project.outcome ?? project.description}</p>
      {project.outcome && <p class="text-body-m">{project.description}</p>}
    </div>
  </div>
  <div class="case-study-overview__details case-study-columns">
    <div class="case-study-overview__detail">
      <h2 class="case-study-eyebrow">My role</h2>
      <div class="case-study-prose"><slot name="role" /></div>
    </div>
    <div class="case-study-overview__detail">
      <h2 class="case-study-eyebrow">{secondaryLabel}</h2>
      <div class="case-study-prose"><slot name="secondary" /></div>
    </div>
  </div>
</section>
