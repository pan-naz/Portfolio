---
interface Props { rear?: boolean; screenRatio?: string; }
const { rear = false, screenRatio } = Astro.props;
---
<div class:list={['hooko-phone', { 'hooko-phone--rear': rear, 'hooko-phone--fitted': !!screenRatio }]} style={screenRatio ? `--phone-screen-ratio:${screenRatio}` : undefined}>
  <span class="hooko-phone__key hooko-phone__key--mute" aria-hidden="true"></span>
  <span class="hooko-phone__key hooko-phone__key--up" aria-hidden="true"></span>
  <span class="hooko-phone__key hooko-phone__key--down" aria-hidden="true"></span>
  <span class="hooko-phone__key hooko-phone__key--power" aria-hidden="true"></span>
  <span class="hooko-phone__key hooko-phone__key--camera" aria-hidden="true"></span>
  <div class="hooko-phone__rim"><div class="hooko-phone__bezel"><div class="hooko-phone__screen">
    <span class="hooko-phone__island" aria-hidden="true"><span></span></span>
    <slot />
    <span class="hooko-phone__home" aria-hidden="true"></span>
  </div></div></div>
</div>
<style is:global>
  /* Original hooko.app phone construction, proportionally scaled within the portfolio hero. */
  .hooko-phone { position: relative; width: calc(280 * var(--phone-unit)); aspect-ratio: 9 / 19.5; }
  .hooko-phone__rim, .hooko-phone__bezel, .hooko-phone__screen { width: 100%; height: 100%; }
  .hooko-phone__rim { padding: calc(3 * var(--phone-unit)); border-radius: calc(44 * var(--phone-unit)); background: linear-gradient(135deg, #5a4f6a, #2a2238 50%, #1a1228); box-shadow: 0 calc(25 * var(--phone-unit)) calc(50 * var(--phone-unit)) calc(-12 * var(--phone-unit)) rgb(0 0 0 / .6); }
  .hooko-phone__bezel { padding: calc(2 * var(--phone-unit)); border-radius: calc(42 * var(--phone-unit)); background: linear-gradient(135deg, #1a1228, #110a1d); }
  .hooko-phone__screen { position: relative; overflow: hidden; border-radius: calc(40 * var(--phone-unit)); background: #110a1d; }
  .hooko-phone--fitted { aspect-ratio: auto; }
  .hooko-phone--fitted :is(.hooko-phone__rim, .hooko-phone__bezel, .hooko-phone__screen) { height: auto; }
  .hooko-phone--fitted .hooko-phone__screen { aspect-ratio: var(--phone-screen-ratio); }
  .hooko-phone__key { position: absolute; width: calc(2 * var(--phone-unit)); border-radius: calc(2 * var(--phone-unit)); }
  .hooko-phone__key--mute, .hooko-phone__key--up, .hooko-phone__key--down { left: calc(-2 * var(--phone-unit)); background: linear-gradient(90deg, #3a3142, #1f1828); }
  .hooko-phone__key--mute { top: 18%; height: calc(28 * var(--phone-unit)); }
  .hooko-phone__key--up { top: 26%; height: calc(40 * var(--phone-unit)); }
  .hooko-phone__key--down { top: 34%; height: calc(40 * var(--phone-unit)); }
  .hooko-phone__key--power, .hooko-phone__key--camera { right: calc(-2 * var(--phone-unit)); background: linear-gradient(270deg, #3a3142, #1f1828); }
  .hooko-phone__key--power { top: 24%; height: calc(56 * var(--phone-unit)); }
  .hooko-phone__key--camera { top: 40%; height: calc(32 * var(--phone-unit)); }
  .hooko-phone__island { position: absolute; z-index: 3; top: calc(8 * var(--phone-unit)); left: 50%; transform: translateX(-50%); width: 35%; height: calc(18 * var(--phone-unit)); border-radius: var(--radius-pill); background: #000; display: flex; align-items: center; justify-content: flex-end; padding-right: calc(8 * var(--phone-unit)); }
  .hooko-phone__island span { width: calc(6 * var(--phone-unit)); height: calc(6 * var(--phone-unit)); border-radius: 50%; background: #1a1f3a; box-shadow: 0 0 0 calc(.5 * var(--phone-unit)) #3a4060; }
  .hooko-phone__home { position: absolute; z-index: 3; bottom: calc(6 * var(--phone-unit)); left: 50%; transform: translateX(-50%); width: calc(96 * var(--phone-unit)); height: calc(4 * var(--phone-unit)); border-radius: var(--radius-pill); background: rgb(254 254 254 / .6); }
  .hooko-phone--rear .hooko-phone__home { background: rgb(254 254 254 / .4); }
  :is(.project-media, .case-study-artwork, .case-study-transition-artwork) .hooko-phone :is(img, video) { position: absolute; inset: 0; display: block; width: 100%; height: 100%; aspect-ratio: auto; object-fit: cover; background: #110a1d; pointer-events: none; }
  :is(.project-media, .case-study-artwork, .case-study-transition-artwork) .hooko-phone--rear img { object-position: center top; }
</style>
