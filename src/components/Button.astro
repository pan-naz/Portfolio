---
import Arrow from './Arrow.astro';
import type { HTMLAttributes } from 'astro/types';
interface Props extends Omit<HTMLAttributes<'button'>, 'disabled'> { href?: string; download?: boolean; size?: 'large' | 'small'; variant?: 'primary' | 'secondary'; disabled?: boolean; arrow?: 'up' | 'down' | 'right'; }
const { href, size = 'large', variant = 'primary', disabled = false, arrow, class: className, ...attributes } = Astro.props;
const Tag = href && !disabled ? 'a' : 'button';
---
<Tag {...attributes} class:list={['button', size === 'small' ? 'text-body-s' : 'text-body-m-strong', `button--${variant}`, `button--${size}`, className]} href={!disabled ? href : undefined} type={Tag === 'button' ? (attributes.type ?? 'button') : undefined} disabled={Tag === 'button' && disabled}><slot />{arrow && <Arrow direction={arrow} />}</Tag>
