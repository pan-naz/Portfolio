---
import Arrow from './Arrow.astro';
import type { HTMLAttributes } from 'astro/types';
interface Props extends Omit<HTMLAttributes<'button'>, 'disabled'>, Pick<HTMLAttributes<'a'>, 'target' | 'rel'> { href?: string; download?: boolean; size?: 'large' | 'small'; variant?: 'primary' | 'secondary'; appearance?: 'default' | 'comparison' | 'catalog'; arrow?: 'up'; }
const { href, size = 'large', variant = 'primary', appearance = 'default', arrow, class: className, ...attributes } = Astro.props;
const Tag = href ? 'a' : 'button';
const hasArrowFill = variant === 'primary' && Boolean(arrow);
---
<Tag {...attributes} class:list={['button', size === 'small' && !hasArrowFill && 'hit-area', size === 'small' ? 'text-body-s' : 'text-body-m-strong', `button--${variant}`, appearance === 'comparison' && 'button--comparison', appearance === 'catalog' && 'button--catalog', `button--${size}`, arrow && `button--arrow-${arrow}`, hasArrowFill && 'button--arrow-fill', className]} href={href} type={Tag === 'button' ? (attributes.type ?? 'button') : undefined}>
  {hasArrowFill ? (
    <>
      <span class="button-fill-label"><slot /></span>
      <span class="button-arrow-orb" aria-hidden="true">
        <span class="button-arrow-icon button-arrow-icon--out"><Arrow direction={arrow} /></span>
        <span class="button-arrow-icon button-arrow-icon--in"><Arrow direction={arrow} /></span>
      </span>
    </>
  ) : <><slot />{arrow && <Arrow direction={arrow} />}</>}
</Tag>
