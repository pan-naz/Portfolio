---
interface Props { label: string; index?: number; variant?: 'default' | 'raised' | 'accent'; }
const { label, index = 0, variant = 'default' } = Astro.props;
---
<span class:list={['skill-tag', { 'skill-tag--raised': variant === 'raised', 'skill-tag--accent': variant === 'accent' }]} style={`--tag-index:${index}`}><span class={variant === 'accent' ? 'text-caps-centred' : undefined}>{label}</span></span>
