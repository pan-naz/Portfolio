---
import { buildSystemInventory } from '../data/system-inventory';
import { documentationFor } from '../data/system-documentation';
const inventory = buildSystemInventory();
---
<section id="source-inventory" class="ds-section" aria-labelledby="source-inventory-title">
  <header class="ds-heading"><h2 id="source-inventory-title">System inventory</h2><p>These entries come from the components and tokens used by the website.</p></header>
  <div class="ds-table-scroll"><table class="ds-motion-table"><caption>Used system tokens</caption><thead><tr><th>Token</th><th>Light</th><th>Dark</th><th>Tier</th></tr></thead><tbody>{inventory.tokens.map(token => <tr data-ds-token={token.name}><th><code>{`--${token.name}`}</code></th><td>{token.resolvedLight}</td><td>{token.resolvedDark}</td><td>{token.tier}</td></tr>)}</tbody></table></div>
  <div class="ds-table-scroll"><table class="ds-motion-table"><caption>Used website components</caption><thead><tr><th>Component</th><th>Purpose</th><th>Code</th></tr></thead><tbody>{inventory.components.map(component => <tr data-ds-component={component.name}><th>{component.name}</th><td>{documentationFor(component).purpose}</td><td><code>{component.file}</code></td></tr>)}</tbody></table></div>
</section>
<style>
@layer system, project;
@layer system {
  .ds-table-scroll { overflow-x: auto; max-width: 100%; }
  table { min-width: min(100%, 40rem); }
  td { overflow-wrap: anywhere; }
}
</style>
