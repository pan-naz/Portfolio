---
interface Props { label: string; index?: number; variant?: 'tag' | 'plain' | 'raised'; }
const { label, index = 0, variant = 'tag' } = Astro.props;
---
<span class:list={['skill-tag', { 'skill-tag--plain': variant === 'plain', 'skill-tag--raised': variant === 'raised' }]} style={`--tag-index:${index}`}><span>{label}</span></span>
