---
import ResponsiveImage from './ResponsiveImage.astro';
import DeferredVideo from './DeferredVideo.astro';
import { hookoHero } from '../data/hooko-case-study';
import HookoPhoneFrame from './HookoPhoneFrame.astro';
interface Props { preview?: boolean; }
const { preview = false } = Astro.props;
const { video, back } = hookoHero;
---
<div class="hooko-hero" aria-hidden={preview ? 'true' : undefined} style={`--hooko-hero-ratio:${hookoHero.width} / ${hookoHero.height}`}>
  <div class="hooko-hero__phones">
    <div class="hooko-hero__back"><HookoPhoneFrame rear screenRatio={`${video.width} / ${video.height}`}>
      <ResponsiveImage deferred={preview} sizes="16vw" src={back.src} alt="" width={back.width} height={back.height} loading={preview ? 'lazy' : 'eager'} decoding="async" />
    </HookoPhoneFrame></div>
    <div class="hooko-hero__front"><HookoPhoneFrame screenRatio={`${video.width} / ${video.height}`}>
      <DeferredVideo src={video.src} poster={video.poster} priority={!preview && Astro.url.pathname.startsWith('/case-studies/')} data-project-video={preview ? '' : undefined} data-case-video={!preview ? '' : undefined} width={video.width} height={video.height} aria-label={!preview ? 'Hooko app introduction and onboarding recording' : undefined} />
    </HookoPhoneFrame></div>
  </div>
</div>

