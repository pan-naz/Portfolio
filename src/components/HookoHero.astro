---
interface Props { preview?: boolean; }
const { preview = false } = Astro.props;
---
<div class="hooko-hero" aria-hidden={preview ? 'true' : undefined}>
  <div class="hooko-hero__phones">
    <div class="hooko-hero__back"><img src="/projects/hooko-case-study/hero-back.jpg" alt="" width="925" height="2104" loading="lazy" decoding="async" /></div>
    <div class="hooko-hero__front">
      <video data-project-video={preview ? '' : undefined} data-case-video={!preview ? '' : undefined} muted loop playsinline preload="none" poster="/projects/hooko-case-study/site-phone.jpg" width="498" height="1080" aria-label={!preview ? 'Screen recording of an analysis in Hooko' : undefined}>
        <source data-src="/projects/hooko-case-study/demo.mp4" type="video/mp4" />
        <img src="/projects/hooko-case-study/site-phone.jpg" alt="" width="498" height="1080" decoding="async" />
      </video>
    </div>
  </div>
</div>

<style is:global>
  .hooko-hero { position: relative; aspect-ratio: 1200 / 640; overflow: hidden; background: radial-gradient(60% 80% at 85% 10%, rgb(242 63 191 / .45), transparent 60%), radial-gradient(55% 70% at 10% 100%, rgb(242 106 46 / .4), transparent 60%), #110a1d; }
  .hooko-hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(rgb(255 255 255 / .07) 1px, transparent 1px); background-size: 20px 20px; }
  .hooko-hero__phones { position: absolute; left: 50%; top: 50%; height: 84%; aspect-ratio: 498 / 1080; transform: translate(-50%, -50%); }
  .hooko-hero__front, .hooko-hero__back { height: 100%; border: 6px solid #2a2140; border-radius: var(--radius-medium); overflow: hidden; background: #110a1d; box-shadow: 0 30px 60px -20px rgb(0 0 0 / .7); }
  .hooko-hero__front { position: relative; z-index: 2; }
  .hooko-hero__back { position: absolute; z-index: 1; left: 10%; top: 0; aspect-ratio: 925 / 2104; transform: rotate(9deg); opacity: .92; }
  :is(.project-media, .case-study-artwork, .case-study-transition-artwork) .hooko-hero :is(img, video) { width: 100%; height: 100%; aspect-ratio: auto; object-fit: contain; }
</style>
