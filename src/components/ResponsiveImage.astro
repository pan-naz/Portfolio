---
import type { HTMLAttributes } from 'astro/types';
import { responsiveImage } from '../data/responsive-images';
type Props = HTMLAttributes<'img'> & { src: string; alt: string; width: number | string; height: number | string; sizes?: string; deferred?: boolean; };
const { src, deferred = false, sizes: requestedSizes, style, srcset: originalSrcset, ...attributes } = Astro.props;
const image = responsiveImage(src);
const sizes = requestedSizes ?? (attributes.loading === 'lazy' ? 'auto, (max-width: 767px) calc(100vw - 48px), (max-width: 1328px) calc(100vw - 128px), 1200px' : '100vw');
const imageStyle = [style, image && `--responsive-original-ratio:${image.width} / ${image.height}`].filter(Boolean).join(';') || undefined;
const candidates = (format: 'webp' | 'avif') => image?.[format].map(item => `${item.src} ${item.width}w`).join(', ');
---
{image ? <picture style="display:contents">
  {image.avif.length > 0 && <source hidden type="image/avif" srcset={!deferred ? candidates('avif') : undefined} data-srcset={deferred ? candidates('avif') : undefined} sizes={sizes} />}
  {image.webp.length > 0 && <source hidden type="image/webp" srcset={!deferred ? candidates('webp') : undefined} data-srcset={deferred ? candidates('webp') : undefined} sizes={sizes} />}
  <img {...attributes} src={!deferred ? src : undefined} data-src={deferred ? src : undefined} data-deferred-image={deferred ? '' : undefined} data-responsive-image style={imageStyle} />
</picture> : <img {...attributes} src={!deferred ? src : undefined} data-src={deferred ? src : undefined} data-deferred-image={deferred ? '' : undefined} srcset={!deferred ? originalSrcset : undefined} data-srcset={deferred ? originalSrcset : undefined} sizes={requestedSizes} style={style} />}
{deferred && <noscript><Astro.self {...Astro.props} deferred={false} /></noscript>}
