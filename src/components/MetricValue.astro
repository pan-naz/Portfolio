---
interface Props {
  value: string;
  as?: 'span' | 'p' | 'strong';
  class?: string;
  reveal?: boolean;
}
const { value, as: Tag = 'span', class: className, reveal = false }: Props = Astro.props;
---
<Tag class:list={['font-heading', 'text-heading-l', className]}>{reveal ? <><span class="sr-only">{value}</span><span aria-hidden="true" data-title-reveal-value>{value}</span></> : value}</Tag>
