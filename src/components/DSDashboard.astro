---
import {foundations} from '../data/design-system';import {visibleComponents} from '../data/ds-components';
import DSPreview from './DSPreview.astro';import Icon from './Icon.astro';import ProjectIdentity from './ProjectIdentity.astro';import ProjectTags from './ProjectTags.astro';import ResponsiveImage from './ResponsiveImage.astro';import {projects} from '../data/portfolio';
interface Props {inventory:ReturnType<typeof import('../data/system-inventory').buildSystemInventory>;}
const {inventory}=Astro.props;
const summaries:Record<string,string>={color:'Colour roles and themes.',typography:'The shared text styles.','spacing-layout':'Gaps, corners and grids.',motion:'Durations and easing.',icons:'Named interface geometry.',button:'Actions and destinations.',chip:'Skills and disciplines.','icon-button':'Named icon actions.',navigation:'Sections and project filters.','project-card':'Identity, outcome and artwork.','section-heading':'Introductions to sections.',statistic:'Results with their context.','text-link':'Lightweight destinations.','timeline-row':'Roles and experience.',tooltip:'Short names beside visual items.'};
---
<section id="dashboard" class="ds-view ds-dashboard" data-ds-view data-title="Design system" data-group="" data-description="The foundations and components behind this portfolio, taken from the live code.">
 {['Foundations','Components'].map(group=><div class="ds-dashboard-group"><h2 class="ds-dashboard-title">{group}</h2><div class="ds-tile-grid">
 {(group==='Foundations'?foundations.map(item=>({id:item.id,title:item.title,name:''})):visibleComponents.map(item=>({id:item.section,title:item.title!,name:item.name}))).map(item=><article class="ds-tile"><div class="ds-tile-visual" inert>
  {item.name?item.name==='ProjectCard'?<div class="ds-project-tile ds-specimens ds-project-context"><div><div data-ds-example="tile-project-identity" data-ds-target=".project-identity"><ProjectIdentity title={projects[0].title} logo={projects[0].logo}/></div><div data-ds-example="tile-project-tags" data-ds-target=".project-tags"><ProjectTags tags={projects[0].tags}/></div></div><ResponsiveImage src={projects[0].video?.poster||projects[0].image} alt="" width={projects[0].video?.width??projects[0].imageWidth??1200} height={projects[0].video?.height||projects[0].imageHeight}/></div>:<div class={`ds-tile-mini ds-tile-mini--${item.id}`}><div class="ds-specimens"><DSPreview component={inventory.components.find(component=>component.name===item.name)!} miniature/></div></div>:item.id==='color'?<div class="ds-color-tile">{['color-text-primary','color-bg-surface-subtle','color-interactive-accent'].map(name=><span style={`background:var(--${name})`}/>)}</div>:item.id==='typography'?<p class="text-heading-l ds-type-tile">Product Designer</p>:item.id==='spacing-layout'?<div class="ds-spacing-tile">{[2,3,4,6,8].map(size=><span style={`width:var(--space-${size})`}/>)}</div>:item.id==='motion'?<div class="ds-motion-tile"><span/></div>:<div class="ds-icon-tile"><Icon name="moon"/><Icon name="plus"/><Icon name="sun"/></div>}
 </div><a class="ds-tile-link" href={`#${item.id}`} data-ds-nav><strong>{item.title}</strong><span>{summaries[item.id]}</span></a></article>)}
 </div></div>)}
</section>
