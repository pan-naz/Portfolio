---
import {foundations} from '../data/design-system';import {visibleComponents,overviewHiddenComponents} from '../data/ds-components';
import {coverIcons} from '../data/system-icons';
import {typographySystem} from '../data/system-typography';
import '../styles/design-system-button.css';
import DSButtonSpecimen from './DSButtonSpecimen.astro';import DSPreview from './DSPreview.astro';import Icon from './Icon.astro';import ProjectIdentity from './ProjectIdentity.astro';import ProjectTags from './ProjectTags.astro';import ResponsiveImage from './ResponsiveImage.astro';import {projects} from '../data/portfolio';
interface Props {inventory:ReturnType<typeof import('../data/system-inventory').buildSystemInventory>;}
const {inventory}=Astro.props;
const coverHeading=typographySystem().styles.find(style=>style.id==='heading-xl')!;
const coverDevices=['desktop','tablet','phone'] as const;
const summaries:Record<string,string>={color:'Color roles and themes.',typography:'The shared text styles.','spacing-layout':'Gaps, radius and grids.',motion:'Durations and easing.',icons:'Interface icons and the decorative library.',button:'Buttons, icon buttons and text links.',chip:'Skills and disciplines.','icon-button':'Named icon actions.',navigation:'Sections and project filters.','project-card':'Identity, outcome and artwork.','section-heading':'Introductions to sections.',statistic:'Results with their context.','text-link':'Text links to pages and profiles.','timeline-row':'Roles and experience.',tooltip:'Short names beside visual items.'};
import DSMotionCurve from './DSMotionCurve.astro';import {motionTokenSource} from '../data/system-motion';
---
<section id="dashboard" class="ds-view ds-dashboard" data-ds-view data-title="Design system" data-group="" data-description="The foundations and components behind this portfolio, taken from the live code.">
 {['Foundations','Components'].map(group=><div class="ds-dashboard-group"><h2 class="ds-dashboard-title">{group}</h2><div class="ds-tile-grid">
 {(group==='Foundations'?foundations.map(item=>({id:item.id,title:item.title,name:''})):visibleComponents.map(item=>({id:item.section,title:item.title!,name:item.name}))).map(item=><article class="ds-tile-frame"><div class="ds-tile"><div class="ds-tile-visual" inert aria-hidden="true">
  {item.name?item.name==='Button'?<div class="ds-button-cover"><div><DSButtonSpecimen id="raised" cover/><DSButtonSpecimen id="plain"/><DSButtonSpecimen id="layers"/></div><DSButtonSpecimen id="toggle" cover/></div>:item.name==='ProjectCard'?<div class="ds-project-tile ds-specimens ds-project-context"><div><div data-ds-example="tile-project-identity" data-ds-target=".project-identity"><ProjectIdentity title={projects[0].title} logo={projects[0].logo}/></div><div data-ds-example="tile-project-tags" data-ds-target=".project-tags"><ProjectTags tags={projects[0].tags}/></div></div><ResponsiveImage src={projects[0].video?.poster||projects[0].image} alt="" width={projects[0].video?.width??projects[0].imageWidth??1200} height={projects[0].video?.height||projects[0].imageHeight}/></div>:<div class={`ds-tile-mini ds-tile-mini--${item.id}`}><div class="ds-specimens"><DSPreview component={inventory.components.find(component=>component.name===item.name)!} miniature/></div></div>:item.id==='color'?<div class="ds-color-tile">{['color-mist','color-silver','color-graphite','color-ink','color-orange'].map(name=><span style={`background:var(--${name})`}/>)}</div>:item.id==='typography'?<div class="ds-type-tile">{coverDevices.map(device=><div><span class="text-heading-xl" style={`--text-heading-xl:calc(${coverHeading.devices[device].size} / 2);--letter-spacing-heading-xl:${coverHeading.devices[device].spacing}`}>Aa</span><Icon name={device==='desktop'?'monitor':device==='tablet'?'tablet':'phone'}/></div>)}</div>:item.id==='spacing-layout'?<div class="ds-spacing-tile"><span/><span/></div>:item.id==='motion'?<div class="ds-motion-tile"><DSMotionCurve cover value={motionTokenSource()['ease-entrance']}/></div>:<div class="ds-icon-tile" inert aria-hidden="true">{coverIcons.map(icon=><Icon nodes={icon.nodes} data-ds-cover-icon={icon.name} style={`--ds-scatter-x:${icon.x}%;--ds-scatter-y:${icon.y}%;--ds-scatter-size:${icon.size}px;--ds-scatter-opacity:${icon.opacity};--ds-scatter-rotation:${icon.rotation}deg`}/>)}</div>}
 </div><a tabindex="0" class="ds-tile-link" href={`#${item.id}`} data-ds-nav><strong>{item.title}</strong><span>{summaries[item.id]}</span></a></div></article>)}
 </div></div>)}
 <div class="ds-dashboard-group"><h2 class="ds-dashboard-title">What is not included</h2><div class="ds-exclusions-box">
  <div><p class="ds-column-title">No page of their own yet</p><ul class="ds-spec-list">{overviewHiddenComponents.map(item=><li data-ds-hidden-component={item.documentedHidden}><strong>{item.title}</strong><span>{item.description}</span></li>)}</ul></div>
  <div><p class="ds-column-title">Outside on purpose</p><ul class="ds-spec-list">
   <li><strong>Project colors, fonts and artwork</strong><span>Each case study keeps its own brand.</span></li>
   <li><strong>Page sections</strong><span>Hero, About, Contact and footer, built from the parts above.</span></li>
   <li><strong>Case-study layouts</strong><span>Each case study has its own structure.</span></li>
  </ul></div>
 </div></div>
</section>
