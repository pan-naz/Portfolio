---
import '../styles/global.css';
import SiteMetadata from '../components/SiteMetadata.astro';
import '../styles/static-preview.css';
import '../styles/hooko-artwork.css';
interface Props { title?: string; }
const { title = 'Folio design system — naz.wtf' } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="light" data-static>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SiteMetadata title={title} description="Shared semantic tokens across two modes." />
    <meta name="theme-color" content="#FAF8F7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=funnel-display" />
    <title>{title}</title>
  </head>
  <body><a class="skip-link" href="#main">Skip to content</a><slot /></body>
</html>
