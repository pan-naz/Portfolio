---
import '../styles/global.css';
import SiteMetadata from '../components/SiteMetadata.astro';
import '../styles/static-preview.css';
interface Props { title?: string; }
const { title = 'Folio design system' } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="light" data-static>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SiteMetadata title={title} description="The components and tokens used by this portfolio." />
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('naz-theme'); } catch {}
        document.documentElement.dataset.theme = theme === 'dark' ? 'dark' : 'light';
      })();
    </script>
    <meta name="theme-color" content="#FAF8F7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=funnel-display" />
    <title>{title}</title>
  </head>
  <body><a class="skip-link" href="#main">Skip to content</a><slot /><script>import '../scripts/theme';</script></body>
</html>
