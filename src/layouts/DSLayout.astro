---
import '../styles/global.css';
import SiteRuntime from '../components/SiteRuntime.astro';
import layoutCapabilitiesSource from '../scripts/layout-capabilities.js?raw';
import SiteMetadata from '../components/SiteMetadata.astro';
interface Props { title?: string; }
const { title = 'Design system' } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="light" data-catalog>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SiteMetadata title={title} description="The components and tokens used by this portfolio." />
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('naz-theme'); } catch {}
        document.documentElement.dataset.theme = theme === 'dark' ? 'dark' : 'light';
      })();
    </script>
    <script is:inline set:html={layoutCapabilitiesSource} />
    <meta name="theme-color" content="#FAF8F7" />
    <title>{title}</title>
  </head>
  <body><slot /><SiteRuntime /></body>
</html>
