---
import '../styles/global.css';
import { profile } from '../data/portfolio';
interface Props { title?: string; homeIntro?: boolean; }
const { title = `${profile.name} — naz.wtf`, homeIntro = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={profile.description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#FAF8F7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem('naz-theme'); } catch {}
        const dark = saved === 'dark';
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.querySelector('meta[name="theme-color"]').content = dark ? '#171716' : '#FAF8F7';
      })();
    </script>
    <script is:inline>
      (() => {
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduced) {
          document.documentElement.dataset.sectionRevealMotion = 'true';
          addEventListener('load', () => requestAnimationFrame(() => {
            if (!document.documentElement.classList.contains('section-reveals-ready')) {
              delete document.documentElement.dataset.sectionRevealMotion;
            }
          }), { once: true });
        }
        const desktopStage = matchMedia('(hover: hover)').matches
          && matchMedia('(pointer: fine)').matches
          && navigator.maxTouchPoints === 0;
        if (!desktopStage) return;
        document.documentElement.dataset.workStageLayout = 'true';
        const canShift = !reduced;
        if (!canShift) return;
        document.documentElement.dataset.workStageMotion = 'true';
        addEventListener('load', () => requestAnimationFrame(() => {
          if (!document.querySelector('[data-work-stage].work-stage-can-shift')) {
            delete document.documentElement.dataset.workStageMotion;
          }
        }), { once: true });
      })();
    </script>
    {homeIntro && <script is:inline>
      (() => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || typeof Element.prototype.animate !== 'function') return;
        const root = document.documentElement;
        // Set before body parsing: slow scripts must never expose the end state.
        root.dataset.homeIntro = 'pending';
        addEventListener('load', () => {
          // A blocked/failed module must not leave the server-rendered page hidden.
          if (!root.classList.contains('hero-intro-ready')) delete root.dataset.homeIntro;
        }, { once: true });
      })();
    </script>}
    <script is:inline data-scroll-restoration>
      (() => {
        const root = document.documentElement;
        const path = `${location.pathname}${location.search}`;
        let saved = history.state?.portfolioScroll;
        // Reload can snapshot history before pagehide. Session storage carries
        // the final visible position across that document boundary reliably.
        try { saved = JSON.parse(sessionStorage.getItem('portfolio-reload-scroll')) ?? saved; } catch {}
        const navigation = performance.getEntriesByType('navigation')[0];
        const restartHome = navigation?.type === 'reload' && location.pathname === '/';
        let restoring = navigation?.type === 'reload' && (restartHome || (saved?.path === path
          && Number.isFinite(saved.top) && saved.top >= 0));
        const save = () => {
          // A repeated reload during startup must keep the intended position.
          if (restoring) return;
          const scroller = document.querySelector('[data-case-dialog][open] [data-case-scroll]');
          const top = scroller ? scroller.scrollTop : window.scrollY;
          const position = { path: `${location.pathname}${location.search}`, top };
          try { sessionStorage.setItem('portfolio-reload-scroll', JSON.stringify(position)); } catch {}
          try {
            history.replaceState({ ...history.state, portfolioScroll: position }, '');
          } catch {}
        };
        addEventListener('pagehide', save);
        document.addEventListener('visibilitychange', () => { if (document.hidden) save(); });
        if (!restoring) return;

        // Homepage reloads replay the intro from the top. An open case reloads
        // as a standalone page using its own reading position.
        history.scrollRestoration = 'manual';
        // Home is reset before body parsing; its static Work preview must stay
        // visible. Only case reading positions need the layout/paint guard.
        if (!restartHome) root.dataset.scrollRestorePending = 'true';
        if (restartHome) {
          const hash = location.hash === '#websites' || location.hash === '#misc' ? location.hash : '';
          history.replaceState(history.state, '', `${path}${hash}`);
        }
        const top = restartHome ? 0 : saved.top;
        const restore = () => window.scrollTo({ top, left: 0, behavior: 'instant' });
        restore();
        addEventListener('DOMContentLoaded', restore, { once: true });
        addEventListener('load', () => {
          document.fonts.ready.then(() => {
            restore();
            requestAnimationFrame(() => {
              restore();
              restoring = false;
              delete root.dataset.scrollRestorePending;
              history.scrollRestoration = 'auto';
            });
          });
        }, { once: true });
      })();
    </script>
  </head>
  <body><slot /><script>import '../scripts/theme';</script></body>
</html>
