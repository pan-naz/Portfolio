---
import '@fontsource-variable/urbanist';
import '../styles/global.css';
import { profile } from '../data/portfolio';
interface Props { title?: string; resetToTopOnReload?: boolean; homeIntro?: boolean; }
const { title = `${profile.name} — naz.wtf`, resetToTopOnReload = false, homeIntro = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={profile.description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#FAF8F7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem('naz-theme'); } catch {}
        const dark = saved === 'dark';
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.querySelector('meta[name="theme-color"]').content = dark ? '#171716' : '#FAF8F7';
      })();
    </script>
    <script is:inline>
      (() => {
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduced) {
          document.documentElement.dataset.sectionRevealMotion = 'true';
          addEventListener('load', () => requestAnimationFrame(() => {
            if (!document.documentElement.classList.contains('section-reveals-ready')) {
              delete document.documentElement.dataset.sectionRevealMotion;
            }
          }), { once: true });
        }
        const desktopStage = matchMedia('(hover: hover)').matches
          && matchMedia('(pointer: fine)').matches
          && navigator.maxTouchPoints === 0;
        if (!desktopStage) return;
        document.documentElement.dataset.workStageLayout = 'true';
        const canShift = !reduced;
        if (!canShift) return;
        document.documentElement.dataset.workStageMotion = 'true';
        addEventListener('load', () => requestAnimationFrame(() => {
          if (!document.querySelector('[data-work-stage].work-stage-can-shift')) {
            delete document.documentElement.dataset.workStageMotion;
          }
        }), { once: true });
      })();
    </script>
    {homeIntro && <script is:inline>
      (() => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || typeof Element.prototype.animate !== 'function') return;
        const root = document.documentElement;
        // Set before body parsing: slow scripts must never expose the end state.
        root.dataset.homeIntro = 'pending';
        addEventListener('load', () => {
          // A blocked/failed module must not leave the server-rendered page hidden.
          if (!root.classList.contains('hero-intro-ready')) delete root.dataset.homeIntro;
        }, { once: true });
      })();
    </script>}
    {resetToTopOnReload && <script is:inline>
      (() => {
        const navigation = performance.getEntriesByType('navigation')[0];
        if (navigation?.type !== 'reload') return;
        history.scrollRestoration = 'manual';
        document.documentElement.dataset.reloadToTop = 'true';
        const reset = () => window.scrollTo(0, 0);
        history.replaceState(history.state, '', `${location.pathname}${location.search}#top`);
        reset();
        addEventListener('load', () => requestAnimationFrame(() => requestAnimationFrame(() => {
          reset();
          history.scrollRestoration = 'auto';
          delete document.documentElement.dataset.reloadToTop;
        })), { once: true });
      })();
    </script>}
  </head>
  <body><a class="skip-link" href="#main">Skip to content</a><slot /><script>import '../scripts/theme';</script></body>
</html>
