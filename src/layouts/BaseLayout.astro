---
import '../styles/global.css';
import layoutCapabilitiesSource from '../scripts/layout-capabilities.js?raw';
import urbanistFont from '@fontsource-variable/urbanist/files/urbanist-latin-wght-normal.woff2?url';
import funnelDisplayFont from '@fontsource-variable/funnel-display/files/funnel-display-latin-wght-normal.woff2?url';
import SiteMetadata from '../components/SiteMetadata.astro';
import { profile } from '../data/portfolio';
import { siteTitle } from '../data/site-config';
interface Props { title?: string; homeIntro?: boolean; description?: string; image?: string; }
const { title = siteTitle, homeIntro = false, description = profile.description, image } = Astro.props;
const searchDescription = Astro.url.pathname === '/'
  ? `${profile.name}, ${description[0].toLowerCase()}${description.slice(1)}`
  : description;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" href={urbanistFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={funnelDisplayFont} as="font" type="font/woff2" crossorigin />
    <SiteMetadata title={title} description={searchDescription} sharingDescription={description} image={image} />
    <meta name="theme-color" content="#FAF8F7" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem('naz-theme'); } catch {}
        const dark = saved === 'dark';
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.querySelector('meta[name="theme-color"]').content = dark ? '#161715' : '#FAF8F7';
      })();
    </script>
    <script is:inline>
      (() => {
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduced) {
          document.documentElement.dataset.sectionRevealMotion = 'true';
          addEventListener('load', () => requestAnimationFrame(() => {
            if (!document.documentElement.classList.contains('section-reveals-ready')) {
              delete document.documentElement.dataset.sectionRevealMotion;
            }
          }), { once: true });
        }
      })();
    </script>
    <script is:inline set:html={layoutCapabilitiesSource} />
    {homeIntro && <script is:inline>
      (() => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || typeof Element.prototype.animate !== 'function') return;
        const root = document.documentElement;
        // Set before body parsing: slow scripts must never expose the end state.
        root.dataset.homeIntro = 'pending';
        addEventListener('load', () => {
          // A blocked/failed module must not leave the server-rendered page hidden.
          if (!root.classList.contains('hero-intro-ready')) delete root.dataset.homeIntro;
        }, { once: true });
      })();
    </script>}
    <script is:inline data-scroll-restoration>
      (() => {
        const root = document.documentElement;
        const path = `${location.pathname}${location.search}`;
        let saved = history.state?.portfolioScroll;
        // Reload can snapshot history before pagehide. Session storage carries
        // the final visible position across that document boundary reliably.
        try { saved = JSON.parse(sessionStorage.getItem('portfolio-reload-scroll')) ?? saved; } catch {}
        const navigation = performance.getEntriesByType('navigation')[0];
        let caseReturn;
        if (location.pathname === '/') {
          try {
            const pending = JSON.parse(sessionStorage.getItem('portfolio-case-return'));
            sessionStorage.removeItem('portfolio-case-return');
            if ((navigation?.type !== 'reload' || pending?.reload === true) && pending?.url === `${path}${location.hash}`
              && Number.isFinite(pending.top) && pending.top >= 0) caseReturn = pending;
          } catch {}
        }
        const restartHome = navigation?.type === 'reload' && location.pathname === '/' && !caseReturn;
        let restoring = Boolean(caseReturn) || navigation?.type === 'reload' && (restartHome || (saved?.path === path
          && Number.isFinite(saved.top) && saved.top >= 0));
        const save = () => {
          // A repeated reload during startup must keep the intended position.
          if (restoring) return;
          const scroller = document.querySelector('[data-case-dialog][open] [data-case-scroll]');
          const top = scroller ? scroller.scrollTop : window.scrollY;
          const position = { path: `${location.pathname}${location.search}`, top };
          try { sessionStorage.setItem('portfolio-reload-scroll', JSON.stringify(position)); } catch {}
          try {
            history.replaceState({ ...history.state, portfolioScroll: position }, '');
          } catch {}
        };
        addEventListener('pagehide', save);
        document.addEventListener('visibilitychange', () => { if (document.hidden) save(); });
        if (!restoring) return;

        // Homepage refreshes replay the intro; a case return resumes its origin.
        // An open case reloads as a standalone page at its reading position.
        history.scrollRestoration = 'manual';
        // Home is reset before body parsing; its static Work preview must stay
        // visible. Case reloads and origin returns need the layout/paint guard.
        if (!restartHome) root.dataset.scrollRestorePending = 'true';
        if (caseReturn) {
          root.dataset.caseReturn = 'true';
          delete root.dataset.homeIntro;
        }
        if (restartHome) {
          const hash = location.hash === '#websites' || location.hash === '#misc' ? location.hash : '';
          history.replaceState(history.state, '', `${path}${hash}`);
        }
        const top = caseReturn ? caseReturn.top : restartHome ? 0 : saved.top;
        const restore = () => window.scrollTo({ top, left: 0, behavior: 'instant' });
        restore();
        addEventListener('DOMContentLoaded', restore, { once: true });
        addEventListener('load', () => {
          document.fonts.ready.then(() => {
            restore();
            requestAnimationFrame(() => {
              restore();
              restoring = false;
              delete root.dataset.scrollRestorePending;
              history.scrollRestoration = 'auto';
            });
          });
        }, { once: true });
      })();
    </script>
  </head>
  <body><slot /><script>import '../scripts/theme';</script></body>
</html>
