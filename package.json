{
  "name": "naz-wtf-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/generate-responsive-images.mjs && pnpm validate:ds && pnpm validate:contrast && pnpm validate:svg && astro build && node scripts/validate-static-catalog.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "preview:lan": "astro preview --host 0.0.0.0 --port 4322",
    "check": "pnpm validate:ds && pnpm validate:contrast && pnpm validate:svg && astro check",
    "typecheck": "astro check && tsc --noEmit",
    "validate:ds": "node scripts/validate-design-system.mjs",
    "validate:contrast": "node tests/text-contrast.test.mjs",
    "validate:svg": "node --experimental-strip-types scripts/validate-svg-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/funnel-display": "^5.3.0",
    "@fontsource-variable/urbanist": "^5.3.0",
    "@lucide/icons": "^1.45.0",
    "astro": "^7.3.2",
    "lenis": "^1.3.26",
    "matter-js": "0.20.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^24.19.1",
    "typescript": "^6.0.3"
  }
}
